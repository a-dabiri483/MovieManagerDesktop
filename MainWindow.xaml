<Window x:Class="MovieManagerDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
        xmlns:views="clr-namespace:MovieManagerDesktop.Views"
        xmlns:controls="clr-namespace:MovieManagerDesktop.Controls"
        Title="MovieManager" Height="820" Width="1280"
        MinHeight="450" MinWidth="700"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource MainBackground}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        FlowDirection="RightToLeft"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        StateChanged="Window_StateChanged">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ScanViewModel}">
            <views:ScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:FavoritesViewModel}">
            <views:MoviesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CollectionMoviesViewModel}">
            <views:MoviesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CollectionsViewModel}">
            <views:CollectionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PersonMoviesViewModel}">
            <views:MoviesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PeopleViewModel}">
            <views:PeopleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MoviesViewModel}">
            <views:MoviesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MediaDetailsViewModel}">
            <views:MediaDetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SeriesDetailViewModel}">
            <views:SeriesDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ToolsViewModel}">
            <views:ToolsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:FolderIconToolViewModel}">
            <views:FolderIconToolView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:NameCleanerToolViewModel}">
            <views:NameCleanerToolView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SeriesOrganizerToolViewModel}">
            <views:SeriesOrganizerToolView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SeriesFileRenamerViewModel}">
            <views:SeriesFileRenamerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AutoRelocatorViewModel}">
            <views:AutoRelocatorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CalendarViewModel}">
            <views:CalendarView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ManualSearchViewModel}">
            <views:ManualSearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TrackerViewModel}">
            <views:TrackerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TrackedDetailViewModel}">
            <views:TrackedDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AnalyticsViewModel}">
            <views:AnalyticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CinemaHubViewModel}">
            <views:CinemaHubView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LibraryCompareToolViewModel}">
            <views:LibraryCompareToolView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CatalogExportToolViewModel}">
            <views:CatalogExportToolView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MissingEpisodesToolViewModel}">
            <views:MissingEpisodesToolView />
        </DataTemplate>

        <!-- Android Bottom Nav Item Style -->
        <Style x:Key="AndroidBottomNavRadioStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="BottomNavGroup"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ItemContainer" Background="Transparent" CornerRadius="18" Padding="12,2" Margin="3,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Circle Active Icon Wrapper -->
                                <Border x:Name="IconPill" Width="38" Height="32" CornerRadius="16" Background="Transparent" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon x:Name="NavIcon" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                                             Width="21" Height="21" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="NavLabel" Text="{TemplateBinding Content}" FontSize="11" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" Margin="0,3,0,0" TextTrimming="None"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconPill" Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
                                <Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                                <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
                                <Setter TargetName="NavLabel" Property="FontWeight" Value="Black"/>
                                <Setter TargetName="IconPill" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#EB3B5A" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                                <Setter TargetName="NavLabel" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Buttons Style -->
        <Style x:Key="WindowBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource WindowBtnStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bell Wiggle Storyboard -->
        <Storyboard x:Key="BellWiggleStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BellRotateTransform" Storyboard.TargetProperty="Angle" Duration="0:0:1.0">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="-20"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="18"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="12"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="-8"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="-2"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BellScaleTransform" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.0">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1.2"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BellScaleTransform" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.0">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1.2"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog" DialogBackground="{DynamicResource MainBackground}">
        <Border x:Name="WindowRootBorder" CornerRadius="18" ClipToBounds="True" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Background="{DynamicResource MainBackground}">
            <Grid x:Name="RootLayoutGrid">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="MainUiScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                </Grid.LayoutTransform>
                <!-- TOP WINDOW DRAGGING BAR AND CONTROLS (Floating Minimal, LTR for standard Windows layout) -->
                <Grid Panel.ZIndex="100" VerticalAlignment="Top" Height="40" WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent"
                      FlowDirection="LeftToRight"
                      Visibility="{Binding IsPlayerActive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top-Left App Identity (Logo on the Left) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0"/>
                        <TextBlock Text="MovieManager" Foreground="{DynamicResource SecondaryText}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>

                        <!-- Dynamic License Status Badge (Clickable to open License Manager) -->
                        <Button Command="{Binding OpenLicenseWindowCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="24" Padding="0" Margin="14,0,0,0" VerticalAlignment="Center"
                                Cursor="Hand" ToolTip="مدیریت لایسنس و ارتقا">
                            <Border CornerRadius="12" Padding="8,2"
                                    Background="{Binding LicenseBadgeBackground}"
                                    BorderBrush="{Binding LicenseBadgeBorder}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="{Binding LicenseBadgeIcon}"
                                                             Width="13" Height="13" Margin="0,0,5,0"
                                                             Foreground="{Binding LicenseBadgeForeground}"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LicenseBadgeText}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding LicenseBadgeForeground}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </StackPanel>

                    <!-- Top-Right Window Control Buttons (Close, Maximize, Minimize on the Right) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <!-- Notification Bell Button & Popup -->
                        <Grid Margin="0,0,4,0">
                            <!-- Notification Bell with English Count & Pulse -->
                            <Button x:Name="BtnNotificationBell" Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="Auto" MinWidth="40" Height="40" Padding="6,0" Foreground="#E2E8F0"
                                    Command="{Binding ToggleNotificationPopupCommand}"
                                    ToolTip="اعلان‌ها و پیام‌ها" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- English Digit Unread Pill Badge -->
                                    <Border Visibility="{Binding NotificationCenter.HasUnread, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Background="#EF4444" CornerRadius="8" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#EF4444" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                        </Border.Effect>
                                        <TextBlock Text="{Binding NotificationCenter.UnreadCount}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>

                                    <Grid Width="28" Height="28">
                                        <!-- Sound Wave Pulsing Effect -->
                                        <Ellipse Width="28" Height="28" Fill="Transparent" Stroke="#EF4444" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Visibility="{Binding NotificationCenter.HasUnread, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NotificationCenter.HasUnread}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="PulseAnim">
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:1.5" />
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.5" To="1.5" Duration="0:0:1.5" />
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.5" To="1.5" Duration="0:0:1.5" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="PulseAnim" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" CenterX="14" CenterY="14"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>

                                        <materialDesign:PackIcon Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.1">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="BellOutline"/>
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NotificationCenter.HasUnread}" Value="True">
                                                            <Setter Property="Kind" Value="BellRingOutline"/>
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                            <materialDesign:PackIcon.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform x:Name="BellRotateTransform" Angle="0"/>
                                                    <ScaleTransform x:Name="BellScaleTransform" ScaleX="1" ScaleY="1"/>
                                                </TransformGroup>
                                            </materialDesign:PackIcon.RenderTransform>
                                        </materialDesign:PackIcon>
                                    </Grid>
                                </StackPanel>
                            </Button>

                            <!-- Notification Flyout Popup -->
                            <Popup x:Name="NotificationPopup" IsOpen="{Binding IsNotificationPopupOpen, Mode=TwoWay}"
                                    PlacementTarget="{Binding ElementName=BtnNotificationBell}" Placement="Bottom"
                                    StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide" VerticalOffset="6" HorizontalOffset="-340">
                                <Border Width="400" MaxHeight="520" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                        CornerRadius="16" FlowDirection="RightToLeft" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.6"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <Border Grid.Row="0" Background="#0F172A" CornerRadius="16,16,0,0" Padding="16,12" BorderBrush="#334155" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="BellRingOutline" Width="20" Height="20" Foreground="{DynamicResource PrimaryColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="اعلان‌ها و پیام‌ها" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                                    <Border Visibility="{Binding NotificationCenter.HasUnread, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Background="#EF4444" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NotificationCenter.UnreadCount}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#94A3B8" Padding="6,2" Height="26"
                                                            Command="{Binding MarkAllNotificationsReadCommand}" ToolTip="علامت‌گذاری همه به عنوان خوانده شده"
                                                            Visibility="{Binding NotificationCenter.HasUnread, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <materialDesign:PackIcon Kind="CheckAll" Width="16" Height="16"/>
                                                    </Button>
                                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#94A3B8" Padding="4,2" Height="26"
                                                            Command="{Binding CloseNotificationPopupCommand}" ToolTip="بستن">
                                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Search & Tabs Bar -->
                                        <StackPanel Grid.Row="1" Background="#0F172A" Margin="0,0,0,4">
                                            <!-- Search Box -->
                                            <Border Margin="12,8,12,6" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="8,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding NotificationSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" VerticalAlignment="Center"
                                                             materialDesign:HintAssist.Hint="جستجو در اعلان‌ها..." materialDesign:HintAssist.Foreground="#64748B"/>
                                                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#94A3B8" Padding="0" Width="18" Height="18"
                                                            Command="{Binding ClearNotificationSearchCommand}"
                                                            Visibility="{Binding NotificationSearchQuery.Length, Converter={StaticResource ZeroToVisibilityConverter}, ConverterParameter=Inverse}">
                                                        <materialDesign:PackIcon Kind="Close" Width="12" Height="12"/>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Filter Tabs -->
                                            <StackPanel Orientation="Horizontal" Margin="12,0,12,8">
                                                <!-- All -->
                                                <Button Height="26" Padding="10,2" Margin="0,0,4,0"
                                                        Command="{Binding SelectNotificationTabCommand}" CommandParameter="all">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                            <Setter Property="Background" Value="#1E293B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedNotificationTab}" Value="all">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="همه" FontSize="11" FontWeight="Bold"/>
                                                </Button>

                                                <!-- Update -->
                                                <Button Height="26" Padding="10,2" Margin="0,0,4,0"
                                                        Command="{Binding SelectNotificationTabCommand}" CommandParameter="update">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                            <Setter Property="Background" Value="#1E293B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedNotificationTab}" Value="update">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="Background" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="آپدیت‌ها" FontSize="11" FontWeight="Bold"/>
                                                </Button>

                                                <!-- News -->
                                                <Button Height="26" Padding="10,2" Margin="0,0,4,0"
                                                        Command="{Binding SelectNotificationTabCommand}" CommandParameter="news">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                            <Setter Property="Background" Value="#1E293B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedNotificationTab}" Value="news">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="Background" Value="#38BDF8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="اخبار و پیام‌ها" FontSize="11" FontWeight="Bold"/>
                                                </Button>

                                                <!-- Warning -->
                                                <Button Height="26" Padding="10,2" Margin="0,0,4,0"
                                                        Command="{Binding SelectNotificationTabCommand}" CommandParameter="warning">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                            <Setter Property="Background" Value="#1E293B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedNotificationTab}" Value="warning">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="هشدارها" FontSize="11" FontWeight="Bold"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Notification List or Empty State -->
                                        <ScrollViewer Grid.Row="2" MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <Grid>
                                                <!-- Empty State -->
                                                <StackPanel Margin="24,40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding NotificationCenter.Notifications.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                                                    <materialDesign:PackIcon Kind="BellSleepOutline" Width="48" Height="48" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                    <TextBlock Text="هیچ اعلانی وجود ندارد" FontSize="13" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="اطلاعیه‌ها و پیام‌های جدید در این بخش نمایش داده می‌شوند" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <!-- Items List -->
                                                <ItemsControl ItemsSource="{Binding FilteredNotifications}" Margin="8">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,3,0,5" CornerRadius="12" BorderThickness="1.5" Padding="12,10" Cursor="Hand">
                                                                <!-- Card Clickable to Mark as Read -->
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick"
                                                                                  Command="{Binding DataContext.MarkNotificationReadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                  CommandParameter="{Binding}"/>
                                                                </Border.InputBindings>

                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#0F172A"/>
                                                                        <Setter Property="BorderBrush" Value="#334155"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="#FFD700"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                                                <Setter Property="Background" Value="#172033"/>
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#253248"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                    </Grid.RowDefinitions>

                                                                    <!-- Pinned Banner Tag -->
                                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6"
                                                                                Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <materialDesign:PackIcon Kind="Pin" Width="14" Height="14" Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                        <TextBlock Text="سنجاق‌شده" FontSize="10.5" FontWeight="Bold" Foreground="#FFD700" VerticalAlignment="Center"/>
                                                                    </StackPanel>

                                                                    <Grid Grid.Row="1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Type Icon Circle -->
                                                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                                                                Background="{Binding TypeBackgroundBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                                            <materialDesign:PackIcon Kind="{Binding TypeIcon}" Width="20" Height="20"
                                                                                                     Foreground="{Binding TypeColorBrush}"
                                                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>

                                                                        <!-- Text & Image Content -->
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                                                <!-- Unread Glowing Dot -->
                                                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryColor}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                         Visibility="{Binding IsRead, Converter={StaticResource InverseBooleanConverter}}">
                                                                                    <Ellipse.Effect>
                                                                                        <DropShadowEffect Color="#EB3B5A" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                                                                    </Ellipse.Effect>
                                                                                </Ellipse>
                                                                            </StackPanel>

                                                                            <!-- Rich Media Image Preview -->
                                                                            <Border Margin="0,6,0,4" CornerRadius="8" MaxHeight="130" ClipToBounds="True" Background="#000000"
                                                                                    Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" MaxHeight="130"/>
                                                                            </Border>

                                                                            <TextBlock Text="{Binding Message}" FontSize="13" Foreground="#F1F5F9" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>

                                                                            <!-- Action Button if any -->
                                                                            <Button Margin="0,10,0,0" HorizontalAlignment="Left" Padding="12,4" Height="28"
                                                                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryColor}"
                                                                                    Foreground="White" FontSize="11.5" FontWeight="Bold"
                                                                                    Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                    Command="{Binding DataContext.OpenNotificationActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <materialDesign:PackIcon Kind="OpenInNew" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding ActionTitle, TargetNullValue='مشاهده'}" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Button>

                                                                            <TextBlock Text="{Binding TimeAgo}" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0"/>
                                                                        </StackPanel>

                                                                        <!-- Action / Dismiss Buttons -->
                                                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal" Margin="4,0,0,0">
                                                                            <!-- Mark Read Checkmark Button -->
                                                                            <Button Width="22" Height="22" Padding="0" Margin="0,0,4,0"
                                                                                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="#38BDF8"
                                                                                    Command="{Binding DataContext.MarkNotificationReadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}" ToolTip="علامت‌گذاری به عنوان خوانده شده"
                                                                                    Visibility="{Binding IsRead, Converter={StaticResource InverseBooleanConverter}}">
                                                                                <materialDesign:PackIcon Kind="Check" Width="15" Height="15"/>
                                                                            </Button>

                                                                            <!-- Dismiss Button -->
                                                                            <Button Width="22" Height="22" Padding="0"
                                                                                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="#64748B"
                                                                                    Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}" ToolTip="حذف اعلان">
                                                                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </ScrollViewer>

                                        <!-- Footer -->
                                        <Border Grid.Row="3" Background="#0F172A" CornerRadius="0,0,16,16" Padding="12,8" BorderBrush="#334155" BorderThickness="0,1,0,0"
                                                Visibility="{Binding NotificationCenter.Notifications.Count, Converter={StaticResource ZeroToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <Grid>
                                                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#94A3B8" FontSize="11" Padding="8,2" Height="24"
                                                        HorizontalAlignment="Right" Command="{Binding ClearAllNotificationsCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="پاک‌کردن همه اعلان‌ها" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <Button ToolTip="نمایش لاگ‌ها" Style="{StaticResource WindowBtnStyle}" Click="BtnViewLogs_Click">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button ToolTip="کوچک‌کردن" Style="{StaticResource WindowBtnStyle}" Click="BtnMinimize_Click">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnMaximize" ToolTip="تمام‌صفحه" Style="{StaticResource WindowBtnStyle}" Click="BtnMaximize_Click">
                            <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button ToolTip="بستن" Style="{StaticResource WindowCloseBtnStyle}" Click="BtnClose_Click">
                            <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- MAIN FULL VIEW CONTENT AREA -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="0,35,0,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlayerActive}" Value="True">
                                    <Setter Property="Margin" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl Content="{Binding CurrentViewModel, NotifyOnTargetUpdated=True}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Margin" Value="0,0,0,85"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlayerActive}" Value="True">
                                        <Setter Property="Margin" Value="0"/>
                                    </DataTrigger>
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>

                <!-- ANDROID FLOATING BOTTOM NAVIGATION BAR (دقیقاً مثل اسکرین‌شات اندروید) -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Panel.ZIndex="90"
                        TextOptions.TextFormattingMode="Ideal"
                        TextOptions.TextRenderingMode="Auto"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True"
                        Visibility="{Binding IsPlayerActive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                    <Border Background="#F2101222" CornerRadius="37" BorderBrush="#40EB3B5A" BorderThickness="1.5" Padding="14,4" Height="74">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="3" Opacity="0.6"/>
                        </Border.Effect>
                        <Grid VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 1. خانه (Home) - قرارگیری در سمت راست در RTL -->
                                <RadioButton Style="{StaticResource AndroidBottomNavRadioStyle}" Tag="HomeVariantOutline" Content="خانه" Command="{Binding NavigateToHomeCommand}" IsChecked="True"/>

                                <!-- 2. کتابخانه (Library) -->
                                <RadioButton Style="{StaticResource AndroidBottomNavRadioStyle}" Tag="MovieOpenPlayOutline" Content="کتابخانه" Command="{Binding NavigateToMoviesCommand}"/>

                                <!-- 3. مجموعه‌ها (Collections) -->
                                <RadioButton Style="{StaticResource AndroidBottomNavRadioStyle}" Tag="AnimationPlayOutline" Content="مجموعه‌ها" Command="{Binding NavigateToCollectionsCommand}"/>

                                <!-- 4. CENTER FLOATING FAB BUTTON (پویش و جستجو 🔍) -->
                                <Button Command="{Binding NavigateToScanCommand}" Width="52" Height="52" Margin="8,-16,8,0" materialDesign:ButtonAssist.CornerRadius="26" BorderThickness="0" Background="{DynamicResource FabGradientBrush}" Cursor="Hand">
                                    <Button.Effect>
                                        <DropShadowEffect Color="#8854D0" BlurRadius="16" ShadowDepth="2" Opacity="0.7"/>
                                    </Button.Effect>
                                    <materialDesign:PackIcon Kind="Magnify" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <!-- 5. تقویم (Calendar) -->
                                <RadioButton Style="{StaticResource AndroidBottomNavRadioStyle}" Tag="CalendarMonthOutline" Content="تقویم" Command="{Binding NavigateToCalendarCommand}"/>

                                <!-- 6. ابزارها (Tools) -->
                                <RadioButton Style="{StaticResource AndroidBottomNavRadioStyle}" Tag="WrenchOutline" Content="ابزارها" Command="{Binding NavigateToToolsCommand}"/>

                                <!-- 7. تنظیمات (Settings) - قرارگیری در سمت چپ در RTL -->
                                <RadioButton Style="{StaticResource AndroidBottomNavRadioStyle}" Tag="CogOutline" Content="تنظیمات" Command="{Binding NavigateToSettingsCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- Global Toasts overlay -->
                <controls:ToastControl VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="9999" Margin="0,40,0,0" />

            </Grid>
        </Border>
    </materialDesign:DialogHost>
</Window>

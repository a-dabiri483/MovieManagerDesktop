<UserControl x:Class="MovieManagerDesktop.Views.LibraryCompareToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
             xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:LibraryCompareToolViewModel}"
             d:DesignHeight="900" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:PersianNumberConverter x:Key="PersianNum"/>
        <converters:RadioIntEqualsConverter x:Key="RadioIntEqualsConverter"/>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>

        <!-- Stat Card Style -->
        <Style x:Key="CompareStatCard" TargetType="Border">
            <Setter Property="Background" Value="#1A1828"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Segmented Tab RadioButton Style -->
        <Style x:Key="CompareTabRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <!-- Row 0: Header & Back Button -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Source Selector Deck -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Stats Indicator Row -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Tab Selector & Action Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: Results List -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: HEADER -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Button Grid.Column="0" Command="{Binding GoBackCommand}"
                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                    Background="#20FFFFFF" BorderBrush="#35FFFFFF" Foreground="White"
                    Width="40" Height="40" Margin="0,0,16,0" Cursor="Hand" ToolTip="بازگشت به ابزارها">
                <materialDesign:PackIcon Kind="ArrowRight" Width="22" Height="22"/>
            </Button>

            <!-- Title & Description -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileCompare" Width="26" Height="26" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="مقایسه هوشمند آرشیوها (Library Compare &amp; Diff)" FontSize="22" FontWeight="Black" Foreground="White"/>
                </StackPanel>
                <TextBlock Text="مقایسه آرشیو خود با دیتابیس یا هارد دیسک دوستان برای شناسایی موارد کسری (Missing) و ارتقای کیفیت فیلم‌ها" FontSize="12.5" Foreground="{DynamicResource SecondaryText}" Margin="34,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- ROW 1: SOURCE SELECTOR DECK -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" CornerRadius="16" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mode Options & Browse -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Radio mode: DB or Folder -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <RadioButton Content="فایل دیتابیس (.db)" IsChecked="{Binding IsDatabaseMode}" GroupName="SourceModeGroup" Foreground="White" FontWeight="Bold" Margin="0,0,12,0"/>
                        <RadioButton Content="اسکن پوشه هارد" IsChecked="{Binding IsDatabaseMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" GroupName="SourceModeGroup" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Path Input -->
                    <TextBox Grid.Column="1" Text="{Binding TargetSourcePath, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="مسیر فایل دیتابیس دوم یا پوشه هارد دیسک را وارد کنید..."
                             Background="#14172B" BorderBrush="#35FFFFFF" Foreground="White" 
                             Padding="12,8" Height="40" VerticalContentAlignment="Center"
                             Margin="0,0,10,0"/>

                    <!-- Browse Button -->
                    <Button Grid.Column="2" Command="{Binding BrowseTargetFileCommand}"
                            Content="انتخاب فایل / پوشه" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#253867D6" BorderBrush="#503867D6" Foreground="White"
                            Height="40" Margin="0,0,10,0" Padding="14,0"/>

                    <!-- Start Compare Button -->
                    <Button Grid.Column="3" Command="{Binding StartCompareCommand}"
                            IsEnabled="{Binding IsComparing, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"
                            Background="{DynamicResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0"
                            Height="40" Padding="20,0" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlaySpeed" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="شروع مقایسه" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Status Message & Loader -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="{Binding IsComparing}" 
                                     Visibility="{Binding IsComparing, Converter={StaticResource BoolToVis}}" 
                                     Width="18" Height="18" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                     Margin="0,0,8,0" Foreground="{DynamicResource PrimaryColor}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 2: STATS INDICATOR ROW -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Missing in Mine (کسری‌های شما) -->
            <Border Grid.Column="0" Style="{StaticResource CompareStatCard}">
                <StackPanel>
                    <TextBlock Text="کسری‌های آرشیو شما" FontSize="11.5" Foreground="{DynamicResource SecondaryText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding MissingCount, Converter={StaticResource PersianNum}}" FontSize="20" FontWeight="Black" Foreground="#EB3B5A"/>
                        <TextBlock Text=" عنوان که ندارید" FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Upgrade Candidates (کیفیت بهتر) -->
            <Border Grid.Column="1" Style="{StaticResource CompareStatCard}">
                <StackPanel>
                    <TextBlock Text="قابل ارتقا (کیفیت بهتر)" FontSize="11.5" Foreground="{DynamicResource SecondaryText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding UpgradeCount, Converter={StaticResource PersianNum}}" FontSize="20" FontWeight="Black" Foreground="#20BF6B"/>
                        <TextBlock Text=" با کیفیت بالاتر در منبع دوم" FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: Matched (عناوین مشترک) -->
            <Border Grid.Column="2" Style="{StaticResource CompareStatCard}">
                <StackPanel>
                    <TextBlock Text="مشترک در هر دو آرشیو" FontSize="11.5" Foreground="{DynamicResource SecondaryText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding MatchedCount, Converter={StaticResource PersianNum}}" FontSize="20" FontWeight="Black" Foreground="#4B6584"/>
                        <TextBlock Text=" عنوان مشترک" FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 4: Only in Mine (انحصاری شما) -->
            <Border Grid.Column="3" Style="{StaticResource CompareStatCard}">
                <StackPanel>
                    <TextBlock Text="انحصاری در آرشیو شما" FontSize="11.5" Foreground="{DynamicResource SecondaryText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding OnlyInMineCount, Converter={StaticResource PersianNum}}" FontSize="20" FontWeight="Black" Foreground="#FA8231"/>
                        <TextBlock Text=" عنوان فقط در هارد شما" FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- ROW 3: TAB SELECTOR & ACTION BAR -->
        <!-- ======================================================== -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Category Tabs -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource CompareTabRadioStyle}" Content="کسری‌های من 🟥" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=0}"/>
                <RadioButton Style="{StaticResource CompareTabRadioStyle}" Content="کیفیت بالاتر 🟩" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=1}"/>
                <RadioButton Style="{StaticResource CompareTabRadioStyle}" Content="مشترک 🟦" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=2}"/>
                <RadioButton Style="{StaticResource CompareTabRadioStyle}" Content="انحصاری من 🟨" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=3}"/>
            </StackPanel>

            <!-- Search in results -->
            <Border Grid.Column="1" Margin="20,0,20,0" Height="36" Background="#14172B" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" CornerRadius="18" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="جستجو در بین نتایج مقایسه..." 
                             Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Action buttons: Export & Copy -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Command="{Binding ExportMissingToTxtCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#20EB3B5A" BorderBrush="#40EB3B5A" Foreground="#EB3B5A"
                        Height="36" Padding="12,0" Margin="0,0,8,0" ToolTip="ذخیره خروجی لیست کسری‌ها به فایل">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExportOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="خروجی فایل" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding CopyMissingToClipboardCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#203867D6" BorderBrush="#403867D6" Foreground="{DynamicResource NetworkBlue}"
                        Height="36" Padding="12,0" ToolTip="کپی متن لیست در کلیپ‌بورد">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="کپی لیست" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- ROW 4: RESULTS LIST -->
        <!-- ======================================================== -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" CornerRadius="16" Padding="4">
            <ListView ItemsSource="{Binding FilteredResults}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border CornerRadius="10" Background="#14172B" BorderBrush="#20FFFFFF" BorderThickness="1" Margin="4,3" Padding="12,10">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Title & Year -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding Year, StringFormat=' ({0})'}" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="4,0,0,0"/>
                                    <Border Background="#20FFFFFF" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MediaType}" FontSize="10" Foreground="{DynamicResource SecondaryText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding OtherPath}" FontSize="11" Foreground="#60FFFFFF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- My Quality -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                <TextBlock Text="کیفیت شما:" FontSize="10.5" Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock Text="{Binding MyQuality}" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>

                            <!-- Other Quality -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                <TextBlock Text="کیفیت منبع دوم:" FontSize="10.5" Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock Text="{Binding OtherQuality}" FontSize="12.5" FontWeight="Bold" Foreground="#20BF6B"/>
                            </StackPanel>

                            <!-- Status Badge -->
                            <Border Grid.Column="3" CornerRadius="8" Padding="10,5" VerticalAlignment="Center" Background="{Binding StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}">
                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>

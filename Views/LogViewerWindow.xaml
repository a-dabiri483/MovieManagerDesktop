<Window x:Class="MovieManagerDesktop.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="مرکز لاگ‌ها و مانیتورینگ زنده (System Live Console)" 
        Height="700" Width="1100" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#080E1E" Foreground="#E2E8F0"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <!-- Filter Button / Chip Style -->
        <Style x:Key="LogFilterRadioBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="#16203A"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#2A3859"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#223256"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ConsoleActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#16203A"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2A3859"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#223256"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Category Filters & Search -->
            <RowDefinition Height="Auto"/> <!-- Counters & Live Status -->
            <RowDefinition Height="*"/>    <!-- Rich Log Console -->
        </Grid.RowDefinitions>

        <!-- ── 1. Header Bar ── -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="8" Padding="6" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="ConsoleLine" Foreground="#38BDF8" Width="22" Height="22"/>
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="کنسول مانیتورینگ و لاگ‌های برنامه" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Border Background="#1E3A5F" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="ثبت و ردیابی لحظه‌ای رویدادهای شبکه، پلیر، اسکنر، دیتابیس، زیرنویس و سیستم" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Refresh -->
                    <Button Style="{StaticResource ConsoleActionBtn}" Click="RefreshLogs_Click" ToolTip="بارگذاری مجدد تمام لاگ‌ها از دیسک">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="تازه‌سازی" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Copy All -->
                    <Button Style="{StaticResource ConsoleActionBtn}" Click="CopyLogs_Click" ToolTip="کپی لاگ‌های فیلترشده در حافظه کلیپ‌بورد">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="کپی همه" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Export to File -->
                    <Button Style="{StaticResource ConsoleActionBtn}" Click="ExportLogs_Click" ToolTip="ذخیره لاگ‌ها در یک فایل متنی">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DownloadOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="خروجی فایل..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Clear -->
                    <Button Style="{StaticResource ConsoleActionBtn}" Click="ClearLogs_Click" Background="#2A1215" BorderBrush="#5A1E24" Foreground="#F87171" ToolTip="پاکسازی کنسول">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="پاک کردن" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 2. Filters & Search Bar ── -->
        <Border Grid.Row="1" Background="#0C1427" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Category Radio Chips -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <RadioButton Content="🌐 همه لاگ‌ها" IsChecked="True" Style="{StaticResource LogFilterRadioBtn}" Checked="CategoryFilter_Changed" Tag="ALL"/>
                    <RadioButton Content="📡 شبکه و ضدتحریم" Style="{StaticResource LogFilterRadioBtn}" Checked="CategoryFilter_Changed" Tag="Network"/>
                    <RadioButton Content="🎬 پلیر و VLC" Style="{StaticResource LogFilterRadioBtn}" Checked="CategoryFilter_Changed" Tag="Player"/>
                    <RadioButton Content="📁 اسکنر و مدیا" Style="{StaticResource LogFilterRadioBtn}" Checked="CategoryFilter_Changed" Tag="Scanner"/>
                    <RadioButton Content="☁️ بکاپ و گوگل‌درایو" Style="{StaticResource LogFilterRadioBtn}" Checked="CategoryFilter_Changed" Tag="Cloud"/>
                    <RadioButton Content="📝 زیرنویس و ترجمه" Style="{StaticResource LogFilterRadioBtn}" Checked="CategoryFilter_Changed" Tag="Subtitles"/>
                    <RadioButton Content="💾 پایگاه داده" Style="{StaticResource LogFilterRadioBtn}" Checked="CategoryFilter_Changed" Tag="Database"/>
                    <RadioButton Content="⚠️ فقط خطاها و اخطارها" Style="{StaticResource LogFilterRadioBtn}" Checked="CategoryFilter_Changed" Tag="Errors"/>
                </WrapPanel>

                <!-- Search Box & Level Toggles -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Border Grid.Column="0" Background="#16203A" BorderBrush="#2A3859" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Foreground="#64748B" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="SearchTextBox" 
                                     Background="Transparent" Foreground="White" BorderThickness="0" 
                                     VerticalAlignment="Center" FontSize="12.5"
                                     TextChanged="SearchTextBox_TextChanged"/>
                            <TextBlock Grid.Column="1" x:Name="SearchPlaceholder" Text="جستجوی سریع در متن، نام فایل، آدرس و متدها..." Foreground="#64748B" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" x:Name="ClearSearchBtn" Content="✖" Foreground="#64748B" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ClearSearchBtn_Click" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Toggles -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="AutoScrollCheckBox" Content="اسکرول خودکار" IsChecked="True" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <CheckBox x:Name="ShowInfoCheckBox" Content="اطلاعات (Info)" IsChecked="True" Foreground="#38BDF8" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0" Checked="LevelFilter_Changed" Unchecked="LevelFilter_Changed"/>
                        <CheckBox x:Name="ShowWarnCheckBox" Content="اخطار (Warn)" IsChecked="True" Foreground="#FBBF24" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0" Checked="LevelFilter_Changed" Unchecked="LevelFilter_Changed"/>
                        <CheckBox x:Name="ShowErrorCheckBox" Content="خطا (Error)" IsChecked="True" Foreground="#F87171" FontSize="11.5" VerticalAlignment="Center" Checked="LevelFilter_Changed" Unchecked="LevelFilter_Changed"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── 3. Live Stats & Status Badges ── -->
        <Border Grid.Row="2" Background="#0A1020" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Counts -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="تعداد کل:" Foreground="#64748B" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TotalCountText" Text="0" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" Margin="0,0,14,0"/>

                    <TextBlock Text="شبکه:" Foreground="#64748B" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock x:Name="NetworkCountText" Text="0" Foreground="#06B6D4" FontWeight="Bold" FontSize="11" Margin="0,0,14,0"/>

                    <TextBlock Text="اخطارها:" Foreground="#64748B" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock x:Name="WarnCountText" Text="0" Foreground="#FBBF24" FontWeight="Bold" FontSize="11" Margin="0,0,14,0"/>

                    <TextBlock Text="خطاها:" Foreground="#64748B" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock x:Name="ErrorCountText" Text="0" Foreground="#F87171" FontWeight="Bold" FontSize="11"/>
                </StackPanel>

                <!-- Live Network / VPN Status Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="وضعیت اتصال شبکه:" Foreground="#64748B" FontSize="11" Margin="0,0,6,0"/>
                    <Border x:Name="VpnStatusBadge" Background="#162E2A" CornerRadius="6" Padding="8,2">
                        <TextBlock x:Name="VpnStatusText" Text="مستقیم (اینترنت عادی)" Foreground="#34D399" FontSize="10.5" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 4. Main Log Console ── -->
        <Border Grid.Row="3" Background="#050914" Padding="4">
            <RichTextBox x:Name="LogRichTextBox" 
                         Background="#050914" 
                         Foreground="#E2E8F0"
                         BorderThickness="0"
                         IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Auto"
                         Padding="12,10"
                         FontFamily="Consolas, Cascadia Code, Courier New, Monospace"
                         FontSize="12.5"
                         FlowDirection="LeftToRight">
                <RichTextBox.Document>
                    <FlowDocument PageWidth="6000" LineHeight="1.2">
                    </FlowDocument>
                </RichTextBox.Document>
            </RichTextBox>
        </Border>
    </Grid>
</Window>

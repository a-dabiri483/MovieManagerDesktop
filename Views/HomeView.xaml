<UserControl x:Class="MovieManagerDesktop.Views.HomeView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
              xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
              xmlns:helpers="clr-namespace:MovieManagerDesktop.Helpers"
              xmlns:controls="clr-namespace:MovieManagerDesktop.Controls"
              xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
              mc:Ignorable="d"
              d:DataContext="{d:DesignInstance Type=viewmodels:HomeViewModel}"
              d:DesignHeight="950" d:DesignWidth="1100"
              FontFamily="{DynamicResource AppFontFamily}"
              TextOptions.TextFormattingMode="Display"
              TextOptions.TextRenderingMode="ClearType"
              TextOptions.TextHintingMode="Fixed"
              RenderOptions.ClearTypeHint="Enabled"
              RenderOptions.BitmapScalingMode="HighQuality"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Android Stat Card Style -->
        <Style x:Key="AndroidStatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="22,14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Android Action Grid Card Style -->
        <Style x:Key="AndroidActionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundLight}"/>
                    <Setter Property="BorderBrush" Value="#60EB3B5A"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.012" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.012" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Continue Watching Card Style (Elevated & Anti-Blur Hover) -->
        <Style x:Key="ContinueWatchingCard" TargetType="Border">
            <Setter Property="Width" Value="165"/>
            <Setter Property="Background" Value="#E60F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,10,14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <TranslateTransform X="0" Y="0"/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="#000000"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#99EB3B5A"/>
                    <Setter Property="Background" Value="#F51E293B"/>
                    <Setter Property="Panel.ZIndex" Value="50"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.7" Color="#000000"/>
                        </Setter.Value>
                    </Setter>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.14"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.14"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-7" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,16,32,100" MaxWidth="1150" HorizontalAlignment="Center">

            <!-- ================================================ -->
            <!-- 1. HERO FEATURED CINEMA BANNER -->
            <!-- ================================================ -->
            <Border Height="380" CornerRadius="24" ClipToBounds="True" Margin="6,0,6,24" BorderBrush="#40EB3B5A" BorderThickness="1.5" Background="#15182E"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    RenderOptions.EdgeMode="Aliased"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <!-- Featured Movie Backdrop Image -->
                    <Image Source="{Binding FeaturedBackdropUrl}" Stretch="UniformToFill" 
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderOptions.EdgeMode="Aliased"
                           SnapsToDevicePixels="True"/>

                    <!-- Dark Gradient Vignette Overlay -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#000A0B16" Offset="0"/>
                                <GradientStop Color="#300A0B16" Offset="0.4"/>
                                <GradientStop Color="#C00A0B16" Offset="0.75"/>
                                <GradientStop Color="#FF0A0B16" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Hero Content Area -->
                    <Grid Margin="36,26" VerticalAlignment="Bottom">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <!-- Title -->
                            <TextBlock Text="{Binding FeaturedTitle}" Foreground="White" FontSize="30" FontWeight="Black" TextAlignment="Center" Margin="0,0,0,8">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.9" Color="Black"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Genre Line -->
                            <TextBlock Text="{Binding FeaturedGenres}" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.9" Color="Black"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Single Action Button (پخش -> ورود به صفحه جزییات) -->
                            <Button Command="{Binding PlayFeaturedCommand}" Height="46" Padding="40,0" materialDesign:ButtonAssist.CornerRadius="16" Background="{DynamicResource PrimaryGradientBrush}" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                                <Button.Effect>
                                    <DropShadowEffect Color="#EB3B5A" BlurRadius="20" ShadowDepth="0" Opacity="0.75"/>
                                </Button.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="پخش" Foreground="White" FontSize="15.5" FontWeight="Black" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="Play" Width="22" Height="22" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================================================ -->
            <!-- 2. CONTINUE WATCHING SECTION (ادامه تماشا 🍿) -->
            <!-- ================================================ -->
            <StackPanel Margin="0,0,0,26" Visibility="{Binding HasContinueWatching, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Section Header with Title, Popcorn Icon & Left/Right Nav Buttons -->
                <Grid Margin="6,0,6,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Right Vertical Colored Bar -->
                        <Border Width="4" Height="20" Background="{DynamicResource PrimaryGradientBrush}" CornerRadius="2" Margin="0,0,8,0"/>
                        <!-- Section Title -->
                        <TextBlock Text="ادامه تماشا" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        
                        <!-- Colorful Cinema Popcorn Box (Exact match to Android 🍿 reference) -->
                        <Viewbox Width="26" Height="26" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Canvas Width="36" Height="36">
                                <!-- Popcorn Clouds (Top Golden Puffs) -->
                                <Ellipse Canvas.Left="6" Canvas.Top="4" Width="10" Height="9" Fill="#F6BD60"/>
                                <Ellipse Canvas.Left="20" Canvas.Top="4" Width="10" Height="9" Fill="#F6BD60"/>
                                <Ellipse Canvas.Left="12" Canvas.Top="1" Width="12" Height="10" Fill="#FFE6A7"/>
                                <Ellipse Canvas.Left="4" Canvas.Top="8" Width="9" Height="8" Fill="#EE9B00"/>
                                <Ellipse Canvas.Left="23" Canvas.Top="8" Width="9" Height="8" Fill="#EE9B00"/>
                                <Ellipse Canvas.Left="10" Canvas.Top="7" Width="16" Height="9" Fill="#FFD166"/>

                                <!-- Red Popcorn Cup Body (Trapezoid) -->
                                <Polygon Points="6,14 30,14 26,34 10,34" Fill="#E63946"/>

                                <!-- White Vertical Stripes -->
                                <Polygon Points="11,14 15,14 14,34 12,34" Fill="#FFFFFF"/>
                                <Polygon Points="21,14 25,14 24,34 22,34" Fill="#FFFFFF"/>

                                <!-- Top Cup Rim -->
                                <Rectangle Canvas.Left="5" Canvas.Top="13" Width="26" Height="2" RadiusX="1" RadiusY="1" Fill="#C1121F"/>
                            </Canvas>
                        </Viewbox>
                    </StackPanel>

                    <!-- Left / Right Navigation Scroll Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Click="ScrollRight_Click" Width="34" Height="34" Padding="0" Margin="0,0,6,0"
                                Background="#20FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                materialDesign:ButtonAssist.CornerRadius="17" Cursor="Hand" ToolTip="قبلی">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="22" Height="22" Foreground="White"/>
                        </Button>
                        <Button Click="ScrollLeft_Click" Width="34" Height="34" Padding="0"
                                Background="#20FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                materialDesign:ButtonAssist.CornerRadius="17" Cursor="Hand" ToolTip="بعدی">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="22" Height="22" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Horizontal ScrollViewer with Mouse Wheel Pass-Through -->
                <ScrollViewer x:Name="ContinueWatchingScrollViewer" 
                              HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollBarVisibility="Disabled" 
                              PreviewMouseWheel="ContinueWatchingScrollViewer_PreviewMouseWheel"
                              Padding="4,8,4,16">
                    <ItemsControl ItemsSource="{Binding ContinueWatchingItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ContinueWatchingCard}">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.PlayContinueWatchingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.OpenContinueWatchingDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <!-- Poster Box (Exact Match to Library Card) -->
                                        <Grid Height="235" ClipToBounds="True">
                                            
                                            <!-- Actual Poster Image with Bottom Gradient -->
                                            <Border CornerRadius="12" ClipToBounds="True" Background="#15FFFFFF">
                                                <Grid>
                                                    <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" 
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           RenderOptions.EdgeMode="Aliased"
                                                           SnapsToDevicePixels="True"/>
                                                    
                                                    <!-- Dark Gradient Overlay at bottom of poster -->
                                                    <Border VerticalAlignment="Bottom" Height="75">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="Transparent" Offset="0"/>
                                                                <GradientStop Color="#B0090E17" Offset="0.5"/>
                                                                <GradientStop Color="#F0090E17" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Top-Right in RTL (Top Corner): Dubbing & Subtitle Badges (Floating Dark Glass Circles) -->
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Panel.ZIndex="10">
                                                <!-- Dubbed (Neon Green Mic) -->
                                                <Border Visibility="{Binding IsDubbed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Background="#D90F172A" BorderBrush="#40334155" BorderThickness="1"
                                                        CornerRadius="14" Width="28" Height="28" Margin="0,0,0,5"
                                                        ToolTip="دارای دوبله فارسی">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.7" Color="Black"/>
                                                    </Border.Effect>
                                                    <materialDesign:PackIcon Kind="Microphone" Width="15" Height="15" Foreground="#00E676" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Subtitle (Yellow CC) -->
                                                <Border Visibility="{Binding IsSubtitled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Background="#D90F172A" BorderBrush="#40334155" BorderThickness="1"
                                                        CornerRadius="14" Width="28" Height="28"
                                                        ToolTip="دارای زیرنویس فارسی">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.7" Color="Black"/>
                                                    </Border.Effect>
                                                    <materialDesign:PackIcon Kind="ClosedCaption" Width="15" Height="15" Foreground="#FFD166" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Top-Left in RTL (Top Opposite Corner): IMDb Rating Capsule -->
                                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" Panel.ZIndex="12">
                                                <!-- IMDb Rating Capsule (Gold Star + Green Score) -->
                                                <Border Visibility="{Binding HasRating, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Background="#D90F172A" CornerRadius="12" Padding="7,3" BorderBrush="#40334155" BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.7" Color="Black"/>
                                                    </Border.Effect>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Star" Width="13" Height="13" Foreground="#FFD166" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding Rating, StringFormat={}{0:0.0}}" Foreground="#4ADE80" FontSize="11" FontWeight="Black" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Bottom-Inside-Poster Overlay: Purple Episode Tag (S1 E15 / S1 E2) on Right, Type Badge on Left -->
                                            <DockPanel VerticalAlignment="Bottom" Margin="8,0,8,8" Panel.ZIndex="10" LastChildFill="False">
                                                <!-- Purple Episode Pill (S1 E15 / S1 E2 / S7 E6) for Series at the BOTTOM -->
                                                <Border DockPanel.Dock="Right" Visibility="{Binding HasCompactEpisodeTag, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Background="#7C3AED" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.6" Color="#7C3AED"/>
                                                    </Border.Effect>
                                                    <TextBlock Text="{Binding CompactEpisodeTag}" Foreground="White" FontSize="10.5" FontWeight="Black" FlowDirection="LeftToRight"/>
                                                </Border>

                                                <!-- Type Badge on Left (فیلم / سریال) -->
                                                <Border DockPanel.Dock="Left" Background="{Binding TypeBadgeBg}" BorderBrush="{Binding TypeBadgeBorder}" BorderThickness="0.8" CornerRadius="5" Padding="7,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayType}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding TypeBadgeFg}"/>
                                                </Border>
                                            </DockPanel>

                                            <!-- Center Play Button Overlay -->
                                            <Border Width="46" Height="46" CornerRadius="23" Background="#CC0F172A" 
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    BorderBrush="#80FFFFFF" BorderThickness="1.5" Panel.ZIndex="8">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black"/>
                                                </Border.Effect>
                                                <materialDesign:PackIcon Kind="Play" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </Border>

                                            <!-- Red Progress Bar at Bottom of Poster -->
                                            <Grid VerticalAlignment="Bottom" Height="3.5" Panel.ZIndex="15">
                                                <Border Background="#40FFFFFF" CornerRadius="1.75"/>
                                                <Border Background="#EB3B5A" CornerRadius="1.75" HorizontalAlignment="Left">
                                                    <Border.Width>
                                                        <MultiBinding>
                                                            <MultiBinding.Converter>
                                                                <converters:PercentToWidthConverter/>
                                                            </MultiBinding.Converter>
                                                            <Binding Path="WatchProgressPercent"/>
                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <!-- Bottom Details (Below Poster) -->
                                        <StackPanel Margin="2,6,2,2">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="Bold" Foreground="White" 
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextAlignment="Center" ToolTip="{Binding DisplayName}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- ================================================ -->
            <!-- 3. FOUR STATS CARDS -->
            <!-- ================================================ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: فیلم‌ها (Pink) -->
                <Border Grid.Column="0" Style="{StaticResource AndroidStatCard}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#20EB3B5A" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="MovieOpenPlay" Width="22" Height="22" Foreground="{DynamicResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MovieCount}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource PrimaryColor}"/>
                            <TextBlock Text="فیلم‌ها" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: سریال‌ها (Blue) -->
                <Border Grid.Column="1" Style="{StaticResource AndroidStatCard}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#203867D6" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="TelevisionClassic" Width="22" Height="22" Foreground="{DynamicResource NetworkBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SeriesCount}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource NetworkBlue}"/>
                            <TextBlock Text="سریال‌ها" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 3: حجم کل (Teal) -->
                <Border Grid.Column="2" Style="{StaticResource AndroidStatCard}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#200FB9B1" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Harddisk" Width="22" Height="22" Foreground="#0FB9B1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalFileSize}" FontSize="18" FontWeight="Black" Foreground="#0FB9B1"/>
                            <TextBlock Text="حجم کل" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 4: میانگین امتیاز (Gold) -->
                <Border Grid.Column="3" Style="{StaticResource AndroidStatCard}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#20FFC107" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Star" Width="22" Height="22" Foreground="#FFC107" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AverageRating}" FontSize="24" FontWeight="Black" Foreground="#FFC107"/>
                            <TextBlock Text="میانگین امتیاز" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================================================ -->
            <!-- 4. OPERATIONS SECTION (عملیات | 4-Card 2x2 Grid) -->
            <!-- ================================================ -->
            <StackPanel Margin="0,0,0,26">
                <!-- Section Header with Vertical Bar -->
                <StackPanel Orientation="Horizontal" Margin="6,0,0,12">
                    <Border Width="4" Height="18" Background="{DynamicResource PurpleAccent}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="عملیات" FontSize="17" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <UniformGrid Columns="2">
                    <!-- 1. اسکن حافظه (Pink Icon) -->
                    <Border Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToScanCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#EB3B5A" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="Magnify" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="اسکن حافظه" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="اسکن خودکار فایل‌های ویدیویی" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- 2. جستجوی دستی (Purple Icon) -->
                    <Border Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToManualSearchCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#8854D0" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="PlaylistEdit" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="جستجوی دستی" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="جستجوی فیلم و سریال در TMDb" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- 3. آمار و تحلیل (Teal Icon) -->
                    <Border Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToAnalyticsCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#0FB9B1" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="ChartBoxOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="آمار و تحلیل" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="مشاهده آمار تماشا و ژانرهای مورد علاقه" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- 4. ردیاب سریال (Blue Icon) -->
                    <Border Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToTrackerCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#3867D6" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="TelevisionClassic" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ردیاب سریال" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="پیگیری وضعیت مشاهده فصل‌ها و یادآور" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- ================================================ -->
            <!-- 5. LIBRARY SECTION (کتابخانه) -->
            <!-- ================================================ -->
            <StackPanel Margin="0,0,0,26">
                <StackPanel Orientation="Horizontal" Margin="6,0,0,12">
                    <Border Width="4" Height="18" Background="{DynamicResource PurpleAccent}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="کتابخانه" FontSize="17" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- مجموعه‌ها (Orange Icon) -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToCollectionsCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#FA8231" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="AnimationPlayOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="مجموعه‌ها" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="فیلم‌های مرتبط و سری‌ها" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- بازیگران (Purple Icon) -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToActorsCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#8854D0" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="بازیگران" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="مرور بر اساس بازیگر" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- کارگردان‌ها (Emerald - Wide) -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToDirectorsCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#26DE81" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="ClapperboardOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="کارگردان‌ها" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="مرور بر اساس کارگردان" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ================================================ -->
            <!-- 6. CINEMA HUB & BOX OFFICE -->
            <!-- ================================================ -->
            <StackPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Margin="6,0,0,12">
                    <Border Width="4" Height="18" Background="{DynamicResource PurpleAccent}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="دنیای سینما و باکس آفیس" FontSize="17" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <Border Style="{StaticResource AndroidActionCard}" CornerRadius="20" Padding="20,18">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding GoToCinemaHubCommand}"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#EB3B5A" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="MoviePlay" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="دنیای سینما و باکس آفیس" FontSize="15.5" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="اخبار روز سینمای ایران و جهان، جدول فروش باکس آفیس و ..." FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ArrowLeft" Width="22" Height="22" Foreground="#EB3B5A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Height="38" CornerRadius="12" Background="#20EB3B5A" BorderBrush="#50EB3B5A" BorderThickness="1" Margin="4,0" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding GoToCinemaNewsCommand}"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="NewspaperVariantOutline" Width="16" Height="16" Foreground="#EB3B5A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="اخبار سینما" FontSize="12.5" FontWeight="Bold" Foreground="#EB3B5A"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Height="38" CornerRadius="12" Background="#20FFB800" BorderBrush="#50FFB800" BorderThickness="1" Margin="4,0" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding GoToBoxOfficeCommand}"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="TrophyOutline" Width="16" Height="16" Foreground="#FFB800" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="باکس آفیس" FontSize="12.5" FontWeight="Bold" Foreground="#FFB800"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Height="38" CornerRadius="12" Background="#200FB9B1" BorderBrush="#500FB9B1" BorderThickness="1" Margin="4,0" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding GoToReleasesCommand}"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="TimerSand" Width="16" Height="16" Foreground="#0FB9B1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="اکران‌ها" FontSize="12.5" FontWeight="Bold" Foreground="#0FB9B1"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
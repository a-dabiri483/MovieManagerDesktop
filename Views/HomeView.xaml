<UserControl x:Class="MovieManagerDesktop.Views.HomeView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
              xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
              mc:Ignorable="d"
              d:DataContext="{d:DesignInstance Type=viewmodels:HomeViewModel}"
              d:DesignHeight="850" d:DesignWidth="1100"
              FlowDirection="RightToLeft">

    <UserControl.Resources>
        <!-- Android 2-Stat Card Style -->
        <Style x:Key="AndroidStatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Android Action Grid Card Style -->
        <Style x:Key="AndroidActionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundLight}"/>
                    <Setter Property="BorderBrush" Value="#60EB3B5A"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.015" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.015" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,20,32,40" MaxWidth="1100">

            <!-- 1. HERO FEATURED CINEMA BANNER (دقیقاً مثل اسکرین‌شات اندروید ناروتو/فیلم برتر) -->
            <Border Height="270" CornerRadius="26" ClipToBounds="True" Margin="6,0,6,24" BorderBrush="#35EB3B5A" BorderThickness="1" Background="#15182E">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <!-- Featured Movie Backdrop Image -->
                    <Image Source="{Binding FeaturedBackdropUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Dark Gradient Vignette Overlay -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#200A0B16" Offset="0"/>
                                <GradientStop Color="#700A0B16" Offset="0.35"/>
                                <GradientStop Color="#F00A0B16" Offset="0.8"/>
                                <GradientStop Color="#FF0A0B16" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Hero Content Area -->
                    <Grid Margin="36,20" VerticalAlignment="Bottom">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <!-- Title Row with Network/Local indicator -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="{Binding FeaturedTitle}" Foreground="White" FontSize="26" FontWeight="Black">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.8" Color="Black"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <materialDesign:PackIcon Kind="Wifi" Foreground="#3867D6" Width="22" Height="22" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>

                            <!-- Genre Line -->
                            <TextBlock Text="{Binding FeaturedGenres}" Foreground="#E0E0E0" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.9" Color="Black"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Two Action Buttons (پخش ▶ و اطلاعات ℹ) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Red/Pink Filled Button (پخش) -->
                                <Button Command="{Binding PlayFeaturedCommand}" Height="42" Padding="28,0" materialDesign:ButtonAssist.CornerRadius="14" Background="{DynamicResource PrimaryGradientBrush}" BorderThickness="0" Cursor="Hand" Margin="0,0,14,0">
                                    <Button.Effect>
                                        <DropShadowEffect Color="#EB3B5A" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                                    </Button.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="پخش" Foreground="White" FontSize="14.5" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <materialDesign:PackIcon Kind="Play" Width="18" Height="18" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Glass Outline Button (اطلاعات) -->
                                <Button Command="{Binding OpenFeaturedDetailsCommand}" Height="42" Padding="24,0" materialDesign:ButtonAssist.CornerRadius="14" Background="#35FFFFFF" BorderBrush="#50FFFFFF" BorderThickness="1" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="اطلاعات" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. TWO STATS CARDS (آمار شبکه و آمار حافظه - Android Dual Card) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Card: آمار حافظه (Pink Card) -->
                <Border Grid.Column="0" Style="{StaticResource AndroidStatCard}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Circle Icon -->
                        <Border Width="50" Height="50" CornerRadius="25" Background="#25EB3B5A" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="26" Height="26" Foreground="{DynamicResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Big Number -->
                        <TextBlock Text="{Binding MovieCount}" FontSize="32" FontWeight="Black" Foreground="{DynamicResource PrimaryColor}" HorizontalAlignment="Center"/>
                        <!-- Label -->
                        <TextBlock Text="آمار حافظه" FontSize="13" Foreground="{DynamicResource SecondaryText}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Right Card: آمار شبکه (Blue Card) -->
                <Border Grid.Column="1" Style="{StaticResource AndroidStatCard}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Circle Icon -->
                        <Border Width="50" Height="50" CornerRadius="25" Background="#253867D6" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="Wifi" Width="26" Height="26" Foreground="{DynamicResource NetworkBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Big Number -->
                        <TextBlock Text="{Binding SeriesCount}" FontSize="32" FontWeight="Black" Foreground="{DynamicResource NetworkBlue}" HorizontalAlignment="Center"/>
                        <!-- Label -->
                        <TextBlock Text="آمار شبکه" FontSize="13" Foreground="{DynamicResource SecondaryText}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. CONTINUE WATCHING (🍿 ادامه تماشا |) -->
            <StackPanel Margin="0,0,0,26">
                <!-- Section Header with Vertical Bar -->
                <StackPanel Orientation="Horizontal" Margin="6,0,0,12">
                    <Border Width="4" Height="18" Background="{DynamicResource PurpleAccent}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="ادامه تماشا 🍿" FontSize="17" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ContinueWatchingMovies}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AndroidActionCard}" Width="190" Height="275" Margin="6" Padding="0" ClipToBounds="True">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.GoToMoviesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <!-- Poster Image with Fallback -->
                                        <Border Background="#1C203C">
                                            <Image Source="{Binding File.PosterUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <!-- Top Badge (e.g. S5 E10) -->
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#CC8854D0" CornerRadius="6" Padding="8,3" Margin="8">
                                            <TextBlock Text="{Binding SeasonEpisodeText, TargetNullValue='S1 E1', FallbackValue='S1 E1'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Center Translucent Play Icon -->
                                        <Border Width="46" Height="46" CornerRadius="23" Background="#85000000" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Play" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                        </Border>

                                        <!-- Bottom Gradient Details -->
                                        <Border VerticalAlignment="Bottom" Padding="12,12,12,10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#000A0B16" Offset="0"/>
                                                    <GradientStop Color="#DD0A0B16" Offset="0.35"/>
                                                    <GradientStop Color="#FA0A0B16" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel>
                                                <TextBlock Text="{Binding File.FormattedTitle, TargetNullValue='عنوان فیلم/سریال'}" FontSize="13" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <Grid Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding File.MediaType, TargetNullValue='سریال'}" FontSize="11" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding File.WatchProgressPercent, StringFormat='{}{0}%', FallbackValue='45%'}" FontSize="11" Foreground="{DynamicResource PrimaryColor}" FontWeight="Bold" HorizontalAlignment="Left"/>
                                                </Grid>
                                                <!-- Progress Bar -->
                                                <ProgressBar Value="{Binding File.WatchProgressPercent, FallbackValue=45}" Maximum="100" Height="3.5" Margin="0,6,0,0" Foreground="{DynamicResource PrimaryColor}" Background="#30FFFFFF" BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- 4. OPERATIONS SECTION (عملیات | 4-Card 2x2 Grid) -->
            <StackPanel Margin="0,0,0,26">
                <!-- Section Header with Vertical Bar -->
                <StackPanel Orientation="Horizontal" Margin="6,0,0,12">
                    <Border Width="4" Height="18" Background="{DynamicResource PurpleAccent}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="عملیات" FontSize="17" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <UniformGrid Columns="2">
                    <!-- 1. اسکن حافظه (Pink Icon) -->
                    <Border Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToScanCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Colored Icon Box on Right -->
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#EB3B5A" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="Magnify" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Text in Middle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="اسکن حافظه" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="اسکن خودکار فایل‌های ویدیویی" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <!-- Chevron Arrow on Left -->
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- 2. جستجوی دستی (Purple Icon) -->
                    <Border Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToMoviesCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Colored Icon Box on Right -->
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#8854D0" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="PlaylistEdit" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Text in Middle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="جستجوی دستی" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="جستجوی فیلم و سریال در TMDb" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <!-- Chevron Arrow on Left -->
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- 3. آمار و تحلیل (Teal Icon) -->
                    <Border Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToMoviesCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Colored Icon Box on Right -->
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#0FB9B1" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="ChartBoxOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Text in Middle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="آمار و تحلیل" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="مشاهده آمار تماشا و ژانرهای مورد علاقه" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <!-- Chevron Arrow on Left -->
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- 4. ردیاب سریال (Blue Icon) -->
                    <Border Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToCalendarCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Colored Icon Box on Right -->
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#3867D6" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="TelevisionClassic" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Text in Middle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ردیاب سریال" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="پیگیری وضعیت مشاهده فصل‌ها و یادآور" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <!-- Chevron Arrow on Left -->
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- 5. LIBRARY SECTION (کتابخانه | Collections, Cast, Directors) -->
            <StackPanel Margin="0,0,0,10">
                <!-- Section Header with Vertical Bar -->
                <StackPanel Orientation="Horizontal" Margin="6,0,0,12">
                    <Border Width="4" Height="18" Background="{DynamicResource PurpleAccent}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="کتابخانه" FontSize="17" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- مجموعه‌ها (Orange Icon) -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToCollectionsCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#FA8231" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="AnimationPlayOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="مجموعه‌ها" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="فیلم‌های مرتبط و سری‌ها" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- بازیگران (Purple Icon) -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToMoviesCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#8854D0" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="بازیگران" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="مرور بر اساس بازیگر" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- کارگردان‌ها (Emerald Icon - Wide Card) -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource AndroidActionCard}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding GoToMoviesCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="16" Background="#26DE81" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="ClapperboardOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="کارگردان‌ها" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="مرور بر اساس کارگردان" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
<UserControl x:Class="MovieManagerDesktop.Views.TrackerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:TrackerViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100"
             FlowDirection="RightToLeft"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <materialDesign:BooleanToVisibilityConverter x:Key="InverseBoolToVis" TrueValue="Collapsed" FalseValue="Visible"/>
        <converters:PersianNumberConverter x:Key="PersianNumberConverter"/>
        <converters:RadioIntEqualsConverter x:Key="RadioIntEqualsConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Sub Filter Chip Style -->
        <Style x:Key="TrackerChipRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,20,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP HEADER & BULK ACTION BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Normal Header (When NOT in Selection Mode) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsSelectionMode, Converter={StaticResource InverseBoolToVis}}">
                <Button Command="{Binding GoBackCommand}" 
                        Background="#20FFFFFF" BorderThickness="0" Width="40" Height="40" Padding="0" 
                        materialDesign:ButtonAssist.CornerRadius="20" ToolTip="بازگشت به خانه" Cursor="Hand" Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="ArrowRight" Width="22" Height="22" Foreground="{DynamicResource PrimaryColor}"/>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Radar" Width="24" Height="24" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="ردیاب اختصاصی فیلم و سریال" FontSize="22" FontWeight="Black" Foreground="White"/>
                    </StackPanel>
                    <TextBlock Text="پیگیری اختصاصی وضعیت پخش، تاریخ قسمت‌های جدید و تقویم عناوین اضافه شده" FontSize="12.5" Foreground="{DynamicResource SecondaryText}" Margin="32,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Bulk Selection Top Bar (When Selection Mode is Active) -->
            <Border Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource CardBackground}" CornerRadius="16" BorderBrush="{DynamicResource PrimaryColor}" BorderThickness="1.5" Padding="16,8"
                    Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Selected Count Text & Select All / Deselect -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryGradientBrush}" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="CheckboxMarkedCircleOutline" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedCount, Converter={StaticResource PersianNumberConverter}, StringFormat='{}{0} مورد انتخاب شده'}" FontSize="14" FontWeight="Black" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        
                        <!-- Select All -->
                        <Button Command="{Binding SelectAllCommand}" Height="34" Padding="14,0" Background="#20FFFFFF" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="10" Cursor="Hand" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SelectAll" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="انتخاب همه" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Deselect All / Cancel -->
                        <Button Command="{Binding DeselectAllCommand}" Height="34" Padding="14,0" Background="#20FFFFFF" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="10" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="لغو انتخاب" Foreground="{DynamicResource SecondaryText}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bulk Actions (Refresh & Delete) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Bulk Refresh from TMDb -->
                        <Button Command="{Binding RefreshSelectedFromTmdbCommand}" Height="36" Padding="14,0" Background="#2500D2D3" BorderBrush="#6000D2D3" BorderThickness="1" materialDesign:ButtonAssist.CornerRadius="10" Cursor="Hand" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sync" Width="16" Height="16" Foreground="#00D2D3" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="بروزرسانی از TMDb" Foreground="#00D2D3" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Bulk Delete -->
                        <Button Command="{Binding DeleteSelectedCommand}" Height="36" Padding="14,0" Background="#30FF4757" BorderBrush="#80FF4757" BorderThickness="1" materialDesign:ButtonAssist.CornerRadius="10" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="#FF4757" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="حذف از ردیاب" Foreground="#FF4757" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Add from TMDb Button (When NOT in Selection Mode) -->
            <Button Grid.Column="2" Command="{Binding GoToManualSearchCommand}" Height="42" Padding="20,0" Background="{DynamicResource PrimaryGradientBrush}" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="14" Cursor="Hand"
                    Visibility="{Binding IsSelectionMode, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="افزودن عنوان جدید از TMDb" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ROW 1: CONTROLS, SEARCH & FILTERS -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="20" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Padding="18,14" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter Chips -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource TrackerChipRadio}" Content="همه" IsChecked="{Binding SelectedFilterIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=0}"/>
                    <RadioButton Style="{StaticResource TrackerChipRadio}" Content="سریال‌ها" IsChecked="{Binding SelectedFilterIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=1}"/>
                    <RadioButton Style="{StaticResource TrackerChipRadio}" Content="فیلم‌ها" IsChecked="{Binding SelectedFilterIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=2}"/>
                    <RadioButton Style="{StaticResource TrackerChipRadio}" Content="در حال پخش" IsChecked="{Binding SelectedFilterIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=3}"/>
                    <RadioButton Style="{StaticResource TrackerChipRadio}" Content="پایان یافته" IsChecked="{Binding SelectedFilterIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=4}"/>
                </StackPanel>

                <!-- Tracked Count Badge -->
                <Border Grid.Column="1" HorizontalAlignment="Right" Background="#14172B" CornerRadius="12" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Padding="12,6" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BookmarkMultipleOutline" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TrackedCount, Converter={StaticResource PersianNumberConverter}, StringFormat='{}{0} عنوان در حال پیگیری'}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Search Box -->
                <Border Grid.Column="2" Background="#15FFFFFF" CornerRadius="14" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Padding="14,2" Width="260">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="جستجو در عناوین ردیاب..."
                                 Foreground="White" FontSize="13" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ROW 2: TRACKER CARDS LIST -->
        <Grid Grid.Row="2">
            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource PrimaryColor}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10"/>

            <!-- Empty State (No tracked items) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FilteredItems.Count}" Value="0"/>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="86" Height="86" CornerRadius="43" Background="#15FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="Radar" Width="48" Height="48" Foreground="{DynamicResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="هنوز هیچ عنوانی به ردیاب اضافه نشده است" FontSize="17" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="شما می‌توانید فیلم‌ها و سریال‌های در حال پخش یا جدید را از TMDb جستجو و به ردیاب اضافه کنید" FontSize="13" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,6,0,18"/>
                <Button Command="{Binding GoToManualSearchCommand}" Height="42" Padding="24,0" Background="{DynamicResource PrimaryGradientBrush}" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="14" Cursor="Hand" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="MagnifyPlus" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="جستجو و افزودن فیلم/سریال به ردیاب" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Cards Wrap Grid -->
            <ListBox ItemsSource="{Binding FilteredItems}" Background="Transparent" BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="0,0,0,100">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="StartAndEndOnly"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="cardBorder" Width="220" Height="385" Background="{DynamicResource CardBackground}" CornerRadius="18" ClipToBounds="True" Margin="6" Cursor="Hand">
                            
                            <!-- Left Click: Open details if not in selection mode, or toggle select if in selection mode -->
                            <!-- Right Click: Directly toggle select and open top bulk action bar -->
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding HandleCardClickCommand}"/>
                                <MouseBinding Gesture="RightClick" Command="{Binding HandleCardRightClickCommand}"/>
                            </Border.InputBindings>

                            <!-- Border Style for Selection Highlight -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                            <Setter Property="BorderThickness" Value="2.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="240"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Poster Image -->
                                <Border Grid.Row="0" Background="#1A1C30">
                                    <Grid>
                                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        
                                        <!-- Gradient Overlay -->
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#00000000" Offset="0.5"/>
                                                    <GradientStop Color="#CC0A0B16" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Selection Checkbox (Top Left) -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Width="26" Height="26" CornerRadius="13"
                                                Background="#80000000" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                        </Border>

                                        <!-- Status Badge (Top Right) -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E0000000" CornerRadius="10" Padding="8,4" Margin="8">
                                            <TextBlock Text="{Binding FormattedStatus}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                        </Border>

                                        <!-- Media Type Badge (Bottom Left) -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#CC000000" CornerRadius="10" Padding="8,4" Margin="8">
                                            <TextBlock Text="{Binding MediaTypeDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Info Section -->
                                <Grid Grid.Row="1" Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="Black" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>

                                    <!-- Year & Genres -->
                                    <TextBlock Grid.Row="1" Text="{Binding YearAndGenres}" Foreground="{DynamicResource SecondaryText}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>

                                    <!-- Seasons/Episodes or Next Air Date -->
                                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding SeasonsEpisodesCount}" Foreground="#A4B0BE" FontSize="11" FontWeight="SemiBold" Visibility="{Binding SeasonsEpisodesCount, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        <Border Background="#20EB3B5A" CornerRadius="8" Padding="6,3" Margin="0,4,0,0" Visibility="{Binding NextEpisodeInfo, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{Binding NextEpisodeInfo}" Foreground="{DynamicResource PrimaryColor}" FontSize="10.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Action Button -->
                                    <Button Grid.Row="3" Command="{Binding HandleCardClickCommand}" Height="32" Background="#20FFFFFF" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="8" Margin="0,6,0,0">
                                        <TextBlock Text="مشاهده جزئیات ردیاب" Foreground="White" FontSize="11.5" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>

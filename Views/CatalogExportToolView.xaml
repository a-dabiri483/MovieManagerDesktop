<UserControl x:Class="MovieManagerDesktop.Views.CatalogExportToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
             xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CatalogExportToolViewModel}"
             d:DesignHeight="850" d:DesignWidth="1100"
             FlowDirection="RightToLeft"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:PersianNumberConverter x:Key="PersianNum"/>
        <converters:RadioIntEqualsConverter x:Key="RadioIntEqualsConverter"/>

        <!-- Selection Card Style -->
        <Style x:Key="ExportOptionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,30">
        <StackPanel Margin="32,24,32,24" MaxWidth="1000">

            <!-- ======================================================== -->
            <!-- HEADER -->
            <!-- ======================================================== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0" Command="{Binding GoBackCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                        Background="#20FFFFFF" BorderBrush="#35FFFFFF" Foreground="White"
                        Width="40" Height="40" Margin="0,0,16,0" Cursor="Hand" ToolTip="بازگشت به ابزارها">
                    <materialDesign:PackIcon Kind="ArrowRight" Width="22" Height="22"/>
                </Button>

                <!-- Title & Description -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BookOpenPageVariantOutline" Width="26" Height="26" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="تولید کاتالوگ و خروجی جامع (Catalog Exporter)" FontSize="22" FontWeight="Black" Foreground="White"/>
                    </StackPanel>
                    <TextBlock Text="تولید اسناد رسمی Word، جداول اکسل و کاتالوگ تعاملی وب از آرشیو فیلم‌ها و سریال‌های شما" FontSize="12.5" Foreground="{DynamicResource SecondaryText}" Margin="34,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- STEP 1: CHOOSE FORMAT -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource ExportOptionCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <materialDesign:PackIcon Kind="FormatListGroup" Width="20" Height="20" Foreground="{DynamicResource PrimaryColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="۱. انتخاب فرمت خروجی کاتالوگ" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>

                    <UniformGrid Columns="3" Margin="0,4,0,0">
                        <!-- Word Document -->
                        <RadioButton GroupName="ExportFormatGroup" 
                                     IsChecked="{Binding FormatIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=0}"
                                     Style="{x:Null}" Margin="6" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="cardBorder" CornerRadius="14" Padding="16" Background="#14172B" BorderThickness="2" BorderBrush="#25FFFFFF">
                                        <Grid>
                                            <!-- Selected Indicator Badge in Top-Left (RTL) -->
                                            <Border x:Name="checkBadge" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource PrimaryColor}" 
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                                                <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="FileWordBox" Width="38" Height="38" Foreground="#2B579A" Margin="0,0,0,10"/>
                                                <TextBlock Text="سند مایکروسافت ورد (.doc)" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                <TextBlock Text="شامل جدول‌بندی راست‌چین، مشخصات کامل، امتیازات و تصاویر بندانگشتی پوسترها" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="18"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                            <Setter TargetName="cardBorder" Property="Background" Value="#25EB3B5A"/>
                                            <Setter TargetName="checkBadge" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsChecked" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="cardBorder" Property="Background" Value="#35EB3B5A"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Excel / CSV -->
                        <RadioButton GroupName="ExportFormatGroup" 
                                     IsChecked="{Binding FormatIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=1}"
                                     Style="{x:Null}" Margin="6" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="cardBorder" CornerRadius="14" Padding="16" Background="#14172B" BorderThickness="2" BorderBrush="#25FFFFFF">
                                        <Grid>
                                            <!-- Selected Indicator Badge in Top-Left (RTL) -->
                                            <Border x:Name="checkBadge" Width="24" Height="24" CornerRadius="12" Background="#217346" 
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                                                <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="FileExcelBox" Width="38" Height="38" Foreground="#217346" Margin="0,0,0,10"/>
                                                <TextBlock Text="فایل اکسل (.csv)" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                <TextBlock Text="مناسب برای محاسبات، فیلترگذاری و بایگانی داده‌ها با پشتیبانی کامل از کاراکترهای فارسی" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="18"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="#217346"/>
                                            <Setter TargetName="cardBorder" Property="Background" Value="#25217346"/>
                                            <Setter TargetName="checkBadge" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="#217346"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsChecked" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="cardBorder" Property="Background" Value="#35217346"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Interactive HTML -->
                        <RadioButton GroupName="ExportFormatGroup" 
                                     IsChecked="{Binding FormatIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=2}"
                                     Style="{x:Null}" Margin="6" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="cardBorder" CornerRadius="14" Padding="16" Background="#14172B" BorderThickness="2" BorderBrush="#25FFFFFF">
                                        <Grid>
                                            <!-- Selected Indicator Badge in Top-Left (RTL) -->
                                            <Border x:Name="checkBadge" Width="24" Height="24" CornerRadius="12" Background="#8854D0" 
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                                                <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="Web" Width="38" Height="38" Foreground="#8854D0" Margin="0,0,0,10"/>
                                                <TextBlock Text="کاتالوگ تعاملی وب (.html)" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                <TextBlock Text="صفحه وب مدرن دارک با جستجوی زنده، قابل ارسال برای دوستان بدون نیاز به نصب برنامه" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="18"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="#8854D0"/>
                                            <Setter TargetName="cardBorder" Property="Background" Value="#258854D0"/>
                                            <Setter TargetName="checkBadge" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="#8854D0"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsChecked" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="cardBorder" Property="Background" Value="#358854D0"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- STEP 2: CHOOSE CONTENT FILTER -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource ExportOptionCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <materialDesign:PackIcon Kind="FilterOutline" Width="20" Height="20" Foreground="{DynamicResource PrimaryColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="۲. فیلتر محتوای خروجی" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <RadioButton Content="همه عناوین آرشیو" IsChecked="{Binding FilterTypeIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=0}" GroupName="ContentFilterGroup" Foreground="White" FontWeight="Bold" Margin="0,0,16,8"/>
                        <RadioButton Content="فقط فیلم‌های سینمایی" IsChecked="{Binding FilterTypeIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=1}" GroupName="ContentFilterGroup" Foreground="White" FontWeight="Bold" Margin="0,0,16,8"/>
                        <RadioButton Content="فقط سریال‌ها" IsChecked="{Binding FilterTypeIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=2}" GroupName="ContentFilterGroup" Foreground="White" FontWeight="Bold" Margin="0,0,16,8"/>
                        <RadioButton Content="فقط علاقه‌مندی‌ها (Favorites)" IsChecked="{Binding FilterTypeIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=3}" GroupName="ContentFilterGroup" Foreground="White" FontWeight="Bold" Margin="0,0,16,8"/>
                        <RadioButton Content="فقط دیده‌شده‌ها (Watched)" IsChecked="{Binding FilterTypeIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=4}" GroupName="ContentFilterGroup" Foreground="White" FontWeight="Bold" Margin="0,0,16,8"/>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="تعداد عناوین منطبق برای خروجی:" FontSize="12.5" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBlock Text="{Binding MatchingItemsCount, Converter={StaticResource PersianNum}}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" Margin="6,0,0,0"/>
                        <TextBlock Text="عنوان" FontSize="12.5" Foreground="{DynamicResource SecondaryText}" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- STEP 3: CUSTOMIZE FIELDS -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource ExportOptionCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" Foreground="{DynamicResource PrimaryColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="۳. فیلدهای گنجانده‌شده در گزارش" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <CheckBox Content="تصویر پوستر" IsChecked="{Binding IncludePosters}" Foreground="White" Margin="0,0,24,8"/>
                        <CheckBox Content="کیفیت و رزولوشن" IsChecked="{Binding IncludeQuality}" Foreground="White" Margin="0,0,24,8"/>
                        <CheckBox Content="اسامی بازیگران" IsChecked="{Binding IncludeActors}" Foreground="White" Margin="0,0,24,8"/>
                        <CheckBox Content="خلاصه داستان" IsChecked="{Binding IncludeOverview}" Foreground="White" Margin="0,0,24,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- ACTION & PROGRESS DECK -->
            <!-- ======================================================== -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" CornerRadius="16" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6" Margin="0,10,20,0" 
                                         Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" 
                                         Foreground="{DynamicResource PrimaryGradientBrush}" Background="#20FFFFFF"/>
                        </StackPanel>

                        <!-- Generate Button -->
                        <Button Grid.Column="1" Command="{Binding ExportCatalogCommand}"
                                IsEnabled="{Binding IsExporting, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"
                                Background="{DynamicResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0"
                                Height="46" Padding="28,0" materialDesign:ButtonAssist.CornerRadius="12"
                                FontWeight="Bold" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Creation" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="تولید کاتالوگ و خروجی" FontSize="14.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<Window x:Class="MovieManagerDesktop.Views.RestoreConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="پیش‌نمایش و تأیید بازیابی اطلاعات"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False">

    <Border Background="#F50F172A" CornerRadius="20" BorderBrush="#4038BDF8" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="4" Color="Black" Opacity="0.85"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Body -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="19,19,0,0" Padding="18,14"
                    BorderBrush="#334155" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="DatabaseSync" Width="24" Height="24" Foreground="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="پیش‌نمایش و تأیید بازیابی اطلاعات" FontSize="14.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Click="BtnCancel_Click" HorizontalAlignment="Left"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            Width="30" Height="30" Cursor="Hand" Padding="0">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <StackPanel Grid.Row="1" Margin="22,18,22,18">
                <!-- Hero File Card -->
                <Border Background="#1E293B" CornerRadius="14" BorderBrush="#334155" BorderThickness="1" Padding="16,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon Badge -->
                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#162A45" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ShieldCheck" Width="26" Height="26" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- File Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                            <WrapPanel Orientation="Horizontal">
                                <!-- Format Badge -->
                                <Border Background="#15332E" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,8,4">
                                    <TextBlock Text="{Binding FormatType}" FontSize="11" Foreground="#34D399" FontWeight="SemiBold"/>
                                </Border>

                                <!-- File Size Badge -->
                                <Border Background="#1A2840" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,8,4">
                                    <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="#7DD3FC" FontWeight="SemiBold"/>
                                </Border>

                                <!-- Date Badge -->
                                <Border Background="#25223D" BorderBrush="#818CF8" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarClock" Width="13" Height="13" Foreground="#A5B4FC" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="#A5B4FC" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Detailed Statistics Grid -->
                <TextBlock Text="محتویات شناسایی‌شده در نسخه پشتیبان:" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="2,0,0,10"/>

                <Grid Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Movies -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#131E30" BorderBrush="#1E2E48" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#2B2113" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="MovieOpenOutline" Width="18" Height="18" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="فیلم‌های سینمایی" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding MoviesCount, StringFormat='{}{0:N0} عنوان فیلم'}" FontSize="13" FontWeight="Bold" Foreground="#FDE68A"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2: Series -->
                    <Border Grid.Row="0" Grid.Column="2" Background="#131E30" BorderBrush="#1E2E48" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#211E3B" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="TelevisionClassic" Width="18" Height="18" Foreground="#818CF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="سریال‌ها" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding SeriesCount, StringFormat='{}{0:N0} عنوان سریال'}" FontSize="13" FontWeight="Bold" Foreground="#C7D2FE"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3: Seasons & Episodes -->
                    <Border Grid.Row="2" Grid.Column="0" Background="#131E30" BorderBrush="#1E2E48" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#142C44" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Filmstrip" Width="18" Height="18" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="فصل‌ها و قسمت‌ها" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="#BAE6FD">
                                    <Run Text="{Binding TvSeasonsCount, Mode=OneWay}"/>
                                    <Run Text="فصل /"/>
                                    <Run Text="{Binding TvEpisodesCount, Mode=OneWay}"/>
                                    <Run Text="قسمت"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 4: Images & Posters -->
                    <Border Grid.Row="2" Grid.Column="2" Background="#131E30" BorderBrush="#1E2E48" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#2E1724" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ImageMultipleOutline" Width="18" Height="18" Foreground="#F43F5E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="تصاویر و پوسترها" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding ImagesText}" FontSize="12.5" FontWeight="Bold" Foreground="#FECDD3"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 5: Settings -->
                    <Border Grid.Row="4" Grid.Column="0" Background="#131E30" BorderBrush="#1E2E48" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#132B25" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="تنظیمات برنامه" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding HasSettingsText}" FontSize="12" FontWeight="Bold" Foreground="#A7F3D0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 6: Watch Progress -->
                    <Border Grid.Row="4" Grid.Column="2" Background="#131E30" BorderBrush="#1E2E48" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#10253B" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ProgressCheck" Width="18" Height="18" Foreground="#0EA5E9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="سوابق تماشا" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding WatchProgressText}" FontSize="12" FontWeight="Bold" Foreground="#BAE6FD"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Information Notice -->
                <Border Background="#0D2036" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20" Foreground="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="اطلاعات این فایل با دیتابیس فعلی شما ادغام می‌گردد. عناوین جدید اضافه شده و موارد موجود با حفظ اطلاعات تماشا و تصاویر به‌روزرسانی خواهند شد."
                                   FontSize="11.5" Foreground="#94A3B8" LineHeight="18" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#151E2E" CornerRadius="0,0,19,19" Padding="20,14"
                    BorderBrush="#233044" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <materialDesign:PackIcon Kind="LockCheckOutline" Width="16" Height="16" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ساختار و یکپارچگی فایل تأیید شد" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Click="BtnCancel_Click" Content="انصراف" IsCancel="True"
                                Background="#1E293B" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12.5"
                                Padding="16,0" Height="38" Cursor="Hand" BorderThickness="1" BorderBrush="#334155" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Click="BtnConfirm_Click" IsDefault="True"
                                Background="#059669" Foreground="White" FontWeight="Bold" FontSize="13"
                                Padding="18,0" Height="38" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تأیید و شروع بازیابی" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

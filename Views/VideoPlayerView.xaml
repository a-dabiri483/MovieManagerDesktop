<UserControl x:Class="MovieManagerDesktop.Views.VideoPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Black">
    <Grid>
        <!-- The VLC Player View -->
        <vlc:VideoView MediaPlayer="{Binding MediaPlayer}" />

        <!-- Overlay Controls -->
        <Grid x:Name="ControlsGrid" Background="#88000000" VerticalAlignment="Bottom" Height="80">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Seek Slider -->
            <Slider Grid.Row="0" Margin="10,0"
                    Minimum="0" Maximum="1" 
                    Value="{Binding Position, Mode=TwoWay}"
                    ValueChanged="Slider_ValueChanged"
                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                    IsMoveToPointEnabled="True"
                    Style="{StaticResource MaterialDesignDiscreteSlider}"/>

            <!-- Bottom Control Bar -->
            <Grid Grid.Row="1" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Play/Pause Button -->
                <Button Grid.Column="0" Command="{Binding PlayPauseCommand}" Style="{StaticResource MaterialDesignIconButton}" Foreground="White">
                    <materialDesign:PackIcon Width="32" Height="32">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="Play" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Kind" Value="Pause" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Button>

                <!-- Stop Button -->
                <Button Grid.Column="1" Command="{Binding StopCommand}" Style="{StaticResource MaterialDesignIconButton}" Foreground="White">
                    <materialDesign:PackIcon Kind="Stop" Width="24" Height="24"/>
                </Button>

                <!-- Time Info -->
                <TextBlock Grid.Column="2" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14">
                    <Run Text="{Binding CurrentTimeDisplay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalTimeDisplay}"/>
                </TextBlock>

                <!-- Volume Control -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <materialDesign:PackIcon Kind="VolumeHigh" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" Width="100" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                </StackPanel>

                <!-- Go Back Button -->
                <Button Grid.Column="5" Command="{Binding GoBackCommand}" Style="{StaticResource MaterialDesignIconButton}" Foreground="White" ToolTip="بستن و بازگشت">
                    <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                </Button>
            </Grid>
        </Grid>

        <!-- Top Title Bar Overlay (Optional) -->
        <Border Background="#66000000" VerticalAlignment="Top" Height="40" Visibility="{Binding ElementName=ControlsGrid, Path=Visibility}">
            <TextBlock Text="{Binding Title}" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0" FontSize="16" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>

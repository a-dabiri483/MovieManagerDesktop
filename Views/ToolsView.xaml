<UserControl x:Class="MovieManagerDesktop.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:ToolsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,40,32,40" MaxWidth="1100">
            <!-- Header with Vertical Bar -->
            <StackPanel Orientation="Horizontal" Margin="6,0,0,8">
                <Border Width="4" Height="22" Background="{DynamicResource PrimaryColor}" CornerRadius="2" Margin="0,0,10,0"/>
                <TextBlock Text="ابزارهای سازمان‌دهی هوشمند" FontSize="22" FontWeight="Black" Foreground="White"/>
            </StackPanel>

            <TextBlock Text="ابزارهای حرفه‌ای برای مدیریت و سازمان‌دهی پوشه‌ها، اصلاح مسیر و فایل‌های فیلم و سریال" 
                       Foreground="{DynamicResource SecondaryText}" 
                       FontSize="13.5" 
                       Margin="14,0,0,28"/>

            <!-- Tool Cards Grid -->
            <UniformGrid Columns="3" Margin="0,0,0,20" VerticalAlignment="Top">
                
                <!-- Card 1: Folder Icon Generator -->
                <Border Margin="8" CornerRadius="18" Cursor="Hand"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource LightBorder}"
                        BorderThickness="1" Padding="20">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenFolderIconCommand}"/>
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundLight}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Icon -->
                        <Border Grid.Row="0" Width="56" Height="56" CornerRadius="16" 
                                Background="#25EB3B5A" HorizontalAlignment="Right" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="FolderImage" Width="28" Height="28" 
                                                     Foreground="{DynamicResource PrimaryColor}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Row="1" Text="ساخت آیکون پوشه" 
                                   FontSize="16.5" FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,8"/>

                        <!-- Description -->
                        <TextBlock Grid.Row="2" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="12.5" LineHeight="20">
                            پوستر فیلم یا سریال را روی یک قاب سه‌بعدی ترکیب کرده و آن را به عنوان آیکون پوشه ویندوز اعمال می‌کند.
                        </TextBlock>

                        <!-- Action hint -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="شروع ابزار" Foreground="{DynamicResource PrimaryColor}" FontWeight="Bold" FontSize="13"/>
                            <materialDesign:PackIcon Kind="ArrowLeft" Foreground="{DynamicResource PrimaryColor}" 
                                                     Width="16" Height="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: Name Cleaner -->
                <Border Margin="8" CornerRadius="18" Cursor="Hand"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource LightBorder}"
                        BorderThickness="1" Padding="20">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenNameCleanerCommand}"/>
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundLight}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource NetworkBlue}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Width="56" Height="56" CornerRadius="16" 
                                Background="#253867D6" HorizontalAlignment="Right" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="Broom" Width="28" Height="28" 
                                                     Foreground="{DynamicResource NetworkBlue}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Row="1" Text="تمیزکننده نام پوشه‌ها" 
                                   FontSize="16.5" FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="12.5" LineHeight="20">
                            نام‌های شلوغ پوشه‌ها (شامل رزولوشن، انکودر و کلمات اضافه) را اسکن کرده و به نام‌های تمیز تغییر می‌دهد.
                        </TextBlock>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="شروع ابزار" Foreground="{DynamicResource NetworkBlue}" FontWeight="Bold" FontSize="13"/>
                            <materialDesign:PackIcon Kind="ArrowLeft" Foreground="{DynamicResource NetworkBlue}" 
                                                     Width="16" Height="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 3: Series Organizer -->
                <Border Margin="8" CornerRadius="18" Cursor="Hand"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource LightBorder}"
                        BorderThickness="1" Padding="20">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenSeriesOrganizerCommand}"/>
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundLight}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource EmeraldAccent}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Width="56" Height="56" CornerRadius="16" 
                                Background="#2526DE81" HorizontalAlignment="Right" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="FolderSwapOutline" Width="28" Height="28" 
                                                     Foreground="{DynamicResource EmeraldAccent}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Row="1" Text="مرتب‌ساز سریال‌ها" 
                                   FontSize="16.5" FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="12.5" LineHeight="20">
                            قسمت‌های پراکنده‌ی سریال‌ها را بر اساس نامشان شناسایی و در پوشه‌ی مخصوص هر سریال قرار می‌دهد.
                        </TextBlock>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="شروع ابزار" Foreground="{DynamicResource EmeraldAccent}" FontWeight="Bold" FontSize="13"/>
                            <materialDesign:PackIcon Kind="ArrowLeft" Foreground="{DynamicResource EmeraldAccent}" 
                                                     Width="16" Height="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 4: Series Renamer -->
                <Border Margin="8" CornerRadius="18" Cursor="Hand"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource LightBorder}"
                        BorderThickness="1" Padding="20">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenSeriesFileRenamerCommand}"/>
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundLight}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PurpleAccent}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Width="56" Height="56" CornerRadius="16" 
                                Background="#258854D0" HorizontalAlignment="Right" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="RenameBox" Width="28" Height="28" 
                                                     Foreground="{DynamicResource PurpleAccent}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Row="1" Text="تغییر نام هوشمند" 
                                   FontSize="16.5" FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="12.5" LineHeight="20">
                            فایل‌های درهم‌ریخته سریال‌ها را شناسایی کرده و آن‌ها را بر اساس اطلاعات سرور تغییر نام می‌دهد.
                        </TextBlock>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="شروع ابزار" Foreground="{DynamicResource PurpleAccent}" FontWeight="Bold" FontSize="13"/>
                            <materialDesign:PackIcon Kind="ArrowLeft" Foreground="{DynamicResource PurpleAccent}" 
                                                     Width="16" Height="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 5: Auto Relocator -->
                <Border Margin="8" CornerRadius="18" Cursor="Hand"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource LightBorder}"
                        BorderThickness="1" Padding="20">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenAutoRelocatorCommand}"/>
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundLight}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource OrangeAccent}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Width="56" Height="56" CornerRadius="16" 
                                Background="#25FA8231" HorizontalAlignment="Right" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="LinkVariantPlus" Width="28" Height="28" 
                                                     Foreground="{DynamicResource OrangeAccent}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Row="1" Text="ترمیم هوشمند مسیر" 
                                   FontSize="16.5" FontWeight="Bold" 
                                   Foreground="White" 
                                   Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="12.5" LineHeight="20">
                            فایل‌های جابجاشده را پیدا کرده و مسیر آن‌ها را در دیتابیس بدون از دست رفتن اطلاعات، آپدیت می‌کند.
                        </TextBlock>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="شروع ابزار" Foreground="{DynamicResource OrangeAccent}" FontWeight="Bold" FontSize="13"/>
                            <materialDesign:PackIcon Kind="ArrowLeft" Foreground="{DynamicResource OrangeAccent}" 
                                                     Width="16" Height="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

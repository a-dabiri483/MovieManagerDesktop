<UserControl x:Class="MovieManagerDesktop.Views.CollectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
             xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
             xmlns:controls="clr-namespace:MovieManagerDesktop.Controls"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CollectionsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.ClearTypeHint="Enabled"
             RenderOptions.BitmapScalingMode="HighQuality">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="24,10,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: UNIFIED COMPACT CONTROL DECK & HEADER -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="16" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Padding="14,8" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Right in RTL: Title & Count -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Middle in RTL: Search Box -->
                    <ColumnDefinition Width="*"/>
                    <!-- Left in RTL: Actions -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Right: Title & Count Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="FolderMultipleOutline" Width="22" Height="22" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="مجموعه‌ها" FontSize="18" FontWeight="Black" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="#25EB3B5A" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Collections.Count, StringFormat='{}{0} مجموعه'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}"/>
                    </Border>
                </StackPanel>

                <!-- Middle: Search Box -->
                <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="16" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="12,0" Height="34" MaxWidth="300" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="جستجوی در مجموعه‌ها..." 
                                 Foreground="White" FontSize="12.5" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Left: Action Buttons (Sort & Size) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <!-- 1. Poster Size Button -->
                    <ToggleButton x:Name="SizeButton" Width="34" Height="34" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,6,0"
                                  ToolTip="تنظیم اندازه پوسترها" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent" CornerRadius="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FormatSize" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}"/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    
                    <!-- Poster Size Popup -->
                    <Popup IsOpen="{Binding IsChecked, ElementName=SizeButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=SizeButton}" Placement="Bottom">
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="14" Padding="14" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Margin="0,6,0,0" Width="240">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="اندازه نمایش پوستر:" Foreground="{DynamicResource SecondaryText}" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding PosterSize, StringFormat='{}{0}px'}" Foreground="{DynamicResource PrimaryColor}" FontSize="11.5" FontWeight="Black" HorizontalAlignment="Left"/>
                                </Grid>
                                <Slider Minimum="150" Maximum="350" Value="{Binding PosterSize}" Foreground="{DynamicResource PrimaryColor}"/>
                                <Button Command="{Binding ResetSizeCommand}" Content="اندازه پیش‌فرض" 
                                        Background="#15FFFFFF" BorderThickness="0" Foreground="{DynamicResource SecondaryText}" 
                                        Margin="0,10,0,0" Height="28" FontSize="11" materialDesign:ButtonAssist.CornerRadius="14"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- 2. Sort Button -->
                    <ToggleButton x:Name="FilterButton" Width="34" Height="34" Background="Transparent" BorderThickness="0" Padding="0"
                                  ToolTip="مرتب‌سازی" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent" CornerRadius="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="SortVariant" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}"/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    
                    <!-- Sort Popup -->
                    <Popup IsOpen="{Binding IsChecked, ElementName=FilterButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom">
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="14" Padding="14" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Margin="0,6,0,0" MinWidth="200">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="مرتب‌سازی بر اساس:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" FontSize="11" FontWeight="Bold"/>
                                <ComboBox SelectedIndex="{Binding SortIndex}" Foreground="White" Margin="0,0,0,10" Background="#15FFFFFF">
                                    <ComboBoxItem Content="حروف الفبا"/>
                                    <ComboBoxItem Content="تعداد عناوین"/>
                                </ComboBox>

                                <TextBlock Text="جهت مرتب‌سازی:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" FontSize="11" FontWeight="Bold"/>
                                <ComboBox SelectedIndex="{Binding SortDirectionIndex}" Foreground="White" Background="#15FFFFFF">
                                    <ComboBoxItem Content="نزولی"/>
                                    <ComboBoxItem Content="صعودی"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource PrimaryColor}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- ======================================================== -->
        <!-- ROW 1: COLLECTIONS POSTER GRID -->
        <!-- ======================================================== -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Collections}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" ScrollViewer.CanContentScroll="True" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="StartAndEndOnly" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!-- Collection Card Template (Modern Stacked Boxset Design) -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="{Binding DataContext.PosterSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="6,6,6,12">
                        
                        <!-- Card Container -->
                        <Button Style="{x:Null}" Background="Transparent" Padding="0" BorderThickness="0" Cursor="Hand"
                                Command="{Binding OpenCollectionMoviesCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="16" Padding="6" Background="#E60F172A" BorderBrush="#334155" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                                        </Border.Effect>

                            <StackPanel>
                                
                                <!-- Poster Image Box -->
                                <Grid Height="{Binding DataContext.PosterHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" ClipToBounds="True">
                                    
                                    <!-- Actual Poster Image with Bottom Gradient -->
                                    <Border CornerRadius="12" ClipToBounds="True" Background="#15FFFFFF">
                                        <Grid>
                                            <Image controls:CachedImage.SourceUrl="{Binding PosterUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            
                                            <!-- Dark Gradient Overlay at bottom of poster -->
                                            <Border VerticalAlignment="Bottom" Height="65">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="Transparent" Offset="0"/>
                                                        <GradientStop Color="#B0090E17" Offset="0.6"/>
                                                        <GradientStop Color="#F0090E17" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Top-Right in RTL: Collection Indicator Pill -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                            Background="#D90F172A" BorderBrush="#40334155" BorderThickness="1"
                                            CornerRadius="14" Width="28" Height="28"
                                            ToolTip="مجموعه فیلم">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.7" Color="Black"/>
                                        </Border.Effect>
                                        <materialDesign:PackIcon Kind="FolderMultipleOutline" Width="15" Height="15" Foreground="{DynamicResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Bottom-Inside-Poster Overlay: Movie Count Pill -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,6"
                                            Background="#D90F172A" BorderBrush="#40334155" BorderThickness="1"
                                            CornerRadius="8" Padding="8,3">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.7" Color="Black"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Filmstrip" Width="13" Height="13" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding MovieCount, StringFormat='{}{0} عنوان'}" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                </Grid>

                                <!-- Bottom Details (Below Poster) -->
                                <StackPanel Margin="2,6,2,2">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="White" 
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

<Window x:Class="MovieManagerDesktop.Views.DayDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:MovieManagerDesktop.Controls"
        Title="جزئیات انتشارهای روز" Width="680" Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Border Background="#111827" CornerRadius="16" BorderBrush="#384B66" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Color="Black" Opacity="0.75"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Modern Draggable Header -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="15,15,0,0" Padding="20,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0" Kind="CalendarMonth" Width="26" Height="26" 
                                             Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="SubtitleText" FontSize="12.5" Foreground="#94A3B8" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Single Sleek Close Button -->
                    <Button Grid.Column="2" Click="CloseButton_Click" 
                            Width="32" Height="32" Padding="0"
                            Style="{StaticResource MaterialDesignIconButton}" 
                            Foreground="#94A3B8" ToolTip="بستن">
                        <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Releases List Body -->
            <Grid Grid.Row="1" Margin="18">
                <!-- Scrollable Items -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ReleasesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Poster Thumbnail -->
                                        <Border Width="85" Height="128" CornerRadius="8" Margin="0,0,14,0" Background="#0F172A" ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PosterUrl}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image controls:CachedImage.SourceUrl="{Binding PosterUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        
                                        <!-- Fallback Icon when no poster -->
                                        <Border Grid.Column="0" Width="85" Height="128" CornerRadius="8" Margin="0,0,14,0" Background="#0F172A">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PosterUrl}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <materialDesign:PackIcon Kind="MovieOutline" Width="36" Height="36" Foreground="#94A3B8" 
                                                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- Content Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Title -->
                                                <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="Bold" Foreground="White" 
                                                           TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                
                                                <!-- Type Badge -->
                                                <Border Grid.Column="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Top">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#30F59E0B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MediaType}" Value="Series">
                                                                    <Setter Property="Background" Value="#3038BDF8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding MediaType}" Value="tv">
                                                                    <Setter Property="Background" Value="#3038BDF8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="فیلم سینمایی"/>
                                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MediaType}" Value="Series">
                                                                        <Setter Property="Text" Value="سریال"/>
                                                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding MediaType}" Value="tv">
                                                                        <Setter Property="Text" Value="سریال"/>
                                                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            
                                            <!-- Genres / Date -->
                                            <TextBlock Text="{Binding FormattedGenres}" FontSize="11.5" Foreground="#38BDF8" Margin="0,4,0,0"
                                                       Visibility="{Binding FormattedGenres, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>

                                            <!-- Overview -->
                                            <TextBlock Text="{Binding Overview}" FontSize="12.5" Foreground="#CBD5E1" 
                                                       TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="65" TextTrimming="CharacterEllipsis"/>
                                            
                                            <!-- Actions: Translate Button -->
                                            <Button Click="TranslateButton_Click" Tag="{Binding}" 
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                                                    Foreground="{DynamicResource PrimaryColor}" BorderBrush="{DynamicResource PrimaryColor}"
                                                    Height="28" Padding="8,0" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                    materialDesign:ButtonAssist.CornerRadius="6">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Translate" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="ترجمه خلاصه" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Empty State -->
                <TextBlock Text="هیچ عنوانی برای این روز یافت نشد." 
                           x:Name="EmptyText" Visibility="Collapsed"
                           Foreground="#94A3B8" FontSize="15" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>

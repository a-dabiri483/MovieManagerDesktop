<Window x:Class="MovieManagerDesktop.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Movie Manager"
        Width="860" Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Poster item style in wall -->
        <Style x:Key="WallPosterCard" TargetType="Border">
            <Setter Property="Width" Value="136"/>
            <Setter Property="Height" Value="198"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="4,5"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>
    </Window.Resources>

    <!-- Main Container with Window Drop Shadow -->
    <Grid x:Name="RootGrid" Opacity="0">
        <Border CornerRadius="28" ClipToBounds="True" Background="#08090E" BorderBrush="#35FFFFFF" BorderThickness="1.2" Margin="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.75" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <!-- ======================================================== -->
                <!-- 1. ANIMATED 6-COLUMN POSTER WALL (SCROLLING UPWARDS) -->
                <!-- ======================================================== -->
                <Grid ClipToBounds="True" Background="#08090E">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1 (Speed: 32s) -->
                    <StackPanel Grid.Column="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="Col1Transform"/>
                        </StackPanel.RenderTransform>
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Col1Transform" Storyboard.TargetProperty="Y"
                                                         From="0" To="-1218" Duration="0:0:32"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>
                        <!-- Items -->
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_breaking_bad.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_the_rookie.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_spider_man.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_one_piece.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_arcane.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_dark_knight.webp" Stretch="UniformToFill"/></Border>
                        <!-- Duplicated for Infinite Loop -->
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_breaking_bad.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_the_rookie.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_spider_man.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_one_piece.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_arcane.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_dark_knight.webp" Stretch="UniformToFill"/></Border>
                    </StackPanel>

                    <!-- Column 2 (Speed: 40s) -->
                    <StackPanel Grid.Column="1">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="Col2Transform"/>
                        </StackPanel.RenderTransform>
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Col2Transform" Storyboard.TargetProperty="Y"
                                                         From="0" To="-1218" Duration="0:0:40"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>
                        <!-- Items -->
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_game_of_thrones.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_the_flash.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_rick_and_morty.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_naruto.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_supernatural.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_big_bang.webp" Stretch="UniformToFill"/></Border>
                        <!-- Duplicated for Infinite Loop -->
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_game_of_thrones.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_the_flash.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_rick_and_morty.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_naruto.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_supernatural.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_big_bang.webp" Stretch="UniformToFill"/></Border>
                    </StackPanel>

                    <!-- Column 3 (Speed: 35s) -->
                    <StackPanel Grid.Column="2">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="Col3Transform"/>
                        </StackPanel.RenderTransform>
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Col3Transform" Storyboard.TargetProperty="Y"
                                                         From="0" To="-1218" Duration="0:0:35"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>
                        <!-- Items -->
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_avengers.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_venom.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_simpsons.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_black_clover.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_prison_break.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_inception.webp" Stretch="UniformToFill"/></Border>
                        <!-- Duplicated for Infinite Loop -->
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_avengers.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_venom.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_simpsons.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_black_clover.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_prison_break.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_inception.webp" Stretch="UniformToFill"/></Border>
                    </StackPanel>

                    <!-- Column 4 (Speed: 44s) -->
                    <StackPanel Grid.Column="3">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="Col4Transform"/>
                        </StackPanel.RenderTransform>
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Col4Transform" Storyboard.TargetProperty="Y"
                                                         From="0" To="-1218" Duration="0:0:44"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>
                        <!-- Items -->
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_interstellar.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_avatar.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_vikings.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_the_boys.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_oppenheimer.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_peaky_blinders.webp" Stretch="UniformToFill"/></Border>
                        <!-- Duplicated for Infinite Loop -->
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_interstellar.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_avatar.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_vikings.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_the_boys.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_oppenheimer.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_peaky_blinders.webp" Stretch="UniformToFill"/></Border>
                    </StackPanel>

                    <!-- Column 5 (Speed: 36s) -->
                    <StackPanel Grid.Column="4">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="Col5Transform"/>
                        </StackPanel.RenderTransform>
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Col5Transform" Storyboard.TargetProperty="Y"
                                                         From="0" To="-1218" Duration="0:0:36"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>
                        <!-- Items -->
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_money_heist.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_dune.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_stranger_things.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_matrix.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_better_call_saul.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_fight_club.webp" Stretch="UniformToFill"/></Border>
                        <!-- Duplicated for Infinite Loop -->
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_money_heist.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_dune.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_stranger_things.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_matrix.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_better_call_saul.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_fight_club.webp" Stretch="UniformToFill"/></Border>
                    </StackPanel>

                    <!-- Column 6 (Speed: 42s) -->
                    <StackPanel Grid.Column="5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="Col6Transform"/>
                        </StackPanel.RenderTransform>
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Col6Transform" Storyboard.TargetProperty="Y"
                                                         From="0" To="-1218" Duration="0:0:42"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>
                        <!-- Items -->
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_lucifer.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_harry_potter.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_house_of_dragon.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_lord_of_rings.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_sherlock.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_death_note.webp" Stretch="UniformToFill"/></Border>
                        <!-- Duplicated for Infinite Loop -->
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_lucifer.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_harry_potter.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_house_of_dragon.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_lord_of_rings.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_sherlock.webp" Stretch="UniformToFill"/></Border>
                        <Border Style="{StaticResource WallPosterCard}"><Image Source="/Assets/Posters/poster_death_note.webp" Stretch="UniformToFill"/></Border>
                    </StackPanel>
                </Grid>

                <!-- ======================================================== -->
                <!-- 2. CINEMATIC GRADIENT OVERLAYS & CENTER HALO -->
                <!-- ======================================================== -->
                <!-- Ambient Dark Tint -->
                <Border Background="#4508090E"/>

                <!-- Top & Bottom Vignettes -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#F008090E" Offset="0"/>
                            <GradientStop Color="#3008090E" Offset="0.25"/>
                            <GradientStop Color="#0008090E" Offset="0.5"/>
                            <GradientStop Color="#4008090E" Offset="0.75"/>
                            <GradientStop Color="#F508090E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Center Radial Halo for Crystal-Clear Typography Contrast -->
                <Border Width="500" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Background>
                        <RadialGradientBrush RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
                            <GradientStop Color="#F808090E" Offset="0"/>
                            <GradientStop Color="#DD08090E" Offset="0.55"/>
                            <GradientStop Color="#4008090E" Offset="0.85"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ======================================================== -->
                <!-- 3. CENTER BRANDING, LOGO & STATUS -->
                <!-- ======================================================== -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- Glowing App Logo -->
                        <Border Width="92" Height="92" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#EB3B5A" Opacity="0.85"/>
                            </Border.Effect>
                            <Image Source="/Assets/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <!-- Title: Movie Manager (with Pink/Red Glow) -->
                        <TextBlock Text="Movie Manager" FontSize="36" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#FFA8B6" Offset="0.6"/>
                                    <GradientStop Color="#EB3B5A" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.9" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Persian Subtitle in Glass Pill -->
                        <Border Background="#E60F172A" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16" Padding="20,6" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.6" Color="#000000"/>
                            </Border.Effect>
                            <TextBlock Text="مدیریت هوشمند فیلم و سریال" Foreground="#F1F5F9" FontSize="13.5" FontWeight="Bold"/>
                        </Border>

                        <!-- Bottom Loading Progress & Status Text -->
                        <StackPanel HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="140" Height="3.5" Margin="0,0,0,10"
                                         Foreground="#EB3B5A" Background="#30FFFFFF" BorderThickness="0"/>
                            <TextBlock Text="در حال آماده‌سازی و راه‌اندازی..." Foreground="#94A3B8" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="MovieManagerDesktop.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Movie Manager"
        Width="540" Height="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="RootGrid" Opacity="0">
        <!-- Card -->
        <Border CornerRadius="18" ClipToBounds="True" Margin="12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B0C18" Offset="0"/>
                    <GradientStop Color="#111328" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2E3460" Offset="0"/>
                    <GradientStop Color="#1C1F3A" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness>1.2</Thickness>
            </Border.BorderThickness>

            <Grid>
                <!-- Subtle top-right warm glow -->
                <Ellipse Width="260" Height="180" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-50,-40,0" IsHitTestVisible="False" Opacity="0.6">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#20EB3B5A" Offset="0"/>
                            <GradientStop Color="#00EB3B5A" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Subtle bottom-left cool glow -->
                <Ellipse Width="220" Height="150" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="-30,0,0,-30" IsHitTestVisible="False" Opacity="0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#187C5AD0" Offset="0"/>
                            <GradientStop Color="#007C5AD0" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Main Content -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <!-- Logo -->
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           Width="110" Height="110"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>

                    <!-- Title -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="MOVIE" FontSize="30" FontWeight="Black" Foreground="White"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="MANAGER" FontSize="30" FontWeight="Black" Foreground="#EB3B5A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Thin Red Accent Line -->
                    <Border Height="2" Width="160" CornerRadius="1" Margin="0,0,0,24" HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#EB3B5A" Offset="0.3"/>
                                <GradientStop Color="#EB3B5A" Offset="0.7"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Progress Bar -->
                    <ProgressBar IsIndeterminate="True" Width="200" Height="3"
                                 Foreground="#EB3B5A" Background="#18FFFFFF" BorderThickness="0"
                                 Margin="0,0,0,10" HorizontalAlignment="Center"/>

                    <!-- Persian Status -->
                    <TextBlock Text="در حال بارگذاری..."
                               FlowDirection="RightToLeft"
                               Foreground="#6B7394" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

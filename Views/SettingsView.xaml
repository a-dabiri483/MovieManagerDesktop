<UserControl x:Class="MovieManagerDesktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             d:DesignHeight="850" d:DesignWidth="1000"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <!-- Android Settings Group Card Style -->
        <Style x:Key="SettingsGroupCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings Row Style -->
        <Style x:Key="SettingsRowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,14"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,20,32,40" MaxWidth="880">

            <!-- Top Header (Android Back + Title) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Command="{Binding GoBackCommand}" 
                        Background="{DynamicResource CardBackground}" BorderThickness="1" BorderBrush="{DynamicResource LightBorder}"
                        Foreground="White" Width="44" Height="44" Margin="0,0,16,0" 
                        ToolTip="بازگشت" materialDesign:ButtonAssist.CornerRadius="22" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ArrowRight" Width="24" Height="24"/>
                </Button>
                
                <TextBlock Grid.Column="1" Text="شخصی‌سازی و تنظیمات" FontSize="22" FontWeight="Black" Foreground="White" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- 1. بخش ظاهر برنامه (Android Theme Settings) -->
            <StackPanel Margin="0,0,0,4">
                <!-- Section Header with Vertical Bar -->
                <StackPanel Orientation="Horizontal" Margin="6,0,0,12">
                    <Border Width="4" Height="18" Background="{DynamicResource PrimaryColor}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="ظاهر برنامه" FontSize="16.5" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupCard}">
                    <StackPanel>
                        <!-- تم برنامه (تاریک / روشن) -->
                        <Border Style="{StaticResource SettingsRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Purple Moon Icon on Right -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14" Background="#258854D0" Margin="0,0,14,0">
                                    <materialDesign:PackIcon Kind="MoonWaxingCrescent" Width="22" Height="22" Foreground="{DynamicResource PurpleAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="تم برنامه" FontSize="14.5" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="حالت نمایش تاریک (Dark Mode) یا روشن" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="تاریک" IsChecked="{Binding IsDarkTheme}" Foreground="White" Margin="0,0,12,0"/>
                                    <RadioButton Content="روشن" IsChecked="{Binding IsLightTheme}" Foreground="White"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Separator Background="{DynamicResource LightBorder}" Margin="0,4"/>

                        <!-- زبان برنامه -->
                        <Border Style="{StaticResource SettingsRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Blue Globe Icon -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14" Background="#253867D6" Margin="0,0,14,0">
                                    <materialDesign:PackIcon Kind="Web" Width="22" Height="22" Foreground="{DynamicResource NetworkBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="زبان (Language)" FontSize="14.5" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="زبان رابط کاربری نرم‌افزار" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="فارسی" IsChecked="{Binding IsPersianLanguage}" Foreground="White" Margin="0,0,12,0"/>
                                    <RadioButton Content="English" IsChecked="{Binding IsEnglishLanguage}" Foreground="White"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Separator Background="{DynamicResource LightBorder}" Margin="0,4"/>

                        <!-- فرمت تقویم -->
                        <Border Style="{StaticResource SettingsRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Red Calendar Icon -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14" Background="#25EB3B5A" Margin="0,0,14,0">
                                    <materialDesign:PackIcon Kind="CalendarMonth" Width="22" Height="22" Foreground="{DynamicResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="فرمت تقویم و تاریخ" FontSize="14.5" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="نمایش تاریخ‌ها به صورت شمسی یا میلادی" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="هجری شمسی (جلالی)" Foreground="{DynamicResource PrimaryColor}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 2. بخش محتوا و ترجمه (Android Content Settings) -->
            <StackPanel Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="6,0,0,12">
                    <Border Width="4" Height="18" Background="{DynamicResource PurpleAccent}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="محتوا و متادیتا" FontSize="16.5" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupCard}">
                    <StackPanel>
                        <!-- منبع دیتابیس TMDb / OMDb -->
                        <Border Style="{StaticResource SettingsRowBorder}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14" Background="#25FA8231" Margin="0,0,14,0">
                                        <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="22" Height="22" Foreground="{DynamicResource OrangeAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="منبع دریافت اطلاعات فیلم و سریال" FontSize="14.5" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="انتخاب سرور دریافت اطلاعات و پوسترها" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Content="TMDb" IsChecked="{Binding IsTmdbSelected}" Foreground="White" Margin="0,0,10,0"/>
                                        <RadioButton Content="OMDb" IsChecked="{Binding IsOmdbSelected}" Foreground="White"/>
                                    </StackPanel>
                                </Grid>

                                <!-- TMDB API Key Input -->
                                <Border Background="#10FFFFFF" CornerRadius="12" Padding="14,8" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewTmdbKey, UpdateSourceTrigger=PropertyChanged}" 
                                                 materialDesign:HintAssist.Hint="کلید اختصاصی TMDb API..." 
                                                 Foreground="White" FontSize="13" BorderThickness="0" Background="Transparent"
                                                 FlowDirection="LeftToRight" HorizontalContentAlignment="Left" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Command="{Binding AddTmdbKeyCommand}" 
                                                Background="{DynamicResource PrimaryColor}" Foreground="White" BorderThickness="0"
                                                Height="32" Padding="14,0" materialDesign:ButtonAssist.CornerRadius="8">
                                            <TextBlock Text="ثبت کلید" FontSize="12" FontWeight="Bold"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. بخش ضد فیلتر و پروکسی (Android Anti-Filter) -->
            <StackPanel Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="6,0,0,12">
                    <Border Width="4" Height="18" Background="{DynamicResource TealAccent}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="ضد تحریم و پروکسی" FontSize="16.5" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupCard}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14" Background="#250FB9B1" Margin="0,0,14,0">
                                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="22" Height="22" Foreground="{DynamicResource TealAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="سرویس ضد تحریم TMDb" FontSize="14.5" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="دور زدن فیلترینگ و تحریم‌های ارتباط با TMDb" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="2" IsChecked="{Binding IsApiProxyEnabled}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 4. پایگاه داده و پشتیبان‌گیری -->
            <StackPanel Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="6,0,0,12">
                    <Border Width="4" Height="18" Background="{DynamicResource EmeraldAccent}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="پایگاه داده و پشتیبان‌گیری" FontSize="16.5" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupCard}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14" Background="#2526DE81" Margin="0,0,14,0">
                                    <materialDesign:PackIcon Kind="DatabaseOutline" Width="22" Height="22" Foreground="{DynamicResource EmeraldAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="پشتیبان‌گیری از کتابخانه" FontSize="14.5" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="ایجاد فایل پشتیبان از تمام اطلاعات و تاریخچه" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding BackupDatabaseCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{DynamicResource EmeraldAccent}" BorderBrush="{DynamicResource EmeraldAccent}" materialDesign:ButtonAssist.CornerRadius="10" Height="36">
                                    <TextBlock Text="بکاپ‌گیری" FontSize="12.5" FontWeight="Bold"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>

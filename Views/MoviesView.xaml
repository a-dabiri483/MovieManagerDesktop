<UserControl x:Class="MovieManagerDesktop.Views.MoviesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
             xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
             xmlns:controls="clr-namespace:MovieManagerDesktop.Controls"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d"  
             d:DataContext="{d:DesignInstance Type=viewmodels:MoviesViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft"
             Loaded="MoviesView_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:SeriesStatusConverter x:Key="SeriesStatusConverter"/>
        <converters:SeriesStatusColorConverter x:Key="SeriesStatusColorConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="Esc" Command="{Binding ExitSelectionModeCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshSelectedCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="30,45,30,0" PreviewMouseWheel="Grid_PreviewMouseWheel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header, Search, Action Bar, and Filters -->
        <Grid Grid.Row="0" Margin="0,0,0,15" Height="45">
            <!-- Normal Mode -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="IsHitTestVisible" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInSelectionMode}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource TextH2}" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <!-- Search Box (Android Cinema Style) -->
                <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="14,0" MaxWidth="380" HorizontalAlignment="Left" BorderBrush="{DynamicResource NormalBorder}" BorderThickness="1" VerticalAlignment="Center" Height="40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox IsEditable="True"
                                  Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                  ItemsSource="{Binding SearchHistory}"
                                  materialDesign:HintAssist.Hint="جستجو در فیلم‌ها، سریال‌ها و بازیگران..." 
                                  materialDesign:TextFieldAssist.HasClearButton="True"
                                  Foreground="{DynamicResource PrimaryText}" FontSize="13.5" BorderThickness="0"
                                  VerticalAlignment="Center">
                            <ComboBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SaveSearchHistoryCommand}"/>
                                <KeyBinding Key="Enter" Command="{Binding SaveSearchHistoryCommand}"/>
                            </ComboBox.InputBindings>
                        </ComboBox>
                        <materialDesign:PackIcon Grid.Column="1" Kind="Magnify" Width="20" Height="20" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Action buttons: Sort, Filter, Size reset -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="FilterButton" Visibility="{Binding ShowFilters, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource PrimaryColor}" ToolTip="فیلترها" Padding="12,0" Height="36" materialDesign:ButtonAssist.CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilterVariant" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="فیلترها" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ToggleButton>
                    
                    <Popup IsOpen="{Binding IsChecked, ElementName=FilterButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom">
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="18" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Margin="0,8,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="Black"/>
                            </Border.Effect>
                            <StackPanel MinWidth="170">
                                <TextBlock Text="ترتیب نمایش:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" FontSize="11" FontWeight="Bold"/>
                                <ComboBox SelectedIndex="{Binding SortIndex}" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="تاریخ افزودن"/>
                                    <ComboBoxItem Content="نام"/>
                                    <ComboBoxItem Content="سال تولید"/>
                                    <ComboBoxItem Content="امتیاز"/>
                                </ComboBox>

                                <TextBlock Text="جهت مرتب‌سازی:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" FontSize="11" FontWeight="Bold"/>
                                <ComboBox SelectedIndex="{Binding SortDirectionIndex}" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="نزولی"/>
                                    <ComboBoxItem Content="صعودی"/>
                                </ComboBox>
                                
                                <TextBlock Text="ژانر:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" FontSize="11" FontWeight="Bold"/>
                                <ComboBox ItemsSource="{Binding Genres}" SelectedIndex="{Binding SelectedGenreIndex}" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10" />

                                <TextBlock Text="نوع محتوا:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" FontSize="11" FontWeight="Bold"/>
                                <ComboBox SelectedIndex="{Binding MediaTypeFilterIndex}" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="همه" />
                                    <ComboBoxItem Content="فیلم‌ها" />
                                    <ComboBoxItem Content="سریال‌ها" />
                                </ComboBox>

                                <TextBlock Text="وضعیت تماشا:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" FontSize="11" FontWeight="Bold"/>
                                <ComboBox SelectedIndex="{Binding WatchedFilterIndex}" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="همه" />
                                    <ComboBoxItem Content="دیده شده" />
                                    <ComboBoxItem Content="دیده نشده" />
                                </ComboBox>

                                <TextBlock Text="لیست و دسته‌بندی:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" FontSize="11" FontWeight="Bold"/>
                                <ComboBox SelectedIndex="{Binding ListFilterIndex}" Foreground="{DynamicResource PrimaryText}">
                                    <ComboBoxItem Content="همه" />
                                    <ComboBoxItem Content="علاقه‌مندی‌ها" />
                                    <ComboBoxItem Content="لیست تماشا" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <ToggleButton x:Name="SizeButton" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource SecondaryText}" ToolTip="تغییر سایز پوستر" Padding="10,0" Height="36" Margin="8,0,0,0" materialDesign:ButtonAssist.CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ImageSizeSelectActual" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="اندازه" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ToggleButton>
                    
                    <Popup IsOpen="{Binding IsChecked, ElementName=SizeButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=SizeButton}" Placement="Bottom">
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Margin="0,8,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="تنظیم اندازه پوسترها:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" FontSize="11" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ImageSizeSelectSmall" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider Minimum="150" Maximum="350" Value="{Binding PosterSize}" Width="150" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryColor}"/>
                                    <materialDesign:PackIcon Kind="ImageSizeSelectLarge" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Button Command="{Binding ResetSizeCommand}" Content="اندازه پیش‌فرض" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource PrimaryColor}" Margin="0,12,0,0" FontSize="12" materialDesign:ButtonAssist.CornerRadius="8"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <!-- Selection Action Bar Layer (Android Batch Bar) -->
            <Border Background="{DynamicResource CardBackground}" CornerRadius="14" Padding="18,0" BorderBrush="{DynamicResource PrimaryColor}" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" Color="#E50914"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInSelectionMode}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="True"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding ExitSelectionModeCommand}" Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="{DynamicResource SecondaryText}" Width="32" Height="32" ToolTip="خروج (Esc)">
                        <materialDesign:PackIcon Kind="Close"/>
                    </Button>

                    <TextBlock Grid.Column="1" Text="{Binding SelectedCount, StringFormat='{}{0} مورد انتخاب شد'}" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding SelectAllCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource PrimaryColor}" Content="انتخاب همه" ToolTip="انتخاب همه (Ctrl+A)" Margin="0,0,8,0" FontWeight="Bold"/>
                        
                        <Button Command="{Binding ToggleFavoritesSelectedCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#FF3B47" ToolTip="تغییر وضعیت علاقه‌مندی‌ها" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HeartOutline" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="علاقه‌مندی" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ToggleWatchedSelectedCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource SuccessColor}" ToolTip="تغییر وضعیت مشاهده" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="EyeCheckOutline" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="مشاهده شده" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RefreshSelectedCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource WarningColor}" ToolTip="بروزرسانی متادیتا (F5)" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="به‌روزرسانی" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding DeleteSelectedCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource ErrorColor}" ToolTip="حذف از آرشیو (Delete)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="حذف" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Quick Filters Chips (Android Cinema Style with Counts) -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16" Visibility="{Binding ShowFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style x:Key="AndroidFilterChipStyle" TargetType="RadioButton">
                        <Setter Property="GroupName" Value="QuickFilterGroup"/>
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Margin" Value="0,0,10,0"/>
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="18" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <!-- 1. همه -->
                <RadioButton Style="{StaticResource AndroidFilterChipStyle}" IsChecked="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="همه" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Background="#30000000" CornerRadius="10" Padding="7,1">
                            <TextBlock Text="{Binding Movies.Count}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </RadioButton>

                <!-- 2. فیلم‌ها -->
                <RadioButton Style="{StaticResource AndroidFilterChipStyle}" IsChecked="{Binding IsQuickFilterMovies}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="فیلم‌ها" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                
                <!-- 3. سریال‌ها -->
                <RadioButton Style="{StaticResource AndroidFilterChipStyle}" IsChecked="{Binding IsQuickFilterSeries}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="سریال‌ها" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- 4. تماشا نشده -->
                <RadioButton Style="{StaticResource AndroidFilterChipStyle}" IsChecked="{Binding IsQuickFilterUnwatched}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="تماشا نشده" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </ScrollViewer>

        <!-- Progress bar for batch refresh -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="4" VerticalAlignment="Bottom" Background="Transparent" Foreground="{DynamicResource PrimaryColor}" Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Movies Grid -->
        <Grid Grid.Row="2">
            <!-- Skeleton Loading Placeholders -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{DynamicResource {x:Type ScrollViewer}}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <WrapPanel Margin="0,0,-20,0">
                    <controls:ShimmerEffect Width="{Binding PosterSize}" Height="{Binding PosterHeight}" Margin="10,10,20,30" CornerRadius="16"/>
                    <controls:ShimmerEffect Width="{Binding PosterSize}" Height="{Binding PosterHeight}" Margin="10,10,20,30" CornerRadius="16"/>
                    <controls:ShimmerEffect Width="{Binding PosterSize}" Height="{Binding PosterHeight}" Margin="10,10,20,30" CornerRadius="16"/>
                    <controls:ShimmerEffect Width="{Binding PosterSize}" Height="{Binding PosterHeight}" Margin="10,10,20,30" CornerRadius="16"/>
                    <controls:ShimmerEffect Width="{Binding PosterSize}" Height="{Binding PosterHeight}" Margin="10,10,20,30" CornerRadius="16"/>
                    <controls:ShimmerEffect Width="{Binding PosterSize}" Height="{Binding PosterHeight}" Margin="10,10,20,30" CornerRadius="16"/>
                </WrapPanel>
            </ScrollViewer>

            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoMovies}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                
                <materialDesign:PackIcon Kind="FilmstripBoxMultiple" Width="100" Height="100" Foreground="{DynamicResource DisabledText}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="هنوز فیلمی اضافه نکرده‌اید!" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="برای شروع، پوشه فیلم‌های خود را اسکن کنید" FontSize="14" Foreground="{DynamicResource DisabledText}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                
                <Button Content="شروع اسکن" Command="{Binding GoToScanCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource PrimaryColor}" Foreground="White" 
                        Width="180" Height="42" FontSize="15" materialDesign:ButtonAssist.CornerRadius="12"
                        HorizontalAlignment="Center">
                    <Button.Effect>
                        <DropShadowEffect Color="#EB3B5A" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                    </Button.Effect>
                </Button>
            </StackPanel>

            <!-- Actual Content ListBox -->
            <ListBox x:Name="MoviesItemsControl" ItemsSource="{Binding Movies}" SelectionMode="Extended" SelectionChanged="MoviesItemsControl_SelectionChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" ScrollViewer.CanContentScroll="True" Background="Transparent" BorderThickness="0" PreviewKeyDown="MoviesItemsControl_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="FocusBorder" BorderThickness="2" BorderBrush="Transparent" CornerRadius="18" Margin="2" Padding="0">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                            <Setter TargetName="FocusBorder" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#EB3B5A" Opacity="0.5"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="StartAndEndOnly" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="{Binding DataContext.PosterSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,8,8,18" CacheMode="BitmapCache">
                            
                            <!-- Main Poster Card (Android Cinema Style with Always-Visible Title and Badges) -->
                            <Border x:Name="posterCard" Background="{DynamicResource CardBackground}" CornerRadius="18" ClipToBounds="True" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="Black"/>
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundLight}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top: Poster Image Container -->
                                    <Grid Grid.Row="0" Height="{Binding DataContext.PosterHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <!-- Poster Image -->
                                        <Border Background="#1A1D36">
                                            <Image controls:CachedImage.SourceUrl="{Binding File.PosterUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <!-- Top-Left Gold Rating Pill (★ 8.3) -->
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#CC0A0B16" CornerRadius="8" Padding="6,3" Margin="8" Panel.ZIndex="3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding File.Rating, TargetNullValue='0.0'}" Foreground="#FFD700" FontWeight="Black" FontSize="11.5" Margin="0,0,4,0"/>
                                                <materialDesign:PackIcon Kind="Star" Foreground="#FFD700" VerticalAlignment="Center" Width="12" Height="12"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Top-Right Actions (Favorite & 3-Dots Menu) -->
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8" Panel.ZIndex="5">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Favorite Button -->
                                                <Border Background="#B00A0B16" CornerRadius="12" Width="26" Height="26" Margin="0,0,4,0">
                                                    <Button Command="{Binding ToggleFavoriteCommand}" Style="{StaticResource MaterialDesignIconForegroundButton}" Width="26" Height="26" Padding="0">
                                                        <materialDesign:PackIcon Kind="Heart" Foreground="{Binding FavoriteIconForeground}" Width="14" Height="14"/>
                                                    </Button>
                                                </Border>

                                                <!-- 3-Dots Menu -->
                                                <Border Background="#B00A0B16" CornerRadius="12" Width="26" Height="26">
                                                    <materialDesign:PackIcon Kind="DotsVertical" Foreground="White" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Bottom: Card Details Area (ALWAYS VISIBLE - Android Layout) -->
                                    <Border Grid.Row="1" Padding="10,10,10,12" Background="{DynamicResource CardBackground}">
                                        <StackPanel>
                                            <!-- Title (Bold White) -->
                                            <TextBlock Text="{Binding File.FormattedTitle, TargetNullValue='عنوان فیلم/سریال'}" Foreground="White" FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                                            <!-- Badges Row: Year, Dubbed/Sub, Type -->
                                            <WrapPanel Orientation="Horizontal">
                                                <!-- Media Type Pill (Series / Movie) -->
                                                <Border CornerRadius="5" Padding="6,2" Margin="0,0,4,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#253867D6"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding File.MediaType}" Value="Series">
                                                                    <Setter Property="Background" Value="#258854D0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding File.MediaType, Converter={StaticResource SeriesStatusConverter}}" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#3867D6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding File.MediaType}" Value="Series">
                                                                        <Setter Property="Foreground" Value="#A55EEA"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Dubbed Pill -->
                                                <Border Background="#250FB9B1" CornerRadius="5" Padding="6,2" Margin="0,0,4,0">
                                                    <TextBlock Text="دوبله" Foreground="#0FB9B1" FontSize="11" FontWeight="Bold"/>
                                                </Border>

                                                <!-- Year Badge -->
                                                <Border Background="#15FFFFFF" CornerRadius="5" Padding="6,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding File.Year, TargetNullValue='1400'}" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,0,3,0"/>
                                                        <materialDesign:PackIcon Kind="CalendarBlankOutline" Foreground="{DynamicResource SecondaryText}" Width="10" Height="10" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- Bulk Action Progress Overlay -->
            <Border Background="#CC000000" VerticalAlignment="Bottom" Padding="20" Visibility="{Binding IsBulkActionRunning, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="50">
                <Grid MaxWidth="400" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding BulkActionText}" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ProgressBar Value="{Binding BulkActionProgress}" Height="8" Minimum="0" Maximum="100" 
                                     Foreground="{DynamicResource PrimaryColor}" Background="{DynamicResource MainBackground}" BorderThickness="0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding CancelBulkActionCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#FF5252" BorderBrush="#FF5252" Content="لغو" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>


<UserControl x:Class="MovieManagerDesktop.Views.MoviesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
             xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
             xmlns:controls="clr-namespace:MovieManagerDesktop.Controls"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d"  
             d:DataContext="{d:DesignInstance Type=viewmodels:MoviesViewModel}"
             d:DesignHeight="900" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.ClearTypeHint="Enabled"
             RenderOptions.BitmapScalingMode="HighQuality"
             Loaded="MoviesView_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:RadioIntEqualsConverter x:Key="RadioIntEqualsConverter"/>

        <!-- Segmented Tab Pill RadioButton Style -->
        <Style x:Key="AndroidTabPillRadioStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="CategoryTabGroup"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pillBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sub-filter Watch Status Pill Style -->
        <Style x:Key="AndroidSubFilterPillStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="WatchSubFilterGroup"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="subBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="subBorder" Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
                                <Setter TargetName="subBorder" Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="subBorder" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="Esc" Command="{Binding ExitSelectionModeCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshSelectedCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24,10,24,0" PreviewMouseWheel="Grid_PreviewMouseWheel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: UNIFIED COMPACT CONTROL DECK & HEADER -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            
            <!-- Normal Header State -->
            <Border Visibility="{Binding IsInSelectionMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                    Background="{DynamicResource CardBackground}" CornerRadius="16" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Padding="12,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Right Column in RTL: Category Tabs -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Middle Column in RTL: Search Box -->
                        <ColumnDefinition Width="*"/>
                        <!-- Left Column in RTL: Watch Sub-Filters & Actions -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Right Column: Category Tabs -->
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            
                            <!-- 1. همه -->
                            <RadioButton Style="{StaticResource AndroidTabPillRadioStyle}" 
                                         IsChecked="{Binding SelectedCategoryTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=0}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="همه" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Background="#30000000" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding AllCount}" FontSize="10.5" FontWeight="Black" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. فیلم‌ها -->
                            <RadioButton Style="{StaticResource AndroidTabPillRadioStyle}"
                                         IsChecked="{Binding SelectedCategoryTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=1}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="فیلم‌ها" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Background="#30000000" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding MoviesCount}" FontSize="10.5" FontWeight="Black" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>

                            <!-- 3. سریال‌ها -->
                            <RadioButton Style="{StaticResource AndroidTabPillRadioStyle}"
                                         IsChecked="{Binding SelectedCategoryTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=2}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="سریال‌ها" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Background="#30000000" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding SeriesCount}" FontSize="10.5" FontWeight="Black" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>

                            <!-- 4. علاقه‌مندی‌ها -->
                            <RadioButton Style="{StaticResource AndroidTabPillRadioStyle}"
                                         IsChecked="{Binding SelectedCategoryTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=3}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="علاقه‌مندی‌ها" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Background="#30000000" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding FavoritesCount}" FontSize="10.5" FontWeight="Black" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>

                            <!-- 5. دسته‌بندی‌ها -->
                            <RadioButton Style="{StaticResource AndroidTabPillRadioStyle}"
                                         IsChecked="{Binding SelectedCategoryTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=4}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="دسته‌بندی‌ها" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Background="#30000000" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding CategoriesCount}" FontSize="10.5" FontWeight="Black" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Middle Column: Search Box -->
                    <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="16" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="10,0" Height="34" MaxWidth="260" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:HintAssist.Hint="جستجو..." 
                                     Foreground="White" FontSize="12.5" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Left Column: Watch Sub-Filters & Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <!-- Watch Sub-filters: همه / تماشا شده / تماشا نشده -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                    Visibility="{Binding IsWatchSubFilterVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <RadioButton Style="{StaticResource AndroidSubFilterPillStyle}"
                                         IsChecked="{Binding SelectedWatchTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=0}">
                                <TextBlock Text="همه" VerticalAlignment="Center"/>
                            </RadioButton>

                            <RadioButton Style="{StaticResource AndroidSubFilterPillStyle}"
                                         IsChecked="{Binding SelectedWatchTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=1}">
                                <TextBlock Text="تماشا شده" VerticalAlignment="Center"/>
                            </RadioButton>

                            <RadioButton Style="{StaticResource AndroidSubFilterPillStyle}"
                                         IsChecked="{Binding SelectedWatchTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=2}">
                                <TextBlock Text="تماشا نشده" VerticalAlignment="Center"/>
                            </RadioButton>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="#20FFFFFF" Margin="0,0,6,0"/>

                        <!-- 1. Eye / Show Hidden Toggle Button -->
                        <Button Command="{Binding ToggleShowHiddenCommand}" 
                                Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0" Margin="0,0,4,0"
                                ToolTip="حالت مخفی (نمایش موارد قفل‌شده)" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid>
                                            <materialDesign:PackIcon Kind="Eye" Width="20" Height="20" Foreground="{DynamicResource PrimaryColor}" 
                                                                     Visibility="{Binding DataContext.ShowHiddenItems, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <materialDesign:PackIcon Kind="EyeOffOutline" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}" 
                                                                     Visibility="{Binding DataContext.ShowHiddenItems, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 2. Poster Size Button -->
                        <ToggleButton x:Name="PosterSizeButton" Width="32" Height="32" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,4,0"
                                      ToolTip="تنظیم اندازه پوسترها" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FormatSize" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Poster Size Slider Dropdown Popup -->
                        <Popup IsOpen="{Binding IsChecked, ElementName=PosterSizeButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=PosterSizeButton}" Placement="Bottom">
                            <Border Background="{DynamicResource CardBackground}" CornerRadius="14" Padding="14" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Margin="0,6,0,0" Width="240">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="اندازه نمایش پوستر:" Foreground="{DynamicResource SecondaryText}" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding PosterSize, StringFormat='{}{0}px'}" Foreground="{DynamicResource PrimaryColor}" FontSize="11.5" FontWeight="Black" HorizontalAlignment="Left"/>
                                    </Grid>
                                    <Slider Minimum="150" Maximum="350" Value="{Binding PosterSize}" Foreground="{DynamicResource PrimaryColor}"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- 3. Sort & Filter Button -->
                        <ToggleButton x:Name="FilterButton" Width="32" Height="32" Background="Transparent" BorderThickness="0" Padding="0"
                                      ToolTip="مرتب‌سازی و فیلترها" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="SortVariant" Width="20" Height="20" Foreground="{DynamicResource SecondaryText}"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Sort & Filter Dropdown Popup -->
                        <Popup IsOpen="{Binding IsChecked, ElementName=FilterButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom">
                            <Border Background="{DynamicResource CardBackground}" CornerRadius="14" Padding="14" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Margin="0,6,0,0" MinWidth="220">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="مرتب‌سازی بر اساس:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" FontSize="11" FontWeight="Bold"/>
                                    <ComboBox SelectedIndex="{Binding SortIndex}" Foreground="White" Margin="0,0,0,10" Background="#15FFFFFF">
                                        <ComboBoxItem Content="تاریخ افزودن"/>
                                        <ComboBoxItem Content="نام فیلم/سریال"/>
                                        <ComboBoxItem Content="سال ساخت"/>
                                        <ComboBoxItem Content="امتیاز"/>
                                    </ComboBox>

                                    <TextBlock Text="جهت مرتب‌سازی:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" FontSize="11" FontWeight="Bold"/>
                                    <ComboBox SelectedIndex="{Binding SortDirectionIndex}" Foreground="White" Margin="0,0,0,10" Background="#15FFFFFF">
                                        <ComboBoxItem Content="نزولی"/>
                                        <ComboBoxItem Content="صعودی"/>
                                    </ComboBox>
                                    
                                    <TextBlock Text="ژانر:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4" FontSize="11" FontWeight="Bold"/>
                                    <ComboBox ItemsSource="{Binding Genres}" SelectedIndex="{Binding SelectedGenreIndex}" Foreground="White" Background="#15FFFFFF"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Selection Mode Action Bar (Top Bulk Bar activated on right-click) -->
            <Border Background="{DynamicResource CardBackground}" CornerRadius="16" Padding="16,6" BorderBrush="{DynamicResource PrimaryColor}" BorderThickness="1.5"
                    MinHeight="54"
                    Visibility="{Binding IsInSelectionMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.6" Color="#EB3B5A"/>
                </Border.Effect>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding ExitSelectionModeCommand}" 
                            Background="#20FFFFFF" BorderThickness="0" Width="34" Height="34" Padding="0" 
                            materialDesign:ButtonAssist.CornerRadius="17" Foreground="White" ToolTip="خروج از حالت انتخاب (Esc)" Cursor="Hand"
                            VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <TextBlock Grid.Column="1" Text="{Binding SelectedCount, StringFormat='{}{0} مورد انتخاب شد'}" Foreground="White" FontSize="14" FontWeight="Black" VerticalAlignment="Center" Margin="12,0,0,0"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- انتخاب همه -->
                        <Button Command="{Binding SelectAllCommand}" 
                                Background="#25EB3B5A" BorderThickness="0" Foreground="{DynamicResource PrimaryColor}"
                                Height="34" Padding="14,0" materialDesign:ButtonAssist.CornerRadius="10"
                                Content="انتخاب همه" Margin="0,0,8,0" FontWeight="Black" FontSize="12" Cursor="Hand"
                                VerticalAlignment="Center"/>
                        
                        <!-- برچسب‌ها -->
                        <Button Command="{Binding OpenManageTagsForSelectedCommand}" 
                                Background="#2000B894" BorderThickness="0" Foreground="{DynamicResource TealAccent}"
                                Width="34" Height="34" Padding="0" materialDesign:ButtonAssist.CornerRadius="10"
                                ToolTip="مدیریت برچسب‌ها" Margin="0,0,6,0" Cursor="Hand"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="TagOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- علاقه‌مندی -->
                        <Button Command="{Binding ToggleFavoritesSelectedCommand}" 
                                Background="#20FF3B47" BorderThickness="0" Foreground="#FF3B47"
                                Width="34" Height="34" Padding="0" materialDesign:ButtonAssist.CornerRadius="10"
                                ToolTip="افزودن به علاقه‌مندی‌ها" Margin="0,0,6,0" Cursor="Hand"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="HeartOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- مشاهده شده -->
                        <Button Command="{Binding ToggleWatchedSelectedCommand}" 
                                Background="#2026DE81" BorderThickness="0" Foreground="{DynamicResource EmeraldAccent}"
                                Width="34" Height="34" Padding="0" materialDesign:ButtonAssist.CornerRadius="10"
                                ToolTip="تغییر وضعیت مشاهده" Margin="0,0,6,0" Cursor="Hand"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="EyeCheckOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- مخفی‌سازی -->
                        <Button Command="{Binding ToggleHiddenSelectedCommand}" 
                                Background="#208854D0" BorderThickness="0" Foreground="{DynamicResource PurpleAccent}"
                                Width="34" Height="34" Padding="0" materialDesign:ButtonAssist.CornerRadius="10"
                                ToolTip="مخفی‌سازی / قفل" Margin="0,0,6,0" Cursor="Hand"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="LockOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- بروزرسانی (F5) -->
                        <Button Command="{Binding RefreshSelectedCommand}" 
                                Background="#20FFD32A" BorderThickness="0" Foreground="{DynamicResource GoldColor}"
                                Width="34" Height="34" Padding="0" materialDesign:ButtonAssist.CornerRadius="10"
                                ToolTip="به‌روزرسانی آنلاین (F5)" Margin="0,0,6,0" Cursor="Hand"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- حذف -->
                        <Button Command="{Binding DeleteSelectedCommand}" 
                                Background="#30EB3B5A" BorderThickness="0" Foreground="{DynamicResource PrimaryColor}"
                                Width="34" Height="34" Padding="0" materialDesign:ButtonAssist.CornerRadius="10"
                                ToolTip="حذف از آرشیو" Cursor="Hand"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- ROW 1: CONTENT AREA -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1">
            
            <!-- Skeleton Shimmer Loading -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <WrapPanel Margin="0,0,-16,0">
                    <controls:ShimmerEffect Width="{Binding PosterSize}" Height="{Binding PosterHeight}" Margin="6,6,12,16" CornerRadius="16"/>
                    <controls:ShimmerEffect Width="{Binding PosterSize}" Height="{Binding PosterHeight}" Margin="6,6,12,16" CornerRadius="16"/>
                    <controls:ShimmerEffect Width="{Binding PosterSize}" Height="{Binding PosterHeight}" Margin="6,6,12,16" CornerRadius="16"/>
                    <controls:ShimmerEffect Width="{Binding PosterSize}" Height="{Binding PosterHeight}" Margin="6,6,12,16" CornerRadius="16"/>
                </WrapPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- CATEGORIES / CUSTOM TAGS VIEW (When Tab 4 is selected & No Tag Filter) -->
            <!-- ======================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedCategoryTabIndex}" Value="4"/>
                                    <Condition Binding="{Binding SelectedCustomTag}" Value="{x:Null}"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Empty State for Categories -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CustomTags.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                    <materialDesign:PackIcon Kind="TagMultipleOutline" Width="80" Height="80" Foreground="{DynamicResource DisabledText}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="هنوز برچسبی ایجاد نشده است" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="روی فیلم‌ها یا سریال‌ها کلیک راست کنید تا برچسب دلخواه بسازید و اینجا دسته‌بندی شوند." 
                               FontSize="13.5" Foreground="{DynamicResource DisabledText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="450"/>
                </StackPanel>

                <!-- Tags Grid -->
                <ListBox ItemsSource="{Binding CustomTags}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="StartAndEndOnly"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackground}" CornerRadius="16" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" 
                                    Width="260" Height="110" Margin="6,6,6,12" Padding="12" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectCustomTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Name}"/>
                                </Border.InputBindings>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Tag Info -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <materialDesign:PackIcon Kind="TagOutline" Width="18" Height="18" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Black" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Background="#25EB3B5A" CornerRadius="8" Padding="8,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Count, StringFormat='{}{0} مورد'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Poster Backdrop Thumbnail -->
                                    <Border Grid.Column="1" Width="64" Height="84" CornerRadius="10" ClipToBounds="True" Background="#15FFFFFF" Margin="8,0,0,0">
                                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ======================================================== -->
            <!-- MAIN POSTER GRID VIEW -->
            <!-- ======================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedCategoryTabIndex}" Value="4"/>
                                    <Condition Binding="{Binding SelectedCustomTag}" Value="{x:Null}"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Empty State for Media -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoMovies}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                    <materialDesign:PackIcon Kind="MovieFilterOutline" Width="90" Height="90" Foreground="{DynamicResource DisabledText}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="هیچ فیلم یا سریالی یافت نشد!" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="برای شروع، پوشه فیلم‌ها و سریال‌های خود را پویش کنید" FontSize="13.5" Foreground="{DynamicResource DisabledText}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    
                    <Button Content="شروع پویش و اسکن" Command="{Binding GoToScanCommand}"
                            Background="{DynamicResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0"
                            Width="190" Height="42" FontSize="14.5" FontWeight="Bold" materialDesign:ButtonAssist.CornerRadius="12"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Main Poster Grid with Dynamic VirtualizingWrapPanel Item Dimensions -->
                <ListBox x:Name="MoviesItemsControl" ItemsSource="{Binding Movies}" 
                         SelectionMode="Extended" SelectionChanged="MoviesItemsControl_SelectionChanged" 
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" 
                         ScrollViewer.CanContentScroll="True" Background="Transparent" BorderThickness="0" 
                         PreviewKeyDown="MoviesItemsControl_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="StartAndEndOnly"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!-- Poster Card Template (Enhanced Modern Design Inspired by Dream to You, Allied, Toy Story) -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding DataContext.PosterSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="6,6,6,12">
                                
                                <!-- Card Container -->
                                <Border CornerRadius="16" Padding="6" Cursor="Hand" Background="#E60F172A" BorderBrush="#334155" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="#25EB3B5A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.CardClickedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <MouseBinding Gesture="RightClick" Command="{Binding DataContext.ToggleSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                                    </Border.Effect>

                                    <StackPanel>
                                        
                                        <!-- Poster Image Box -->
                                        <Grid Height="{Binding DataContext.PosterHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" ClipToBounds="True">
                                            
                                            <!-- Actual Poster Image with Bottom Gradient -->
                                            <Border CornerRadius="12" ClipToBounds="True" Background="#15FFFFFF">
                                                <Grid>
                                                    <Image Source="{Binding File.PosterUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    
                                                    <!-- Dark Gradient Overlay at bottom of poster (for clear text contrast) -->
                                                    <Border VerticalAlignment="Bottom" Height="65">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="Transparent" Offset="0"/>
                                                                <GradientStop Color="#B0090E17" Offset="0.6"/>
                                                                <GradientStop Color="#F0090E17" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Top-Right in RTL (Top Corner): Dubbing & Subtitle Badges (Floating Dark Glass Circles) -->
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                                                <!-- Dubbed (Neon Green Mic) -->
                                                <Border Visibility="{Binding HasDubbing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Background="#D90F172A" BorderBrush="#40334155" BorderThickness="1"
                                                        CornerRadius="14" Width="28" Height="28" Margin="0,0,0,5"
                                                        ToolTip="دارای دوبله فارسی">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.7" Color="Black"/>
                                                    </Border.Effect>
                                                    <materialDesign:PackIcon Kind="Microphone" Width="15" Height="15" Foreground="#00E676" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Subtitle (Yellow CC) -->
                                                <Border Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Background="#D90F172A" BorderBrush="#40334155" BorderThickness="1"
                                                        CornerRadius="14" Width="28" Height="28"
                                                        ToolTip="دارای زیرنویس فارسی">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.7" Color="Black"/>
                                                    </Border.Effect>
                                                    <materialDesign:PackIcon Kind="ClosedCaption" Width="15" Height="15" Foreground="#FFD166" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Top-Left in RTL: IMDb Rating Capsule (Green border / gold star score) -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"
                                                    Background="#D90F172A" CornerRadius="12" Padding="7,3" BorderBrush="#40334155" BorderThickness="1"
                                                    Visibility="{Binding HasRating, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.7" Color="Black"/>
                                                </Border.Effect>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Star" Width="13" Height="13" Foreground="#FFD166" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding RatingFormatted}" Foreground="#4ADE80" FontSize="11.5" FontWeight="Black" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Top-Left Hidden Lock Badge (Only if marked hidden and no rating) -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8"
                                                    Background="#D90F172A" CornerRadius="10" Padding="6,3" BorderBrush="#40EB3B5A" BorderThickness="0.8"
                                                    Visibility="{Binding IsHidden, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Lock" Width="12" Height="12" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock Text="مخفی" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bottom-Inside-Poster Overlay (Like Allied reference): Year & Type -->
                                            <DockPanel VerticalAlignment="Bottom" Margin="8,0,8,6">
                                                <!-- Year with Calendar Icon on Right -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="CalendarOutline" Width="12" Height="12" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock Text="{Binding DisplayYear}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Type Badge on Left (فیلم / سریال) -->
                                                <Border DockPanel.Dock="Left" Background="{Binding TypeBadgeBg}" BorderBrush="{Binding TypeBadgeBorder}" BorderThickness="0.8" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding TypeBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding TypeBadgeFg}"/>
                                                </Border>
                                            </DockPanel>

                                            <!-- Selection Checkbox Overlay -->
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{DynamicResource PrimaryColor}" CornerRadius="16" Width="32" Height="32"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <materialDesign:PackIcon Kind="Check" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                        </Grid>

                                        <!-- Bottom Details (Below Poster) -->
                                        <StackPanel Margin="2,6,2,2">
                                            
                                            <!-- Title (Persian / Formatted) -->
                                            <TextBlock Text="{Binding File.FormattedTitle}" FontSize="13" FontWeight="Bold" Foreground="White" 
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextAlignment="Center"/>

                                            <!-- Last Played / Progress for series -->
                                            <TextBlock Text="{Binding LastPlayedText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" 
                                                       HorizontalAlignment="Center" Margin="0,2,0,0" 
                                                       Visibility="{Binding LastPlayedText, Converter={StaticResource NullToVisibilityConverter}}"/>

                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>

        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL DIALOG: MANAGE TAGS / CATEGORIES -->
        <!-- ======================================================== -->
        <Grid Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsManageTagsDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource CardBackground}" CornerRadius="20" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1.5"
                    Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.7" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="🏷️ مدیریت برچسب‌ها و دسته‌بندی‌ها" FontSize="16" FontWeight="Black" Foreground="White" HorizontalAlignment="Right"/>
                        <Button Command="{Binding CloseTagsDialogCommand}" Background="Transparent" BorderThickness="0" Width="28" Height="28" Padding="0" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="Close" Foreground="{DynamicResource SecondaryText}"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding CurrentMediaForTags.File.FormattedTitle, StringFormat='{}فیلم/سریال: {0}'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" Margin="0,0,0,14"/>

                    <TextBlock Text="برچسب‌ها را با کاما (,) از هم جدا کنید:" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding TagsInputText, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="مثال: فیلم‌های برتر، خانوادگی، مهیج..."
                             Foreground="White" FontSize="14" Padding="12,10" Background="#15FFFFFF" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="ذخیره برچسب‌ها" Command="{Binding SaveTagsCommand}"
                                Background="{DynamicResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0"
                                Height="38" Padding="20,0" FontWeight="Bold" materialDesign:ButtonAssist.CornerRadius="10" Margin="0,0,10,0"/>
                        <Button Content="انصراف" Command="{Binding CloseTagsDialogCommand}"
                                Background="#15FFFFFF" Foreground="{DynamicResource SecondaryText}" BorderThickness="0"
                                Height="38" Padding="16,0" materialDesign:ButtonAssist.CornerRadius="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL DIALOG: BULK ACTION / REFRESH CIRCULAR PROGRESS -->
        <!-- ======================================================== -->
        <Grid Grid.RowSpan="4" Background="#90000000" Visibility="{Binding IsBulkActionRunning, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource CardBackground}" CornerRadius="22" BorderBrush="{DynamicResource PrimaryColor}" BorderThickness="1.5"
                    Width="420" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.8" Color="Black"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    
                    <!-- Header Icon & Title -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="RefreshAuto" Width="24" Height="24" Foreground="{DynamicResource GoldColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="به‌روزرسانی اطلاعات از TMDb" FontSize="16" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Circular Progress Indicator with Center Percentage -->
                    <Grid Width="130" Height="130" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <!-- Background track circle -->
                        <ProgressBar Value="100" Maximum="100" 
                                     Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                     Width="120" Height="120" 
                                     Foreground="#18FFFFFF" BorderThickness="0"/>
                        
                        <!-- Active Progress circle -->
                        <ProgressBar Value="{Binding BulkActionProgress}" Maximum="100" 
                                     Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                     Width="120" Height="120" 
                                     Foreground="{DynamicResource PrimaryColor}"/>

                        <!-- Centered Count & Percent Info -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding BulkActionPercentText}" FontSize="22" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding BulkActionCountText}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Current File / Progress Description -->
                    <TextBlock Text="{Binding BulkActionText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" 
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" Margin="0,0,0,22"/>

                    <!-- Cancel Button -->
                    <Button Content="انصراف و توقف" Command="{Binding CancelBulkActionCommand}"
                            Background="#25EB3B5A" Foreground="{DynamicResource PrimaryColor}" BorderBrush="#50EB3B5A" BorderThickness="1"
                            Height="40" Padding="26,0" FontWeight="Bold" FontSize="13" materialDesign:ButtonAssist.CornerRadius="12"
                            HorizontalAlignment="Center" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>

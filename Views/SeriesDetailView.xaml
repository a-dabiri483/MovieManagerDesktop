<UserControl x:Class="MovieManagerDesktop.Views.SeriesDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
             xmlns:controls="clr-namespace:MovieManagerDesktop.Controls"
             Background="{DynamicResource Background}"
             FlowDirection="RightToLeft"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.ClearTypeHint="Enabled"
             RenderOptions.BitmapScalingMode="HighQuality">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:SeriesStatusConverter x:Key="SeriesStatusConverter" />
        <converters:SeasonNameConverter x:Key="SeasonNameConverter" />
    </UserControl.Resources>

    <Grid Margin="0,40,0,0">
        <!-- Loading Overlay -->
        <ProgressBar IsIndeterminate="True" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Width="40" Height="40" Style="{StaticResource MaterialDesignCircularProgressBar}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Hero Section -->
                <Grid Height="350">
                    <Image controls:CachedImage.SourceUrl="{Binding Series.BackdropUrl}" 
                           Stretch="UniformToFill" />
                    
                    <!-- Gradient Overlay -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#400A0B16" Offset="0"/>
                                <GradientStop Color="#D00A0B16" Offset="0.65"/>
                                <GradientStop Color="#FF0A0B16" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,40,20,20">
                        <Button Command="{Binding GoBackCommand}" 
                                Background="#80000000" BorderThickness="0" 
                                Foreground="White" Width="50" Height="50"
                                materialDesign:ButtonAssist.CornerRadius="25">
                            <materialDesign:PackIcon Kind="ArrowRight" Width="30" Height="30"/>
                        </Button>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,40,20,20">
                        <!-- Favorite Button -->
                        <Button Command="{Binding ToggleFavoriteCommand}" 
                                Background="#80000000" BorderThickness="0"
                                Foreground="White" Width="50" Height="50" Padding="0" Margin="0,0,10,0"
                                materialDesign:ButtonAssist.CornerRadius="25"
                                ToolTip="افزودن/حذف از علاقه‌مندی‌ها">
                            <materialDesign:PackIcon Kind="{Binding FavoriteIconKind}" Width="24" Height="24" Foreground="{Binding FavoriteIconColor}"/>
                        </Button>
                        
                        <!-- Operations Menu -->
                        <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                                  StaysOpen="False"
                                                  ToolTip="عملیات بیشتر">
                            <materialDesign:PopupBox.ToggleContent>
                                <Border Background="#80000000" Width="50" Height="50" CornerRadius="25">
                                    <materialDesign:PackIcon Kind="DotsVertical" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </materialDesign:PopupBox.ToggleContent>
                            <StackPanel MinWidth="220">
                                <Button Command="{Binding RefreshSeriesCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                        HorizontalContentAlignment="Right" Padding="15,10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="بروز رسانی" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ChangePosterCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                        HorizontalContentAlignment="Right" Padding="15,10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ImageEdit" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="دریافت مجدد پوستر" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RefreshTrackerCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                        HorizontalContentAlignment="Right" Padding="15,10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Radar" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="دریافت اطلاعات ردیاب" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </StackPanel>
                                </Button>
                                <Separator/>
                                <Button Command="{Binding DeleteSeriesCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                        HorizontalContentAlignment="Right" Padding="15,10" Foreground="#FF5252">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="حذف سریال" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:PopupBox>
                    </StackPanel>

                    <Grid VerticalAlignment="Bottom" Margin="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="8" ClipToBounds="True" Width="140" Height="210" BorderThickness="2" BorderBrush="#55FFFFFF" Margin="0,0,20,0">
                            <Image controls:CachedImage.SourceUrl="{Binding Series.PosterUrl}" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Series.FormattedTitle}" FontSize="36" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Star" Foreground="#FFD700" VerticalAlignment="Center" Width="18" Height="18" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Series.Rating, StringFormat={}{0:F1}}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Calendar" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Width="18" Height="18" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding FormattedYear}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="MovieOutline" Foreground="{DynamicResource PurpleAccent}" VerticalAlignment="Center" Width="18" Height="18" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding FormattedGenres}" Foreground="{DynamicResource PurpleAccent}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel HorizontalAlignment="Center" Margin="30,80" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="80" Height="80" Foreground="{DynamicResource ErrorColor}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorColor}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <!-- Series Tracker Section -->
                <Border Background="{DynamicResource CardBackground}" 
                        CornerRadius="16" 
                        Padding="20" 
                        Margin="30,0,30,20"
                        BorderBrush="{DynamicResource NormalBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="TelevisionClassic" 
                                                         Width="22" Height="22" 
                                                         Foreground="{DynamicResource PrimaryColor}" 
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0"/>
                                <TextBlock Text="اطلاعات پخش سریال" 
                                           Foreground="{DynamicResource PrimaryText}" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Status Badge -->
                            <Border Background="#1A4CAF50" 
                                    CornerRadius="14" 
                                    Padding="10,5" 
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding SeriesStatusColor}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding SeriesStatusText}" 
                                               Foreground="{Binding SeriesStatusColor}"
                                               FontSize="13" 
                                               FontWeight="SemiBold" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <Separator Background="{DynamicResource NormalBorder}" Margin="0,0,0,15"/>
                        
                        <!-- Info Grid (2 Columns x 3 Rows matching design) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Row 0: First Air Date & Last Air Date -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                                <Border Background="#1A00E5FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="20" Height="20" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="شروع پخش" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                    <TextBlock Text="{Binding FirstAirDateText}" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                                <Border Background="#1A00E5FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CalendarCheckOutline" Width="20" Height="20" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="پایان پخش" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                    <TextBlock Text="{Binding LastAirDateText}" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Row 1: Network & Air Schedule -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                                <Border Background="#1A00E5FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Television" Width="20" Height="20" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="شبکه / استودیو" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                    <TextBlock Text="{Binding NetworkText}" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                                <Border Background="#1A00E5FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="برنامه پخش" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                    <TextBlock Text="{Binding AirScheduleText}" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Row 2: Next Episode & Total Counts -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1AEB3B5A" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="SkipNextCircleOutline" Width="20" Height="20" Foreground="#EB3B5A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="قسمت بعدی" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                    <TextBlock Text="{Binding NextEpisodeText}" Foreground="#EB3B5A" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1A00E5FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FormatListNumbered" Width="20" Height="20" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="تعداد قسمت‌ها" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                    <TextBlock Text="{Binding EpisodesInfoText, Converter={StaticResource PersianNumberConverter}}" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Big Gradient Continue Watching CTA Button -->
                <Button Command="{Binding ContinueWatchingCommand}" 
                        Margin="30,0,30,16" Height="48"
                        Visibility="{Binding CanContinueWatching, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Cursor="Hand"
                        materialDesign:ButtonAssist.CornerRadius="14">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="14" Padding="20,0" Height="48">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#FF3366" Offset="0"/>
                                        <GradientStop Color="#EB3B5A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Play" Width="22" Height="22" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding ContinueWatchingText}" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Watched Progress Section -->
                <Border Background="{DynamicResource CardBackground}" 
                        CornerRadius="14" 
                        Padding="18,14" 
                        Margin="30,0,30,24" 
                        BorderBrush="{DynamicResource NormalBorder}" 
                        BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding ProgressPercentText}" 
                                       DockPanel.Dock="Left" 
                                       Foreground="#EB3B5A" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding WatchedProgressSummaryText}" 
                                       Foreground="{DynamicResource PrimaryText}" 
                                       FontWeight="SemiBold" 
                                       FontSize="13" 
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <ProgressBar Minimum="0" Maximum="100" 
                                     Value="{Binding OverallProgressPercent}" 
                                     Height="6" 
                                     Foreground="#EB3B5A" 
                                     Background="#1E2338" 
                                     BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- Seasons and Episodes (Accordion / Collapsible) -->
                <ItemsControl ItemsSource="{Binding Seasons}" Margin="30,0,30,40">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <!-- Collapsible Season Header Card -->
                                <Border Background="{DynamicResource CardBackground}" 
                                        CornerRadius="12" 
                                        Padding="14,10" 
                                        Margin="0,0,0,8" 
                                        BorderBrush="{DynamicResource NormalBorder}" 
                                        BorderThickness="1" 
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                      Command="{Binding DataContext.ToggleSeasonExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <DockPanel>
                                        <!-- Left in RTL: Chevron Arrow -->
                                        <Border DockPanel.Dock="Left" VerticalAlignment="Center" Width="32" Height="32">
                                            <materialDesign:PackIcon Kind="{Binding ChevronIconKind}" 
                                                                     Width="22" Height="22" 
                                                                     Foreground="{DynamicResource SecondaryText}" 
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Right in RTL: S1 Badge with Red/Coral Line -->
                                        <Border DockPanel.Dock="Right" Background="#1C2237" CornerRadius="8" Padding="12,6" Margin="0,0,14,0" VerticalAlignment="Center" MinWidth="44">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding SeasonTag}" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                                <Border Height="2.5" Width="20" Background="#EB3B5A" CornerRadius="1" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Middle in RTL: Season Title and Progress Count -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SeasonTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                            <TextBlock Text="{Binding WatchedSummaryText}" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Expanded Season Content (Episode Cards) -->
                                <ItemsControl ItemsSource="{Binding Episodes}" 
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackground}" 
                                                    CornerRadius="10" 
                                                    Margin="0,0,0,8" 
                                                    Padding="14,10" 
                                                    BorderThickness="1" 
                                                    BorderBrush="{DynamicResource NormalBorder}">
                                                <DockPanel VerticalAlignment="Center">
                                                    <!-- Right in RTL: Checkbox for Watched Status -->
                                                    <Button DockPanel.Dock="Right" 
                                                            Command="{Binding DataContext.ToggleEpisodeWatchedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,14,0" 
                                                            Cursor="Hand" VerticalAlignment="Center"
                                                            ToolTip="علامت‌گذاری به عنوان دیده شده">
                                                        <Border Width="24" Height="24" CornerRadius="5">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#181E2E"/>
                                                                    <Setter Property="BorderBrush" Value="#475569"/>
                                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                                                            <Setter Property="Background" Value="#EB3B5A"/>
                                                                            <Setter Property="BorderBrush" Value="#EB3B5A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="White" 
                                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                     Visibility="{Binding IsWatched, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Border>
                                                    </Button>

                                                    <!-- Left in RTL: Circular Play Button -->
                                                    <Button DockPanel.Dock="Left" 
                                                            Command="{Binding DataContext.PlayEpisodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#25EB3B5A" BorderBrush="#40EB3B5A" BorderThickness="1"
                                                            Width="38" Height="38" Padding="0" Cursor="Hand"
                                                            materialDesign:ButtonAssist.CornerRadius="19"
                                                            ToolTip="پخش این قسمت">
                                                        <materialDesign:PackIcon Kind="Play" Width="18" Height="18" Foreground="#EB3B5A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>

                                                    <!-- Middle in RTL: Title & Episode Badges -->
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding DisplayTitle}" 
                                                                   FontSize="14" FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource PrimaryText}" 
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Background="#1C243B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding EpisodeTag}" Foreground="#A5B4FC" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI"/>
                                                            </Border>
                                                            <Border Background="#132B38" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding HasDubbing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="دوبله" FontSize="10" Foreground="#00E5FF" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <Border Background="#2C1A3B" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding HasSubtitle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="زیرنویس" FontSize="10" Foreground="#E056FD" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding AirDateFormatted}" FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

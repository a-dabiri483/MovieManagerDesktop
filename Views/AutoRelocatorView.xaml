<UserControl x:Class="MovieManagerDesktop.Views.AutoRelocatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:AutoRelocatorViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{DynamicResource MainBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorder}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource NormalBorder}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource NormalBorder}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorder}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,60,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Controls -->
            <RowDefinition Height="Auto"/> <!-- Progress -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="LinkVariantPlus" Width="28" Height="28" Foreground="{DynamicResource InfoColor}" Margin="0,0,10,0"/>
                    <TextBlock Text="ترمیم مسیرهای گمشده" Style="{StaticResource TextH2}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Margin="38,5,0,0"
                           Text="اگر فایل‌های شما جابجا شده‌اند، در اینجا می‌توانید مسیر جدید را به برنامه معرفی کنید تا بدون از دست رفتن اطلاعات، وصله شوند."
                           Foreground="{DynamicResource SecondaryText}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Controls (Row 1) -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" 
                BorderBrush="{DynamicResource NormalBorder}" BorderThickness="1" 
                CornerRadius="8" Padding="15" Margin="0,15,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Text="{Binding TargetDirectory, Mode=OneWay}"
                             IsReadOnly="True"
                             materialDesign:HintAssist.Hint="پوشه یا درایو مقصد (جایی که فایل‌ها به آنجا منتقل شده‌اند)..."
                             Foreground="{DynamicResource PrimaryText}" 
                             FontSize="13" 
                             Width="450"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>
                    <Button Command="{Binding SelectTargetDirectoryCommand}"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="{DynamicResource SecondaryText}"
                            ToolTip="انتخاب پوشه یا درایو جدید"
                            Width="30" Height="30" Padding="0" Margin="0,0,5,0">
                        <materialDesign:PackIcon Kind="FolderSearch"/>
                    </Button>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding ScanAndRelocateCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource SuccessColor}" Foreground="#050510" Margin="15,0,0,0" Width="140">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DatabaseSearch" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="شروع ترمیم" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Command="{Binding ApplyFixesCommand}" 
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource InfoColor}" Foreground="#050510" Margin="15,0,0,0" Width="140">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckAll" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="اعمال و ذخیره" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Progress (Row 2) -->
        <ProgressBar Grid.Row="2" IsIndeterminate="{Binding IsScanning}" 
                     Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Height="4" Margin="0,0,0,10" Foreground="{DynamicResource SuccessColor}"/>

        <!-- DataGrid (Row 3) -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding BrokenItems}" 
                  HeadersVisibility="Column" 
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  Foreground="{DynamicResource PrimaryText}">
            <DataGrid.Columns>
                <!-- Title -->
                <DataGridTextColumn Header="نام مدیا" Binding="{Binding Title}" Width="250" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Type -->
                <DataGridTextColumn Header="نوع" Binding="{Binding MediaType}" Width="80" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Old Path -->
                <DataGridTextColumn Header="مسیر قبلی (گمشده)" Binding="{Binding OldFilePath}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <!-- New Path -->
                <DataGridTextColumn Header="مسیر جدید (پیدا شده)" Binding="{Binding NewFilePath}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Status -->
                <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="150" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

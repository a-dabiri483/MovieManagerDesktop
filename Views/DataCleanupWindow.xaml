<Window x:Class="MovieManagerDesktop.Views.DataCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="مدیریت و پاکسازی حافظه"
        Width="590"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False">

    <Border Background="#F50F172A" CornerRadius="20" BorderBrush="#40EF4444" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="4" Color="Black" Opacity="0.85"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Body -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="19,19,0,0" Padding="18,14"
                    BorderBrush="#334155" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="24" Height="24" Foreground="#EF4444" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="مدیریت و پاکسازی حافظه" FontSize="14.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Click="BtnCancel_Click" HorizontalAlignment="Left"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            Width="30" Height="30" Cursor="Hand" Padding="0">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <StackPanel Grid.Row="1" Margin="22,16,22,14">
                <!-- Subtitle / Instruction -->
                <TextBlock Text="بخش‌های مورد نظر جهت حذف و آزادسازی فضای هارد دیسک را مشخص کنید:" 
                           FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="2,0,0,12"/>

                <!-- Options List -->
                <StackPanel>
                    <!-- 1. Database Option -->
                    <Border Background="#161F30" CornerRadius="12" BorderBrush="#25354C" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding CleanDatabase}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DatabaseRemove" Width="17" Height="17" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="پایگاه داده (فیلم‌ها، سریال‌ها و فصل‌ها)" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="عناوین شناسایی‌شده حذف و دیتابیس به زیر ۱۰۰ کیلوبایت کوچک‌سازی (Vacuum) می‌شود." 
                                           FontSize="11" Foreground="#94A3B8" Margin="23,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#261E2E" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DatabaseSizeFormatted}" FontSize="11.5" Foreground="#FCA5A5" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 2. Images Directory Option -->
                    <Border Background="#161F30" CornerRadius="12" BorderBrush="#25354C" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding CleanImages}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ImageMultipleOutline" Width="17" Height="17" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="پوشه تصاویر و پوسترهای اصلی (Images)" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="تمام فایل‌های کاور، پوستر و بک‌دراپ دانلودشده از پوشه اختصاصی هارد حذف می‌شوند." 
                                           FontSize="11" Foreground="#94A3B8" Margin="23,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#2E241E" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ImagesSizeFormatted}" FontSize="11.5" Foreground="#FCD34D" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 3. ImageCache Option -->
                    <Border Background="#161F30" CornerRadius="12" BorderBrush="#25354C" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding CleanImageCache}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cached" Width="17" Height="17" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="حافظه موقت تصاویر (ImageCache)" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="کش موقت و تامبنیل‌های اینترنتی پاکسازی می‌شوند." 
                                           FontSize="11" Foreground="#94A3B8" Margin="23,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#16293D" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ImageCacheSizeFormatted}" FontSize="11.5" Foreground="#7DD3FC" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 4. Watch History Option -->
                    <Border Background="#161F30" CornerRadius="12" BorderBrush="#25354C" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding CleanWatchHistory}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="History" Width="17" Height="17" Foreground="#A855F7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="سوابق تماشا و ادامه پخش (Playback Sync)" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="دقایق باقیمانده و وضعیت دیده‌شدن فیلم‌ها و فایل هماهنگی پلیر پاکسازی می‌شود." 
                                           FontSize="11" Foreground="#94A3B8" Margin="23,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#261B36" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WatchHistorySizeFormatted}" FontSize="11.5" Foreground="#D8B4FE" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 5. Logs Option -->
                    <Border Background="#161F30" CornerRadius="12" BorderBrush="#25354C" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding CleanLogs}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="17" Height="17" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="فایل‌های لاگ و گزارشات سیستم (Logs)" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="فایل‌های متنی گزارش عملکرد و عیب‌یابی نرم‌افزار پاکسازی می‌شوند." 
                                           FontSize="11" Foreground="#94A3B8" Margin="23,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#64748B" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LogsSizeFormatted}" FontSize="11.5" Foreground="#CBD5E1" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Warning Alert Banner -->
                <Border Background="#25171C" CornerRadius="10" BorderBrush="#E11D48" BorderThickness="1" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#FB7185" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="توجه: عملیات پاکسازی برای گزینه‌های انتخابی قطعی و غیرقابل بازگشت است. فایل‌های اصلی ویدیو بر روی درایوهای هارد شما دست‌نخورده باقی می‌مانند."
                                   FontSize="11" Foreground="#FDA4AF" TextWrapping="Wrap" LineHeight="17" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="0,0,19,19" Padding="20,14"
                    BorderBrush="#334155" BorderThickness="0,1,0,0">
                <Grid>
                    <!-- Total Freeable Size Display -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="مجموع حجم آزادشونده:" FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TotalFreeableFormatted}" FontSize="14.5" FontWeight="Black" Foreground="#34D399" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Click="BtnCancel_Click" Margin="0,0,10,0"
                                Width="100" Height="38"
                                Background="#334155" Foreground="White" BorderThickness="0"
                                materialDesign:ButtonAssist.CornerRadius="10" Cursor="Hand"
                                Content="انصراف" FontSize="13" FontWeight="SemiBold"/>

                        <Button Click="BtnConfirm_Click"
                                IsEnabled="{Binding HasAnySelected}"
                                Width="170" Height="38"
                                Background="#DC2626" Foreground="White" BorderThickness="0"
                                materialDesign:ButtonAssist.CornerRadius="10" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تأیید و پاکسازی نهایی" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="MovieManagerDesktop.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="بروزرسانی جدید MovieManager"
        Width="580" Height="530"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Outer Glassmorphic Border -->
    <Border Background="#F2101222" CornerRadius="20" BorderBrush="#4038BDF8" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="4" Color="Black" Opacity="0.85"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Draggable Window Header -->
            <Border Grid.Row="0" Background="#161936" CornerRadius="19,19,0,0" Padding="20,13"
                    BorderBrush="#252A54" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <!-- Logo + Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="26" Height="26" 
                               RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="بروزرسانی جدید MovieManager" FontSize="14.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close Button (Hidden if mandatory) -->
                    <Button x:Name="BtnClose" Click="BtnClose_Click" HorizontalAlignment="Left"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            Width="30" Height="30" Cursor="Hand" Padding="0">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="22,16,22,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Version Info Card -->
                    <RowDefinition Height="*"/>    <!-- Changelog Box -->
                </Grid.RowDefinitions>

                <!-- Version Info Card -->
                <Border Grid.Row="0" Background="#161936" CornerRadius="14" Padding="16" Margin="0,0,0,14" BorderBrush="#2A2F5A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon Badge -->
                        <Border Grid.Column="0" Width="54" Height="54" CornerRadius="12" Background="#1A224D" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="RocketLaunchOutline" Width="30" Height="30" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="نسخه جدید آماده نصب است: " FontSize="13.5" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                                <Border Background="#1E3A5F" CornerRadius="6" Padding="8,2" Margin="6,0,0,0" BorderBrush="#38BDF8" BorderThickness="1">
                                    <TextBlock x:Name="TxtLatestVersion" Text="v2.0.1" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" FlowDirection="LeftToRight"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="نسخه فعلی شما: " FontSize="11.5" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtCurrentVersion" Text="v2.8.2" FontSize="11.5" Foreground="#CBD5E1" FontWeight="Bold" FlowDirection="LeftToRight" Margin="4,0,14,0"/>

                                <TextBlock x:Name="TxtFileSizeLabel" Text="حجم: " FontSize="11.5" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtFileSize" Text="85 MB" FontSize="11.5" Foreground="#34D399" FontWeight="Bold" FlowDirection="LeftToRight" Margin="4,0,14,0"/>

                                <TextBlock x:Name="TxtReleaseDateLabel" Text="تاریخ انتشار: " FontSize="11.5" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtReleaseDate" Text="1403/05/10" FontSize="11.5" Foreground="#CBD5E1" Margin="4,0,0,0"/>
                            </StackPanel>

                            <!-- Mandatory Alert -->
                            <Border x:Name="BorderMandatory" Visibility="Collapsed" Background="#26F87171" BorderBrush="#F87171" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#F87171" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="نصب این بروزرسانی برای ادامه عملکرد پایدار الزامی است." FontSize="11" Foreground="#FECACA" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Changelog Box -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📋 تغییرات و امکانات این نسخه (Changelog):" FontSize="12.5" FontWeight="Bold" Foreground="#94A3B8" Margin="4,0,0,6"/>

                    <Border Grid.Row="1" Background="#0E1022" CornerRadius="12" BorderBrush="#252A54" BorderThickness="1" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtChangelog" Text="• تغییرات نسخه..."
                                       FontSize="12.5" Foreground="#E2E8F0" LineHeight="22" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer Buttons & Progress Area -->
            <Border Grid.Row="2" Background="#161936" CornerRadius="0,0,19,19" Padding="20,14" BorderBrush="#252A54" BorderThickness="0,1,0,0">
                <Grid>
                    <!-- Normal State: Action Buttons -->
                    <Grid x:Name="GridNormalFooter">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Download & Update Button -->
                        <Button x:Name="BtnDownload" Grid.Column="0" Click="BtnDownload_Click" Margin="0,0,12,0"
                                Foreground="White" BorderThickness="0" Height="44" Cursor="Hand"
                                materialDesign:ButtonAssist.CornerRadius="10">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0284C7" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="دانلود و نصب خودکار بروزرسانی" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Later Button -->
                        <Button x:Name="BtnLater" Grid.Column="1" Click="BtnLater_Click"
                                Background="Transparent" BorderBrush="#3B4270" BorderThickness="1"
                                Foreground="#94A3B8" Height="44" Padding="18,0" Cursor="Hand"
                                materialDesign:ButtonAssist.CornerRadius="10">
                            <TextBlock Text="بعداً یادآوری کن" FontSize="12.5"/>
                        </Button>
                    </Grid>

                    <!-- Downloading State: Progress Bar & Speed -->
                    <Grid x:Name="GridDownloadProgress" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Status & Stats -->
                        <Grid Grid.Row="0" Margin="0,0,0,10" MinHeight="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Status / Error Message (Takes available width, wraps cleanly) -->
                            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="SpinnerProgress" Grid.Column="0"
                                             Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                             Width="16" Height="16" IsIndeterminate="True" Value="0"
                                             Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                <materialDesign:PackIcon x:Name="IconErrorStatus" Grid.Column="0"
                                                         Kind="AlertCircle" Width="18" Height="18"
                                                         Foreground="#F87171" Margin="0,0,8,0" 
                                                         VerticalAlignment="Center" Visibility="Collapsed"/>

                                <TextBlock x:Name="TxtDownloadStatus" Grid.Column="1"
                                           Text="در حال دریافت بسته بروزرسانی..." FontSize="12" 
                                           Foreground="#E2E8F0" FontWeight="SemiBold" 
                                           VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                            </Grid>

                            <!-- Stats: Size & Speed (Hidden when error occurs) -->
                            <StackPanel x:Name="PnlDownloadStats" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtDownloadSize" Text="0 MB / 0 MB" FontSize="11.5" Foreground="#94A3B8" FlowDirection="LeftToRight" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtDownloadSpeed" Text="0 KB/s" FontSize="11" Foreground="#34D399" FontWeight="Bold" FlowDirection="LeftToRight"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Progress Bar -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Border Height="8" CornerRadius="4" Background="#1E293B" ClipToBounds="True">
                                <ProgressBar x:Name="PrgDownload" Value="0" Maximum="100" Height="8"
                                             Foreground="#0284C7" Background="Transparent" BorderThickness="0"/>
                            </Border>
                        </Grid>

                        <!-- Action Buttons on the RIGHT and Percentage on the LEFT -->
                        <Grid Grid.Row="2">
                            <!-- Buttons on Right side (Left alignment in RTL) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button x:Name="BtnCancelDownload" Click="BtnCancelDownload_Click"
                                        Background="#26F87171" BorderBrush="#F87171" BorderThickness="1"
                                        Foreground="#FCA5A5" Height="32" Padding="14,0" Cursor="Hand" Margin="0,0,8,0"
                                        materialDesign:ButtonAssist.CornerRadius="6">
                                    <TextBlock Text="انصراف" FontSize="11.5" FontWeight="SemiBold"/>
                                </Button>

                                <Button x:Name="BtnBrowserFallback" Click="BtnBrowserFallback_Click" Visibility="Collapsed"
                                        Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"
                                        Foreground="#38BDF8" Height="32" Padding="12,0" Cursor="Hand"
                                        materialDesign:ButtonAssist.CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="OpenInBrowser" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="دانلود با مرورگر" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Percentage on Left side (Right alignment in RTL) -->
                            <TextBlock x:Name="TxtPercent" Text="۰%" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

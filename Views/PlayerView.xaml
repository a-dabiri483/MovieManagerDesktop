<UserControl x:Class="MovieManagerDesktop.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib.Controls.WPF"
             xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="Black"
             Focusable="True"
             MouseMove="UserControl_MouseMove"
             MouseLeave="UserControl_MouseLeave"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        
        <!-- Glassmorphism Floating Bar Style -->
        <Style x:Key="GlassControlBarStyle" TargetType="Border">
            <Setter Property="Background" Value="#E60A0F1D"/>
            <Setter Property="BorderBrush" Value="#3338BDF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Color="Black" Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Player Action Icon Button Style -->
        <Style x:Key="PlayerIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3338BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5538BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Player Action Repeat Button Style for Continuous Hold Seeking -->
        <Style x:Key="PlayerIconRepeatBtn" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3338BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5538BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Black" ClipToBounds="True">
        <!-- ── 1. Video Surface (Flyleaf Direct3D 11 Video Surface) ── -->
        <fl:FlyleafME x:Name="FlyleafVideoView" 
                      Player="{Binding Player}"
                      Background="Black"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      MouseLeftButtonDown="FlyleafVideoView_MouseLeftButtonDown"
                      MouseDoubleClick="FlyleafVideoView_MouseDoubleClick"
                      MouseWheel="FlyleafVideoView_MouseWheel"/>

        <!-- ── 2. Top Bar (Title & Quick Tools) ── -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Background="#D9060913"
                BorderBrush="#2238BDF8" BorderThickness="0,0,0,1"
                Padding="12,6"
                Visibility="{Binding ShowControls, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Close / Back Button -->
                    <ColumnDefinition Width="*"/>    <!-- Title & Season/Episode -->
                    <ColumnDefinition Width="Auto"/> <!-- Quick Tools (Shortcuts, Bookmarks, Playlist) -->
                </Grid.ColumnDefinitions>

                <!-- Back / Close Player -->
                <Button Grid.Column="0" Command="{Binding ClosePlayerCommand}" Style="{StaticResource PlayerIconBtn}" ToolTip="بستن و بازگشت (Esc / F4)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowRight" Width="20" Height="20" Margin="0,0,4,0"/>
                        <TextBlock Text="بازگشت" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Media Title -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MediaTitle}" 
                               Foreground="White" FontSize="14" FontWeight="Bold" 
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SeasonEpisodeText}" 
                               Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,1,0,0"
                               Visibility="{Binding SeasonEpisodeText, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Top Right Tools -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Shortcuts Help (F1) -->
                    <Button Style="{StaticResource PlayerIconBtn}" Click="ToggleShortcutsHelp_Click" ToolTip="راهنمای کلیدهای میانبر (F1)" Margin="2,0">
                        <materialDesign:PackIcon Kind="KeyboardOutline" Width="19" Height="19"/>
                    </Button>

                    <!-- Bookmarks (H) -->
                    <Button Style="{StaticResource PlayerIconBtn}" Click="ToggleBookmarksDrawer_Click" ToolTip="نشانک‌ها (H)" Margin="2,0">
                        <materialDesign:PackIcon Kind="BookmarkMultipleOutline" Width="19" Height="19"/>
                    </Button>

                    <!-- Playlist / Episodes Drawer (F6) -->
                    <Button Style="{StaticResource PlayerIconBtn}" Click="TogglePlaylistDrawer_Click" ToolTip="لیست قسمت‌ها / پلی‌لیست (F6)" Margin="2,0">
                        <materialDesign:PackIcon Kind="PlaylistPlay" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 3. On-Screen Display (OSD) Notification Badge ── -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,60,0,0"
                Background="#CC0B1329" BorderBrush="#6638BDF8" BorderThickness="1.5"
                CornerRadius="12" Padding="16,8"
                Visibility="{Binding ShowOsd, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Color="#38BDF8" Opacity="0.5"/>
            </Border.Effect>
            <TextBlock Text="{Binding OsdMessage}" Foreground="#F8FAFC" FontSize="13.5" FontWeight="Bold" TextAlignment="Center"/>
        </Border>

        <!-- ── 4. Floating Bottom Control Bar (Ultra-Sleek & Compact) ── -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="Auto" MaxWidth="680" Margin="10,0,10,6"
                Style="{StaticResource GlassControlBarStyle}" Padding="10,3"
                Visibility="{Binding ShowControls, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Progress / Seekbar -->
                    <RowDefinition Height="Auto"/> <!-- Buttons Row -->
                </Grid.RowDefinitions>

                <!-- 4.1 Seekbar & Time Row -->
                <Grid Grid.Row="0" Margin="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Current Time -->
                        <ColumnDefinition Width="*"/>    <!-- Seek Slider -->
                        <ColumnDefinition Width="Auto"/> <!-- Total Duration -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding CurrentTimeFormatted}" 
                               Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" 
                               VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <Slider Grid.Column="1" 
                            Minimum="0.0" Maximum="1.0" 
                            Value="{Binding Progress, Mode=TwoWay}"
                            PreviewMouseDown="SeekSlider_PreviewMouseDown"
                            PreviewMouseUp="SeekSlider_PreviewMouseUp"
                            ValueChanged="SeekSlider_ValueChanged"
                            VerticalAlignment="Center" Cursor="Hand"
                            Style="{DynamicResource MaterialDesignSlider}"/>

                    <TextBlock Grid.Column="2" Text="{Binding TotalDurationFormatted}" 
                               Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" 
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>

                <!-- 4.2 Playback Control Buttons Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Volume & Audio Controls -->
                        <ColumnDefinition Width="*"/>    <!-- Main Play/Pause/Seek Center Controls -->
                        <ColumnDefinition Width="Auto"/> <!-- Subtitles, Speed, Aspect Ratio, Fullscreen -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Volume Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Mute Button -->
                        <Button Command="{Binding ToggleMuteCommand}" Style="{StaticResource PlayerIconBtn}" ToolTip="قطع/وصل صدا (M)" Margin="1,0" Width="26" Height="26">
                            <materialDesign:PackIcon Width="15" Height="15">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="VolumeHigh"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Kind" Value="VolumeMute"/>
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>

                        <!-- Volume Slider -->
                        <Slider Minimum="0" Maximum="200" Value="{Binding Volume, Mode=TwoWay}" 
                                Width="52" VerticalAlignment="Center" Cursor="Hand" Margin="2,0"
                                ValueChanged="VolumeSlider_ValueChanged"
                                ToolTip="{Binding Volume, StringFormat='ولوم: {0}%'}"/>
                        
                        <TextBlock Text="{Binding Volume, StringFormat='{}{0}%'}" Foreground="#94A3B8" FontSize="9" VerticalAlignment="Center" Width="24"/>
                    </StackPanel>

                    <!-- Center: Previous, -5s, Play/Pause, +5s, Next -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                        <!-- Prev File / Episode -->
                        <Button Command="{Binding PlayPreviousCommand}" Style="{StaticResource PlayerIconBtn}" ToolTip="قسمت/فایل قبلی (PgUp)" Margin="1,0" Width="26" Height="26">
                            <materialDesign:PackIcon Kind="SkipPrevious" Width="16" Height="16"/>
                        </Button>

                        <!-- Seek -5s (Click or Hold to Continuously Seek) -->
                        <RepeatButton Click="SeekBackward5s_Click" Style="{StaticResource PlayerIconRepeatBtn}" 
                                      Delay="120" Interval="70"
                                      ToolTip="۵ ثانیه عقب (← / نگه دارید برای حرکت ممتد)" Margin="1,0" Width="26" Height="26">
                            <materialDesign:PackIcon Kind="Rewind5" Width="16" Height="16"/>
                        </RepeatButton>

                        <!-- Play / Pause Compact Primary Button -->
                        <Button Command="{Binding TogglePlayPauseCommand}" 
                                Width="30" Height="30" Margin="4,0"
                                Background="#38BDF8" Foreground="#0B1329"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip="پخش / توقف (Space)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="15" Effect="{DynamicResource MaterialDesignElevationShadow1}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#7DD3FC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <materialDesign:PackIcon Width="16" Height="16">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="Pause"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                                                <Setter Property="Kind" Value="Play"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>

                        <!-- Seek +5s (Click or Hold to Continuously Seek) -->
                        <RepeatButton Click="SeekForward5s_Click" Style="{StaticResource PlayerIconRepeatBtn}" 
                                      Delay="120" Interval="70"
                                      ToolTip="۵ ثانیه جلو (→ / نگه دارید برای حرکت ممتد)" Margin="1,0" Width="26" Height="26">
                            <materialDesign:PackIcon Kind="FastForward5" Width="16" Height="16"/>
                        </RepeatButton>

                        <!-- Next File / Episode -->
                        <Button Command="{Binding PlayNextCommand}" Style="{StaticResource PlayerIconBtn}" ToolTip="قسمت/فایل بعدی (PgDn)" Margin="1,0" Width="26" Height="26">
                            <materialDesign:PackIcon Kind="SkipNext" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>

                    <!-- Right: Audio Tracks, Subtitles, Speed, Aspect Ratio, Fullscreen -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Audio Track Selector (A) -->
                        <Button Click="OpenAudioTracksPopup_Click" Style="{StaticResource PlayerIconBtn}" ToolTip="انتخاب ترک صوتی / دوبله (A)" Margin="1,0" Width="26" Height="26">
                            <materialDesign:PackIcon Kind="Translate" Width="15" Height="15"/>
                        </Button>

                        <!-- Subtitle Selector (L) -->
                        <Button Click="OpenSubtitlesPopup_Click" Style="{StaticResource PlayerIconBtn}" ToolTip="انتخاب زیرنویس (L)" Margin="1,0" Width="26" Height="26">
                            <materialDesign:PackIcon Kind="SubtitlesOutline" Width="15" Height="15"/>
                        </Button>

                        <!-- Playback Speed (X / C) -->
                        <Button Click="ToggleSpeedMenu_Click" Style="{StaticResource PlayerIconBtn}" ToolTip="سرعت پخش (X / C)" Margin="1,0" Width="26" Height="26">
                            <TextBlock Text="{Binding PlaybackSpeed, StringFormat='{}{0:0.0}x'}" FontWeight="Bold" FontSize="9.5" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Aspect Ratio (J / 1-7, 9) -->
                        <Button Click="ToggleAspectRatioMenu_Click" Style="{StaticResource PlayerIconBtn}" ToolTip="نسبت تصویر (J)" Margin="1,0" Width="26" Height="26">
                            <materialDesign:PackIcon Kind="AspectRatio" Width="15" Height="15"/>
                        </Button>

                        <!-- Fullscreen Toggle (Enter / F) -->
                        <Button Command="{Binding ToggleFullscreenCommand}" Style="{StaticResource PlayerIconBtn}" ToolTip="تمام‌صفحه (Enter / F)" Margin="1,0" Width="26" Height="26">
                            <materialDesign:PackIcon Kind="Fullscreen" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── 5. Right Slide-out Drawer: Playlist & Episodes (F6) ── -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="360"
                Background="#F00A0F1D" BorderBrush="#3338BDF8" BorderThickness="1,0,0,0"
                Visibility="{Binding ShowPlaylistDrawer, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.9"/>
            </Border.Effect>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="لیست قسمت‌ها / ویدیوها" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Left" Style="{StaticResource PlayerIconBtn}" Click="TogglePlaylistDrawer_Click">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Playlist}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#161F37" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" 
                                                      Command="{Binding DataContext.PlayPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Grid.Column="0" Kind="PlayCircleOutline" Foreground="#38BDF8" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedTitle}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FileName}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── 6. Left Slide-out Drawer: Bookmarks (H) ── -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="320"
                Background="#F00A0F1D" BorderBrush="#3338BDF8" BorderThickness="0,0,1,0"
                Visibility="{Binding ShowBookmarksDrawer, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="نشانک‌های ثبت‌شده (Bookmarks)" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource PlayerIconBtn}" Click="ToggleBookmarksDrawer_Click">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Bookmarks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#161F37" CornerRadius="10" Padding="12,8" Margin="0,0,0,8" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" 
                                                      Command="{Binding DataContext.SeekToBookmarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Grid.Column="0" Kind="Bookmark" Foreground="#F59E0B" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TimeFormatted}" Foreground="#94A3B8" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── 7. Shortcuts Help Overlay Modal (F1) ── -->
        <Border Background="#D9000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Visibility="{Binding ShowShortcutsHelp, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#111827" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="16"
                    MaxWidth="750" MaxHeight="600" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="راهنمای کلیدهای میانبر پلیر (PotPlayer Shortcuts)" Foreground="White" FontSize="17" FontWeight="Bold"/>
                        <Button HorizontalAlignment="Left" Style="{StaticResource PlayerIconBtn}" Click="ToggleShortcutsHelp_Click">
                            <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="Space" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="پخش / توقف (Play / Pause)" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="Enter / F" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="تمام‌صفحه (Fullscreen)" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="← / →" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="پرش ۵ ثانیه (با Ctrl: ۳۰ ثانیه، با Shift: ۱ دقیقه)" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="↑ / ↓" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="ولوم بالا / پایین (یا چرخ ماوس)" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="PgUp / PgDn" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="فایل یا قسمت قبلی / بعدی" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="X / C / Z" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="کاهش / افزایش / ریست سرعت پخش" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="D / F" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="فریم قبلی / بعدی (Frame Stepping)" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="&lt; / &gt; و /" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="سینک زیرنویس ۰.۵∓ ثانیه و ریست" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="Shift+&lt; / &gt;" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="سینک صدا ۰.۰۵ ثانیه" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="[ / ] و \" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="تنظیم زمان و روشن/خاموش کردن تکرار A-B" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="W/E, R/T, Y/U, I/O, Q" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="روشنایی/کنتراست/اشباع/رنگ ±۱٪ و ریست" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="1 تا 7 و 9" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="پیش‌تنظیم‌های اندازه پنجره و نسبت تصویر" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="P / H" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="افزودن بوک‌مارک / مشاهده بوک‌مارک‌ها" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="A / L / J / K" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="انتخاب صدا / انتخاب زیرنویس / نسبت تصویر / اسنپ‌شات" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="Ctrl+Z / Ctrl+V" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="تصویر آینه‌ای / فلیپ عمودی تصویر" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="Shift+N / Shift+D" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="نرمال‌سازی صدا / حذف نویز صوتی" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="Ctrl+G / Shift+G" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="ضبط پیوسته فریم / ضبط صدا" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                            <Border Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid><TextBlock Text="F1 تا F7, F12" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="راهنما / پوشه / بازکردن / بستن / پلی‌لیست / اکولایزر" Foreground="White" HorizontalAlignment="Right"/></Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- ── 8. Audio Tracks Selector Popup ── -->
        <Border Background="#F00B1329" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="12"
                Width="280" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,160,65"
                Padding="16"
                Visibility="{Binding ShowAudioTracksPopup, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="انتخاب صدای فیلم (Audio Tracks)" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    <Button HorizontalAlignment="Left" Style="{StaticResource PlayerIconBtn}" Click="CloseAudioTracksPopup_Click">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding AudioTracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="#1F2937" Foreground="White" BorderThickness="0" Margin="0,0,0,6"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.SelectAudioTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                                    <materialDesign:PackIcon Kind="Check" Foreground="#38BDF8" Width="18" Height="18" HorizontalAlignment="Left"
                                                             Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ── 9. Subtitle Tracks Selector Popup ── -->
        <Border Background="#F00B1329" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="12"
                Width="290" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,120,65"
                Padding="16"
                Visibility="{Binding ShowSubtitlesPopup, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="انتخاب زیرنویس (Subtitles)" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    <Button HorizontalAlignment="Left" Style="{StaticResource PlayerIconBtn}" Click="CloseSubtitlesPopup_Click">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
                <Button Command="{Binding OpenOnlineSubtitleModalCommand}" Background="#E50914" Foreground="White" BorderThickness="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DownloadOutline" Width="18" Height="18" Margin="0,0,6,0"/>
                        <TextBlock Text="📥 دانلود آنلاین زیرنویس (SubDL)..." FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding LoadExternalSubtitleCommand}" Background="#0284C7" Foreground="White" BorderThickness="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" Margin="0,0,6,0"/>
                        <TextBlock Text="بارگذاری فایل زیرنویس..." FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="#1F2937" Foreground="White" BorderThickness="0" Margin="0,0,0,6"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.SelectSubtitleTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                                    <materialDesign:PackIcon Kind="Check" Foreground="#38BDF8" Width="18" Height="18" HorizontalAlignment="Left"
                                                             Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>

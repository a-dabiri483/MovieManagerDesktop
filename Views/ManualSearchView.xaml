<UserControl x:Class="MovieManagerDesktop.Views.ManualSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ManualSearchViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100"
             FlowDirection="RightToLeft"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <materialDesign:BooleanToVisibilityConverter x:Key="InverseBoolToVis" TrueValue="Collapsed" FalseValue="Visible"/>
        <converters:RadioIntEqualsConverter x:Key="RadioIntEqualsConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        
        <Style x:Key="FilterChipRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,20,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: HEADER & BACK BUTTON -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding GoBackCommand}" 
                        Background="#20FFFFFF" BorderThickness="0" Width="40" Height="40" Padding="0" 
                        materialDesign:ButtonAssist.CornerRadius="20" ToolTip="بازگشت به خانه" Cursor="Hand" Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="ArrowRight" Width="22" Height="22" Foreground="{DynamicResource PrimaryColor}"/>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="جستجوی دستی آنلاین" FontSize="22" FontWeight="Black" Foreground="White"/>
                    <TextBlock Text="جستجو و ردیابی مستقیم عناوین از پایگاه داده TMDb" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ROW 1: SEARCH BAR & TYPE FILTER PILLS -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="20" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Padding="18,14" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="16" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Padding="14,2" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="22" Height="22" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="نام فیلم، سریال یا شناسه TMDb / IMDb را وارد کنید..."
                                     Foreground="White" FontSize="14.5" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- Search Button -->
                    <Button Grid.Column="1" Command="{Binding SearchCommand}" Height="44" Padding="24,0" Background="{DynamicResource PrimaryGradientBrush}" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="14" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="جستجو" Foreground="White" FontWeight="Black" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <materialDesign:PackIcon Kind="SearchWeb" Width="20" Height="20" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Filter Chips & Status Message -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource FilterChipRadio}" Content="همه" IsChecked="{Binding SelectedFilterIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=0}"/>
                        <RadioButton Style="{StaticResource FilterChipRadio}" Content="فیلم‌ها" IsChecked="{Binding SelectedFilterIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=1}"/>
                        <RadioButton Style="{StaticResource FilterChipRadio}" Content="سریال‌ها" IsChecked="{Binding SelectedFilterIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=2}"/>
                        <RadioButton Style="{StaticResource FilterChipRadio}" Content="انیمه" IsChecked="{Binding SelectedFilterIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=3}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ROW 2: SEARCH RESULTS LIST -->
        <Grid Grid.Row="2">
            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource PrimaryColor}" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10"/>

            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Results.Count}" Value="0"/>
                                    <Condition Binding="{Binding IsSearching}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="80" Height="80" CornerRadius="40" Background="#15FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="MovieSearchOutline" Width="44" Height="44" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="نام فیلم یا سریال مورد نظر را برای جستجو وارد کنید" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="می‌توانید عناوین یافت‌شده را مستقیماً به ردیاب اضافه کنید" FontSize="12.5" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Results Wrap Grid -->
            <ListBox ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="0,0,0,100">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="StartAndEndOnly"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Height="360" Background="{DynamicResource CardBackground}" CornerRadius="18" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" ClipToBounds="True" Margin="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="240"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Poster Image -->
                                <Border Grid.Row="0" Background="#1A1C30">
                                    <Grid>
                                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        
                                        <!-- Gradient Overlay -->
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#00000000" Offset="0.5"/>
                                                    <GradientStop Color="#CC0A0B16" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Media Type Badge -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#B0000000" CornerRadius="10" Padding="8,3" Margin="8">
                                            <TextBlock Text="{Binding MediaTypeDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                        </Border>

                                        <!-- Year Badge -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#B0000000" CornerRadius="10" Padding="8,3" Margin="8" Visibility="{Binding ReleaseYear, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{Binding ReleaseYear}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Info & Action Section -->
                                <Grid Grid.Row="1" Margin="12,8,12,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="White" FontSize="13.5" FontWeight="Black" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>

                                    <!-- Overview Preview -->
                                    <TextBlock Grid.Row="1" Text="{Binding Overview}" Foreground="{DynamicResource SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="32" Margin="0,2,0,0"/>

                                    <!-- Add to Tracker Button -->
                                    <Button Grid.Row="2" Command="{Binding ToggleTrackerCommand}" Height="36" Padding="12,0" materialDesign:ButtonAssist.CornerRadius="10" Cursor="Hand" Margin="0,6,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInTracker}" Value="True">
                                                        <Setter Property="Background" Value="#2526DE81"/>
                                                        <Setter Property="BorderBrush" Value="#8026DE81"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Foreground" Value="#26DE81"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <!-- Not In Tracker -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsInTracker, Converter={StaticResource InverseBoolToVis}}">
                                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="افزودن به ردیاب" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- In Tracker -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsInTracker, Converter={StaticResource BoolToVis}}">
                                                <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="#26DE81" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="در ردیاب موجود است" FontSize="12" FontWeight="Bold" Foreground="#26DE81" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>

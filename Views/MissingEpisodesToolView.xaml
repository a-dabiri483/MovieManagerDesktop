<UserControl x:Class="MovieManagerDesktop.Views.MissingEpisodesToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
             xmlns:models="clr-namespace:MovieManagerDesktop.Models"
             xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:MissingEpisodesToolViewModel}"
             d:DesignHeight="900" d:DesignWidth="1150"
             FlowDirection="RightToLeft"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:PersianNumberConverter x:Key="PersianNum"/>
        <converters:RadioIntEqualsConverter x:Key="RadioIntEqualsConverter"/>

        <!-- Stat Card Style -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- Series Card Style -->
        <Style x:Key="SeriesMissingCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Expand / Collapse Button Text Style -->
        <Style x:Key="ExpandToggleTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="مشاهده قسمت‌ها"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Text" Value="بستن جزئیات"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Expand / Collapse Button Icon Style -->
        <Style x:Key="ExpandToggleIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Kind" Value="ChevronDown"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Kind" Value="ChevronUp"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,40">
            <StackPanel Margin="32,24,32,24" MaxWidth="1100">

                <!-- ======================================================== -->
                <!-- HEADER BAR -->
                <!-- ======================================================== -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Back Button -->
                    <Button Grid.Column="0" Command="{Binding GoBackCommand}"
                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                            Background="#20FFFFFF" BorderBrush="#35FFFFFF" Foreground="White"
                            Width="40" Height="40" Margin="0,0,16,0" Cursor="Hand" ToolTip="بازگشت به ابزارها">
                        <materialDesign:PackIcon Kind="ArrowRight" Width="22" Height="22"/>
                    </Button>

                    <!-- Title & Description -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TelevisionGuide" Width="28" Height="28" Foreground="#FF9F43" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="ردیاب سریال‌های ناقص (Missing Episodes)" FontSize="22" FontWeight="Black" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="شناسایی خودکار سریال‌هایی که قسمت‌های جدید آن‌ها پخش شده ولی هنوز در آرشیو شما دانلود نشده‌اند" 
                                   FontSize="12.5" Foreground="{DynamicResource SecondaryText}" Margin="36,4,0,0"/>
                    </StackPanel>

                    <!-- Scan / Refresh Button -->
                    <Button Grid.Column="2" Command="{Binding ScanCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#FF9F43" BorderBrush="#FF9F43" Foreground="Black"
                            FontWeight="Bold" Height="40" Padding="18,0" materialDesign:ButtonAssist.CornerRadius="12" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="اسکن مجدد آرشیو" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ======================================================== -->
                <!-- SCANNING PROGRESS BAR -->
                <!-- ======================================================== -->
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,16"
                             Foreground="#FF9F43" Background="#20FFFFFF" BorderThickness="0"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>

                <!-- ======================================================== -->
                <!-- STATS SUMMARY CARDS -->
                <!-- ======================================================== -->
                <UniformGrid Columns="3" Margin="0,0,0,20">
                    
                    <!-- Stat 1: Missing Series Count -->
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="سریال‌های دارای کسری" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock Text="{Binding TotalMissingSeries, Converter={StaticResource PersianNum}}" 
                                           FontSize="26" FontWeight="Black" Foreground="#FF9F43" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="46" Height="46" CornerRadius="12" Background="#25FF9F43" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="24" Height="24" Foreground="#FF9F43" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Stat 2: Total Missing Episodes -->
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="مجموع قسمت‌های دانلودنشده" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock Text="{Binding TotalMissingEpisodes, Converter={StaticResource PersianNum}}" 
                                           FontSize="26" FontWeight="Black" Foreground="#FF5252" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="46" Height="46" CornerRadius="12" Background="#25FF5252" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="MoviePlayOutline" Width="24" Height="24" Foreground="#FF5252" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Stat 3: Total Checked Series -->
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="کل سریال‌های اسکن‌شده" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock Text="{Binding TotalScannedSeries, Converter={StaticResource PersianNum}}" 
                                           FontSize="26" FontWeight="Black" Foreground="#00D2D3" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="46" Height="46" CornerRadius="12" Background="#2500D2D3" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FormatListBulleted" Width="24" Height="24" Foreground="#00D2D3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ======================================================== -->
                <!-- SEARCH, FILTER & ACTION BAR -->
                <!-- ======================================================== -->
                <Border Background="{DynamicResource CardBackground}" CornerRadius="14" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <Border Grid.Column="0" CornerRadius="10" Background="#181B2E" BorderBrush="#35FFFFFF" BorderThickness="1" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12.5"
                                         VerticalAlignment="Center" materialDesign:HintAssist.Hint="جستجو در سریال‌ها..."/>
                            </Grid>
                        </Border>

                        <!-- Filter Options (Radio Buttons) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <RadioButton Content="همه ناقص‌ها" Margin="0,0,12,0" Foreground="White" FontSize="12"
                                         IsChecked="{Binding FilterIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=0}"/>
                            <RadioButton Content="فقط در حال پخش" Margin="0,0,12,0" Foreground="White" FontSize="12"
                                         IsChecked="{Binding FilterIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=1}"/>
                            <RadioButton Content="فقط پایان‌یافته" Margin="0,0,12,0" Foreground="White" FontSize="12"
                                         IsChecked="{Binding FilterIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=2}"/>
                        </StackPanel>

                        <!-- Sort ComboBox -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="مرتب‌سازی:" Foreground="{DynamicResource SecondaryText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox SelectedIndex="{Binding SortIndex}" Width="130" FontSize="12" Foreground="White" Background="#181B2E">
                                <ComboBoxItem Content="بیشترین کسری"/>
                                <ComboBoxItem Content="کمترین کسری"/>
                                <ComboBoxItem Content="درصد تکمیل"/>
                                <ComboBoxItem Content="نام سریال"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Copy All Button -->
                        <Button Grid.Column="3" Command="{Binding CopyAllMissingCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="#FF9F43" Foreground="#FF9F43" Height="34" Padding="12,0" materialDesign:ButtonAssist.CornerRadius="8" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="کپی تمام کسری‌ها" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- EMPTY STATE -->
                <!-- ======================================================== -->
                <Border CornerRadius="16" Background="{DynamicResource CardBackground}" BorderBrush="#3526DE81" BorderThickness="1" Padding="32" Margin="0,20,0,0"
                        Visibility="{Binding FilteredGroups.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="56" Height="56" Foreground="#26DE81" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="هیچ سریال ناقصی در این بخش یافت نشد!" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="آرشیو شما کامل است یا برای فیلتر انتخابی شما قسمتی کسری وجود ندارد." FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ======================================================== -->
                <!-- LIST OF MISSING SERIES -->
                <!-- ======================================================== -->
                <ItemsControl ItemsSource="{Binding FilteredGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:MissingSeriesGroup}">
                            <Border Style="{StaticResource SeriesMissingCard}">
                                <StackPanel>
                                    
                                    <!-- Series Summary Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Poster Image -->
                                        <Border Grid.Column="0" Width="60" Height="86" CornerRadius="8" Background="#181B2E" ClipToBounds="True">
                                            <Image Source="{Binding PosterUrl, Converter={StaticResource ImageUrlToCachedImageConverter}}" 
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Info Column -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,14,0">
                                            
                                            <!-- Title & Badges -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                
                                                <!-- Status Badge -->
                                                <Border Background="#20FFFFFF" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
                                                </Border>

                                                <!-- Year -->
                                                <TextBlock Text="{Binding FormattedYear, Converter={StaticResource PersianNum}}" 
                                                           FontSize="12" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>

                                            <!-- Genres -->
                                            <TextBlock Text="{Binding FormattedGenres}" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8"/>

                                            <!-- Progress Bar & Text -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <ProgressBar Grid.Column="0" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="6"
                                                             Foreground="#FF9F43" Background="#20FFFFFF" BorderThickness="0" VerticalAlignment="Center"/>
                                                
                                                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center">
                                                    <Run Text="{Binding TotalLocalEpisodes, Converter={StaticResource PersianNum}}"/>
                                                    <Run Text=" از "/>
                                                    <Run Text="{Binding TotalAiredEpisodes, Converter={StaticResource PersianNum}}"/>
                                                    <Run Text=" قسمت موجود است ("/>
                                                    <Run Text="{Binding ProgressPercent, Converter={StaticResource PersianNum}}"/>
                                                    <Run Text="%)"/>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Missing Summary Line -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="قسمت‌های کسری: " FontSize="11.5" FontWeight="Bold" Foreground="#FF9F43"/>
                                                <TextBlock Text="{Binding MissingSummaryText, Converter={StaticResource PersianNum}}" FontSize="11.5" Foreground="#FF9F43"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Buttons & Missing Count Badge -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            
                                            <!-- Missing Count Badge -->
                                            <Border Background="#25FF5252" CornerRadius="10" Padding="10,4" Margin="0,0,0,8" HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AlertDecagram" Width="16" Height="16" Foreground="#FF5252" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding MissingCount, Converter={StaticResource PersianNum}}" FontWeight="Black" FontSize="13" Foreground="#FF5252"/>
                                                    <TextBlock Text=" قسمت ناقص" FontSize="11.5" Foreground="#FF5252" Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Buttons Row -->
                                            <StackPanel Orientation="Horizontal">
                                                
                                                <!-- Search / Download Series Button -->
                                                <Button Command="{Binding DataContext.SearchDownloadForSeriesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                                        Background="#FF9F43" BorderBrush="#FF9F43" Foreground="#121212"
                                                        Height="30" Padding="10,0" Margin="0,0,6,0" materialDesign:ButtonAssist.CornerRadius="6" Cursor="Hand"
                                                        ToolTip="جستجو و دانلود سریال در مرورگر و کپی عبارت در کلیپ‌بورد">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Download" Width="14" Height="14" VerticalAlignment="Center"/>
                                                        <TextBlock Text="دانلود سریال" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Copy Series Title Button -->
                                                <Button Command="{Binding DataContext.CopySeriesTitleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        BorderBrush="#35FFFFFF" Foreground="#00D2D3" Height="30" Padding="8,0" Margin="0,0,6,0" ToolTip="کپی نام سریال">
                                                    <materialDesign:PackIcon Kind="FormatTitle" Width="14" Height="14"/>
                                                </Button>

                                                <!-- Copy Missing Episodes Button -->
                                                <Button Command="{Binding DataContext.CopyMissingForSeriesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        BorderBrush="#35FFFFFF" Foreground="White" Height="30" Padding="8,0" Margin="0,0,6,0" ToolTip="کپی نام قسمت‌های کسری">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14"/>
                                                </Button>

                                                <!-- Online Refresh Button -->
                                                <Button Command="{Binding DataContext.RefreshOnlineForSeriesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBooleanConverter}}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        BorderBrush="#35FFFFFF" Foreground="#00D2D3" Height="30" Padding="8,0" Margin="0,0,6,0" ToolTip="بروزرسانی آنلاین قسمت‌ها از TMDb">
                                                    <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="14" Height="14"/>
                                                </Button>

                                                <!-- Expand / Collapse Button -->
                                                <Button Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                                        Background="#20FFFFFF" BorderBrush="#35FFFFFF" Foreground="White"
                                                        Height="30" Padding="10,0" materialDesign:ButtonAssist.CornerRadius="6" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource ExpandToggleTextStyle}" 
                                                                   FontSize="11" VerticalAlignment="Center"/>
                                                        <materialDesign:PackIcon Style="{StaticResource ExpandToggleIconStyle}" 
                                                                                 Width="14" Height="14" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Expandable Details: Missing Episode Chips -->
                                    <Border Margin="0,14,0,0" Padding="14" Background="#14172B" CornerRadius="12" BorderBrush="#25FFFFFF" BorderThickness="1"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="لیست قسمت‌های پخش‌شده‌ای که در آرشیو شما موجود نیستند:" 
                                                       FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,10"/>
                                            
                                            <WrapPanel>
                                                <ItemsControl ItemsSource="{Binding MissingEpisodes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:MissingEpisodeInfo}">
                                                            <Border Background="#1C2138" CornerRadius="8" BorderBrush="#35FF9F43" BorderThickness="1"
                                                                    Padding="10,6" Margin="4,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- SxxExx Badge -->
                                                                    <Border Grid.Column="0" Background="#FF9F43" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding EpisodeCode}" FontWeight="Black" FontSize="11" Foreground="Black"/>
                                                                    </Border>
                                                                    
                                                                    <!-- Name & AirDate -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding EpisodeName}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding FormattedAirDate, Converter={StaticResource PersianNum}}" FontSize="10" Foreground="{DynamicResource SecondaryText}"/>
                                                                    </StackPanel>

                                                                    <!-- Search Episode Button -->
                                                                    <Button Grid.Column="2" 
                                                                            Command="{Binding DataContext.SearchDownloadForEpisodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource MaterialDesignToolButton}"
                                                                            Foreground="#FF9F43" Width="24" Height="24" Padding="0" Margin="6,0,0,0"
                                                                            ToolTip="جستجوی دانلود این قسمت">
                                                                        <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14"/>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<Window x:Class="MovieManagerDesktop.Views.BackupProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="پیشرفت عملیات پشتیبان‌گیری و بازیابی"
        Width="520" Height="270"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Outer Glassmorphic Container -->
    <Border Background="#F50F172A" CornerRadius="20" BorderBrush="#4038BDF8" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="4" Color="Black" Opacity="0.85"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Body -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="19,19,0,0" Padding="18,12"
                    BorderBrush="#334155" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="IconHeader" Kind="CloudSyncOutline" Width="22" Height="22" Foreground="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHeaderTitle" Text="عملیات پشتیبان‌گیری و بازیابی" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close Button (only visible when completed or failed) -->
                    <Button x:Name="BtnCloseHeader" Click="BtnClose_Click" HorizontalAlignment="Left"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            Width="28" Height="28" Cursor="Hand" Padding="0" Visibility="Collapsed">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="22,16,22,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Operation Title & Badge -->
                    <RowDefinition Height="Auto"/> <!-- Status Text & Percent -->
                    <RowDefinition Height="Auto"/> <!-- ProgressBar -->
                </Grid.RowDefinitions>

                <!-- Operation Title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                    <Border x:Name="BadgeIcon" Width="42" Height="42" CornerRadius="10" Background="#1E3A5F" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="MainStatusIcon" Kind="ProgressDownload" Width="24" Height="24" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtOperationTitle" Text="در حال انجام عملیات..." FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtOperationSubtitle" Text="لطفاً شکیبا باشید، اطلاعات در حال پردازش امن هستند" FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status & Percentage -->
                <Grid Grid.Row="1" Margin="0,4,0,8">
                    <TextBlock x:Name="TxtStatusDetail" Text="آماده‌سازی..." FontSize="12" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPercentage" Text="۰٪" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" FlowDirection="LeftToRight" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>

                <!-- ProgressBar -->
                <Border Grid.Row="2" CornerRadius="6" Height="10" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
                    <ProgressBar x:Name="ProgressBarMain" Minimum="0" Maximum="100" Value="0"
                                 Height="10" BorderThickness="0" Background="Transparent" Foreground="#38BDF8"/>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#151E2E" CornerRadius="0,0,19,19" Padding="18,12"
                    BorderBrush="#233044" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="TxtSecurityNote" Text="🔒 محافظت‌شده با استاندارد رمزنگاری نظامی AES-256-GCM" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                    <Button x:Name="BtnDone" Click="BtnClose_Click" Content="تأیید و بستن"
                            HorizontalAlignment="Left" Visibility="Collapsed"
                            Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="12.5"
                            Padding="16,6" Height="32" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="MovieManagerDesktop.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
             xmlns:controls="clr-namespace:MovieManagerDesktop.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="32,40,32,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: Month Navigation + Action Buttons -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding PreviousMonthCommand}" Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource LightBorder}" Foreground="White" Width="40" Height="40" Margin="0,0,12,0" ToolTip="ماه قبل">
                    <materialDesign:PackIcon Kind="ChevronRight" Width="22" Height="22"/>
                </Button>
                <Button Command="{Binding NextMonthCommand}" Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource LightBorder}" Foreground="White" Width="40" Height="40" ToolTip="ماه بعد">
                    <materialDesign:PackIcon Kind="ChevronLeft" Width="22" Height="22"/>
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding MonthName, Converter={StaticResource PersianNumberConverter}}" FontSize="26" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Action Buttons: Fetch and Add Reminder -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Command="{Binding FetchMonthContentCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="{DynamicResource PrimaryColor}" Foreground="White" BorderThickness="0"
                        Height="40" Padding="18,0" materialDesign:ButtonAssist.CornerRadius="12"
                        IsEnabled="{Binding IsFetching, Converter={StaticResource InverseBooleanConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="دریافت عناوین این ماه" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Fetching indicator -->
        <ProgressBar Grid.Row="1" Style="{StaticResource MaterialDesignLinearProgressBar}" IsIndeterminate="True" 
                     Foreground="{DynamicResource PrimaryColor}"
                     Visibility="{Binding IsFetching, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10"/>

        <!-- Days of Week Header -->
        <UniformGrid Grid.Row="2" Columns="7" Margin="0,0,0,8" VerticalAlignment="Top">
            <TextBlock Text="شنبه" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Padding="0,6"/>
            <TextBlock Text="یکشنبه" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Padding="0,6"/>
            <TextBlock Text="دوشنبه" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Padding="0,6"/>
            <TextBlock Text="سه‌شنبه" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Padding="0,6"/>
            <TextBlock Text="چهارشنبه" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Padding="0,6"/>
            <TextBlock Text="پنج‌شنبه" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Padding="0,6"/>
            <TextBlock Text="جمعه" FontSize="13" FontWeight="Bold" Foreground="#FF4757" HorizontalAlignment="Center" Padding="0,6"/>
        </UniformGrid>

        <!-- Days Grid -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Days}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" VerticalAlignment="Top"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{x:Null}" Background="Transparent" Padding="0" BorderThickness="0" Cursor="Hand"
                            Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            CommandParameter="{Binding}"
                            Visibility="{Binding DayNumber, Converter={StaticResource ZeroToVisibilityConverter}, ConverterParameter=Inverse}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Margin="3" CornerRadius="12" MinHeight="85">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="#25EB3B5A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFriday}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#40FF4757"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundLight}"/>
                                                    <Setter Property="BorderBrush" Value="#60EB3B5A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    
                                    <Grid>
                                        <!-- Background Poster (semi-transparent) -->
                                        <Image controls:CachedImage.SourceUrl="{Binding FirstPosterUrl}" Stretch="UniformToFill" Opacity="0.22"
                                               Visibility="{Binding FirstPosterUrl, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                            <Image.Clip>
                                                <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,200,200"/>
                                            </Image.Clip>
                                        </Image>
                                        
                                        <StackPanel Margin="8">
                                            <!-- Day Number -->
                                            <TextBlock Text="{Binding DayNumber, Converter={StaticResource PersianNumberConverter}}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFriday}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF4757"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            
                                            <!-- Release Dots -->
                                            <ItemsControl ItemsSource="{Binding Releases}" Margin="0,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Ellipse Width="7" Height="7" Margin="1.5">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource PrimaryColor}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding MediaType}" Value="Series">
                                                                            <Setter Property="Fill" Value="{DynamicResource PurpleAccent}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>

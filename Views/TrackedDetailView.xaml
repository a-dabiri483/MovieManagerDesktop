<UserControl x:Class="MovieManagerDesktop.Views.TrackedDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
             xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:TrackedDetailViewModel}"
             d:DesignHeight="1050" d:DesignWidth="1100"
             FlowDirection="RightToLeft"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:PersianNumberConverter x:Key="PersianNumberConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:JalaliDateConverter x:Key="JalaliDateConverter"/>

        <!-- Stat Pill Style -->
        <Style x:Key="DetailStatPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <!-- Stepper Button Style -->
        <Style x:Key="StepperBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
                                <Setter TargetName="btnBorder" Property="BorderThickness" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Background}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,60">
            <StackPanel>

                <!-- 1. HERO BACKDROP SECTION -->
                <Grid Height="380">
                    <!-- Backdrop Image with Gradient Overlay -->
                    <Border Background="#0C0D1A">
                        <Grid>
                            <Image Source="{Binding BackdropUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.4"/>
                            
                            <!-- Heavy Bottom Gradient Overlay -->
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#000C0D1A" Offset="0"/>
                                        <GradientStop Color="#880C0D1A" Offset="0.5"/>
                                        <GradientStop Color="{DynamicResource BackgroundColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Side Gradient Overlays -->
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="{DynamicResource BackgroundColor}" Offset="0"/>
                                        <GradientStop Color="#000C0D1A" Offset="0.4"/>
                                        <GradientStop Color="#000C0D1A" Offset="0.6"/>
                                        <GradientStop Color="{DynamicResource BackgroundColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Top Action Bar (Back Button + TMDb Sync + Remove) -->
                    <Grid VerticalAlignment="Top" Margin="32,20,32,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Back Button -->
                        <Button Grid.Column="0" Command="{Binding GoBackCommand}"
                                Height="42" Padding="16,0" Background="#35000000" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1"
                                materialDesign:ButtonAssist.CornerRadius="14" Cursor="Hand" ToolTip="بازگشت به ردیاب">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowRight" Width="20" Height="20" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="بازگشت به ردیاب" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <!-- Refresh from TMDb -->
                            <Button Command="{Binding RefreshFromTmdbCommand}"
                                    Height="40" Padding="14,0" Background="#35000000" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1"
                                    materialDesign:ButtonAssist.CornerRadius="12" Cursor="Hand" Margin="0,0,10,0" ToolTip="بروزرسانی وضعیت و اطلاعات از TMDb">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Sync" Width="18" Height="18" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="بروزرسانی از TMDb" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Remove from Tracker -->
                            <Button Command="{Binding RemoveFromTrackerCommand}"
                                    Height="40" Padding="14,0" Background="#30FF4757" BorderBrush="#50FF4757" BorderThickness="1"
                                    materialDesign:ButtonAssist.CornerRadius="12" Cursor="Hand" ToolTip="حذف از ردیاب">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18" Foreground="#FF4757" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="حذف از ردیاب" Foreground="#FF4757" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Poster & Main Title Details (Overlapping the Backdrop bottom) -->
                    <Grid VerticalAlignment="Bottom" Margin="36,0,36,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Poster Card -->
                        <Border Grid.Column="0" Width="170" Height="255" CornerRadius="16" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1.5" ClipToBounds="True" Background="{DynamicResource CardBackground}" Margin="0,0,24,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="Black"/>
                            </Border.Effect>
                            <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <!-- Title, Badges & Quick Stats -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            
                            <!-- Badges Row -->
                            <WrapPanel Margin="0,0,0,10">
                                <!-- Status Badge -->
                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,4" Background="#30000000" BorderBrush="{Binding SeriesStatusColor}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding SeriesStatusColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding SeriesStatusText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SeriesStatusColor}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Media Type Badge -->
                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,4" Background="#20FFFFFF">
                                    <TextBlock Text="{Binding MediaTypeDisplay}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </Border>

                                <!-- Year Badge -->
                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,4" Background="#20FFFFFF">
                                    <TextBlock Text="{Binding FormattedYear, Converter={StaticResource PersianNumberConverter}}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </Border>

                                <!-- Rating Badge -->
                                <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,4" Background="#25FFD32A">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Star" Width="16" Height="16" Foreground="#FFD32A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Rating, Converter={StaticResource PersianNumberConverter}, StringFormat='{}{0:0.0}'}" FontSize="12.5" FontWeight="Black" Foreground="#FFD32A"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Main Title -->
                            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Black" Foreground="White" TextWrapping="Wrap" LineHeight="36" Margin="0,0,0,8"/>

                            <!-- Genres -->
                            <TextBlock Text="{Binding FormattedGenres}" FontSize="13.5" Foreground="{DynamicResource SecondaryText}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 2. NEXT EPISODE HIGHLIGHT CARD (For Series) -->
                <Border Margin="36,16,36,16" Background="{DynamicResource CardBackground}" CornerRadius="18" BorderBrush="{DynamicResource PrimaryColor}" BorderThickness="1.5" Padding="20,16"
                        Visibility="{Binding HasNextEpisode, Converter={StaticResource BoolToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.3" Color="#EB3B5A"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="16" Background="{DynamicResource PrimaryGradientBrush}" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="BellRingOutline" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="قسمت بعدی در راه است!" FontSize="13" FontWeight="Black" Foreground="{DynamicResource PrimaryColor}"/>
                            <TextBlock Text="{Binding NextEpisodeText, Converter={StaticResource PersianNumberConverter}}" FontSize="16" FontWeight="Black" Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. INFO METRICS ROW -->
                <WrapPanel Margin="36,8,36,16">
                    <!-- Network / Platform -->
                    <Border Style="{StaticResource DetailStatPill}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TelevisionBox" Width="20" Height="20" Foreground="#00D2D3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="شبکه / پلتفرم" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock Text="{Binding NetworkText}" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Air Schedule -->
                    <Border Style="{StaticResource DetailStatPill}" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20" Foreground="#FFA502" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="برنامه و زمان پخش" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock Text="{Binding AirScheduleText, Converter={StaticResource PersianNumberConverter}}" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Total Seasons -->
                    <Border Style="{StaticResource DetailStatPill}" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderMultipleOutline" Width="20" Height="20" Foreground="#A55EEA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="تعداد فصل‌ها" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock Text="{Binding SeasonsCountText, Converter={StaticResource PersianNumberConverter}}" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Total Episodes -->
                    <Border Style="{StaticResource DetailStatPill}" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayBoxMultipleOutline" Width="20" Height="20" Foreground="#2ED573" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="کل قسمت‌ها" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock Text="{Binding EpisodesCountText, Converter={StaticResource PersianNumberConverter}}" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- First Air Date -->
                    <Border Style="{StaticResource DetailStatPill}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarStar" Width="20" Height="20" Foreground="#3A86FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="تاریخ شروع پخش" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock Text="{Binding FirstAirDateText, Converter={StaticResource PersianNumberConverter}}" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 4. OVERVIEW SECTION -->
                <Border Margin="36,0,36,20" Background="{DynamicResource CardBackground}" CornerRadius="18" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Padding="22,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="TextLong" Width="20" Height="20" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="خلاصه داستان" FontSize="16" FontWeight="Black" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Overview}" FontSize="13.5" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" LineHeight="24"/>
                    </StackPanel>
                </Border>

                <!-- 5. SEASONS PROGRESS & WATCHED STEPPERS (Only for Series) -->
                <Border Margin="36,0,36,20" Background="{DynamicResource CardBackground}" CornerRadius="18" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1" Padding="22,20"
                        Visibility="{Binding IsSeries, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        
                        <!-- Progress Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="22" Height="22" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="ثبت قسمت‌های دیده شده" FontSize="18" FontWeight="Black" Foreground="White"/>
                            </StackPanel>

                            <!-- Overall Progress Text -->
                            <TextBlock Grid.Column="1" Text="{Binding OverallProgressText, Converter={StaticResource PersianNumberConverter}}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Overall Progress Bar -->
                        <Border Height="8" CornerRadius="4" Background="#18FFFFFF" ClipToBounds="True" Margin="0,0,0,20">
                            <ProgressBar Value="{Binding OverallProgressPercent, Mode=OneWay}" Maximum="100" Height="8" Foreground="{DynamicResource PrimaryGradientBrush}" Background="Transparent" BorderThickness="0"/>
                        </Border>

                        <!-- Loading Indicator -->
                        <ProgressBar IsIndeterminate="True" Height="3" Background="Transparent" Foreground="{DynamicResource PrimaryColor}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14"/>

                        <!-- Seasons Steppers List -->
                        <ItemsControl ItemsSource="{Binding SeasonItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Padding="16,14" Background="#12FFFFFF" CornerRadius="14" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Season Name & Total -->
                                                <ColumnDefinition Width="150"/>
                                                <!-- Progress Bar & Text -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Steppers (- / Count / + / All) -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Season Title -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SeasonName}" FontSize="15" FontWeight="Black" Foreground="White"/>
                                                <TextBlock Text="{Binding TotalEpisodes, Converter={StaticResource PersianNumberConverter}, StringFormat='کل: {0} قسمت'}" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <!-- Progress Bar & Count Status -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,20,0">
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding ProgressText, Converter={StaticResource PersianNumberConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding ProgressPercentText, Converter={StaticResource PersianNumberConverter}}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border Height="8" CornerRadius="4" Background="#20FFFFFF" ClipToBounds="True">
                                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="8" Foreground="{DynamicResource PrimaryColor}" Background="Transparent" BorderThickness="0"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Stepper Controls -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                
                                                <!-- Decrement Button (-) -->
                                                <Button Style="{StaticResource StepperBtnStyle}"
                                                        Command="{Binding DataContext.DecrementWatchedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="کاهش یک قسمت">
                                                    <materialDesign:PackIcon Kind="Minus" Width="18" Height="18"/>
                                                </Button>

                                                <!-- Watched Count Display -->
                                                <Border Width="48" Height="36" Background="#18FFFFFF" CornerRadius="10" Margin="6,0">
                                                    <TextBlock Text="{Binding WatchedEpisodes, Converter={StaticResource PersianNumberConverter}}" FontSize="15" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Increment Button (+) -->
                                                <Button Style="{StaticResource StepperBtnStyle}"
                                                        Command="{Binding DataContext.IncrementWatchedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="افزایش یک قسمت">
                                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                                                </Button>

                                                <!-- Mark All Button (همه) -->
                                                <Button Command="{Binding DataContext.MarkAllWatchedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Height="36" Padding="12,0" Margin="10,0,0,0"
                                                        Background="#25FFFFFF" BorderBrush="{DynamicResource LightBorder}" BorderThickness="1"
                                                        materialDesign:ButtonAssist.CornerRadius="10" Cursor="Hand" ToolTip="علامت‌گذاری تمام قسمت‌های این فصل">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CheckAll" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="همه" Foreground="White" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                            </StackPanel>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<Window x:Class="MovieManagerDesktop.Views.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        mc:Ignorable="d"
        Title="Video Player" Height="600" Width="1000"
        WindowStyle="None" AllowsTransparency="False" Background="Black"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Flyleaf's Built-in Complete Player Host -->
        <fl:FlyleafHost Player="{Binding Player}" />
    </Grid>
</Window>

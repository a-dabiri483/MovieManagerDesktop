<Window x:Class="MovieManagerDesktop.Views.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Video Player" Height="600" Width="1000"
        WindowStyle="None" AllowsTransparency="True" Background="Black"
        WindowStartupLocation="CenterScreen">
    
    <Grid Background="Black" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <!-- Built-in Windows Media Engine (No external DLLs or downloads required) -->
        <MediaElement x:Name="mediaPlayer"
                      LoadedBehavior="Play"
                      UnloadedBehavior="Stop"
                      Stretch="Uniform"
                      MediaOpened="MediaPlayer_MediaOpened"
                      MediaEnded="MediaPlayer_MediaEnded" />

        <!-- Overlay Controls -->
        <Grid x:Name="ControlsGrid" Background="#99000000" VerticalAlignment="Bottom" Height="80">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Seek Slider -->
            <Slider x:Name="timelineSlider" Grid.Row="0" Margin="10,0"
                    Minimum="0" Maximum="1" 
                    ValueChanged="TimelineSlider_ValueChanged"
                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                    IsMoveToPointEnabled="True"/>

            <!-- Bottom Control Bar -->
            <Grid Grid.Row="1" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Play/Pause Button -->
                <Button Grid.Column="0" Click="PlayPause_Click" Style="{StaticResource MaterialDesignIconButton}" Foreground="White">
                    <materialDesign:PackIcon x:Name="playPauseIcon" Kind="Pause" Width="32" Height="32"/>
                </Button>

                <!-- Time Info -->
                <TextBlock x:Name="timeText" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="14" Text="00:00:00 / 00:00:00"/>

                <!-- Volume Control -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <materialDesign:PackIcon Kind="VolumeHigh" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Slider x:Name="volumeSlider" Minimum="0" Maximum="1" Value="0.8" ValueChanged="VolumeSlider_ValueChanged" Width="100" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="4" Click="CloseButton_Click" Style="{StaticResource MaterialDesignIconButton}" Foreground="White" ToolTip="بستن">
                    <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                </Button>
            </Grid>
        </Grid>

        <!-- Top Title Bar Overlay -->
        <Border Background="#66000000" VerticalAlignment="Top" Height="40" Visibility="{Binding ElementName=ControlsGrid, Path=Visibility}">
            <TextBlock x:Name="titleText" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0" FontSize="16" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>

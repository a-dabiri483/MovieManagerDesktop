<UserControl x:Class="MovieManagerDesktop.Views.CinemaHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:MovieManagerDesktop.ViewModels"
             xmlns:converters="clr-namespace:MovieManagerDesktop.Converters"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CinemaHubViewModel}"
             d:DesignHeight="850" d:DesignWidth="1100"
             FlowDirection="RightToLeft"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:RadioIntEqualsConverter x:Key="RadioIntEqualsConverter"/>
        <converters:PersianNumberConverter x:Key="PersianNumberConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Segmented Tab Style -->
        <Style x:Key="CinemaHubTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PrimaryColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: Back Button + Title + Refresh Button -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Button Grid.Column="0" Command="{Binding GoBackCommand}"
                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                    Background="#20FFFFFF" BorderBrush="#35FFFFFF" Foreground="White"
                    Width="42" Height="42" Margin="0,0,16,0" Cursor="Hand" ToolTip="بازگشت به خانه">
                <materialDesign:PackIcon Kind="ArrowRight" Width="22" Height="22"/>
            </Button>

            <!-- Title -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="MovieOpenStarOutline" Width="24" Height="24" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="دنیای سینما و باکس آفیس" FontSize="24" FontWeight="Black" Foreground="White"/>
                </StackPanel>
                <TextBlock Text="پرفروش‌ترین‌های گیشه جهانی، آخرین اخبار سینما و جدول اکران‌های پیش‌رو" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="32,4,0,0"/>
            </StackPanel>

            <!-- Refresh Button -->
            <Button Grid.Column="2" Command="{Binding RefreshCurrentTabCommand}"
                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                    Background="#20FFFFFF" BorderBrush="#35FFFFFF" Foreground="White"
                    Width="42" Height="42" Cursor="Hand" ToolTip="بروزرسانی داده‌ها">
                <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22"/>
            </Button>
        </Grid>

        <!-- Segmented Tab Bar (News / Box Office / Releases) -->
        <Border Grid.Row="1" Background="#181A2A" CornerRadius="16" Padding="6" Margin="0,0,0,20" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="اخبار سینما 📰" Style="{StaticResource CinemaHubTabStyle}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=0}"/>
                <RadioButton Content="باکس آفیس جهانی 🏆" Style="{StaticResource CinemaHubTabStyle}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=1}"/>
                <RadioButton Content="اکران‌های پیش‌رو 🎬" Style="{StaticResource CinemaHubTabStyle}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource RadioIntEqualsConverter}, ConverterParameter=2}"/>
            </StackPanel>
        </Border>

        <!-- Loading Progress -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Foreground="{DynamicResource PrimaryColor}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" VerticalAlignment="Bottom" Margin="0,0,0,-10"/>

        <!-- Tab Contents -->
        <Grid Grid.Row="2">

            <!-- TAB 0: NEWS FEED -->
            <ScrollViewer Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=0}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding NewsList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A1828" CornerRadius="16" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Image Thumbnail -->
                                    <Border Grid.Column="0" Width="130" Height="90" CornerRadius="12" Background="#101220" Margin="0,0,16,0" ClipToBounds="True">
                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- Text Content -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis" LineHeight="18"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="#208854D0" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Source}" FontSize="11" Foreground="#A55EEA" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding PublishedAt, Converter={StaticResource PersianNumberConverter}}" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- TAB 1: BOX OFFICE (Top 10) -->
            <ScrollViewer Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=1}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding BoxOfficeList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A1828" CornerRadius="16" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Rank Number -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#20FFA502" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Rank, Converter={StaticResource PersianNumberConverter}}" FontSize="16" FontWeight="Black" Foreground="#FFA502" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Mini Poster -->
                                    <Border Grid.Column="1" Width="52" Height="75" CornerRadius="8" Background="#101220" Margin="8,0" ClipToBounds="True">
                                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- Title & Details -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding OriginalTitle}" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <materialDesign:PackIcon Kind="Star" Width="14" Height="14" Foreground="#FFD32A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding FormattedRating, Converter={StaticResource PersianNumberConverter}}" FontSize="12" FontWeight="Bold" Foreground="#FFD32A"/>
                                            <TextBlock Text="{Binding WeeksOut, Converter={StaticResource PersianNumberConverter}, StringFormat=' • هفته {0} اکران'}" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Weekend Gross -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="فروش آخر هفته" FontSize="11.5" Foreground="{DynamicResource SecondaryText}"/>
                                        <TextBlock Text="{Binding WeekendGross, Converter={StaticResource PersianNumberConverter}}" FontSize="14.5" FontWeight="Black" Foreground="#2ED573" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Total Gross -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="فروش کل جهانی" FontSize="11.5" Foreground="{DynamicResource SecondaryText}"/>
                                        <TextBlock Text="{Binding TotalGross, Converter={StaticResource PersianNumberConverter}}" FontSize="14.5" FontWeight="Black" Foreground="White" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- TAB 2: UPCOMING RELEASES -->
            <ScrollViewer Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=2}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding UpcomingList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="230" Height="360" Background="#1A1828" CornerRadius="18" BorderBrush="#20FFFFFF" BorderThickness="1" Margin="8" ClipToBounds="True">
                                <Grid>
                                    <!-- Poster -->
                                    <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <!-- Top Countdown Badge -->
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#D0000000" CornerRadius="10" Padding="10,5" Margin="10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CalendarClock" Width="14" Height="14" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding DaysRemaining, Converter={StaticResource PersianNumberConverter}, StringFormat='{}{0} روز مانده'}" Foreground="White" FontSize="11.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bottom Info Overlay -->
                                    <Border VerticalAlignment="Bottom" Padding="12,20,12,12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#000A0B16" Offset="0"/>
                                                <GradientStop Color="#EE0A0B16" Offset="0.4"/>
                                                <GradientStop Color="#FF0A0B16" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ReleaseDate, Converter={StaticResource PersianNumberConverter}, StringFormat='تاریخ اکران: {0}'}" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Overview}" FontSize="11" Foreground="#AAFFFFFF" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>

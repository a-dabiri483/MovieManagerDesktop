## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
publish/
*.log
*.txt

# Visual Studio cache/options directory
.vs/

# SQLite databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Large MPV binaries (binaries downloaded/placed separately, scripts & configs tracked)
MPVPlayer/*.exe
MPVPlayer/*.dll
MPVPlayer/*.a
MPVPlayer/*.lib
MPVPlayer/*.def
MPVPlayer/*.pc
MPVPlayer/*.pdb
MPVPlayer/*.deps.json
MPVPlayer/*.runtimeconfig.json

# OAuth credentials
credentials.json
setup_output/
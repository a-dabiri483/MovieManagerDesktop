<?xml version="1.0" encoding="utf-8" ?>
<Obfuscator>
  <!-- Input path where compiled binaries exist -->
  <Var name="InPath" value=".\publish" />
  <!-- Output path for obfuscated binaries -->
  <Var name="OutPath" value=".\publish\obfuscated" />

  <!-- Security & Obfuscation Options -->
  <Var name="KeepPublicApi" value="true" />
  <Var name="HideStrings" value="true" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameEvents" value="true" />
  <Var name="RenameFields" value="true" />
  <Var name="UseUnicodeNames" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="ReuseNames" value="true" />
  <Var name="SuppressIldasm" value="true" />
  <Var name="OptimizeMethods" value="true" />

  <!-- Assembly to Obfuscate -->
  <Module file="$(InPath)\MovieManagerDesktop.dll" />

</Obfuscator>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- ========================================== -->
    <!-- ANDROID DESIGN SYSTEM COLORS (Dark Indigo & Coral Pink) -->
    <!-- ========================================== -->
    
    <!-- Primary Colors (Coral Pink & Magenta Neon) -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#EB3B5A"/>
    <SolidColorBrush x:Key="PrimaryColorDark" Color="#D63031"/>
    <SolidColorBrush x:Key="SecondaryColor" Color="#FF3366"/>
    <SolidColorBrush x:Key="AccentColor" Color="#EB3B5A"/>
    <SolidColorBrush x:Key="GoldColor" Color="#FFB800"/>
    <SolidColorBrush x:Key="PurpleAccent" Color="#8854D0"/>
    <SolidColorBrush x:Key="NetworkBlue" Color="#3867D6"/>
    <SolidColorBrush x:Key="OrangeAccent" Color="#FA8231"/>
    <SolidColorBrush x:Key="EmeraldAccent" Color="#26DE81"/>
    <SolidColorBrush x:Key="TealAccent" Color="#0FB9B1"/>
    
    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessColor" Color="#20BF6B"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFB800"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#EB3B5A"/>
    <SolidColorBrush x:Key="InfoColor" Color="#3867D6"/>
    
    <!-- Background Colors (Dark Navy Indigo & Cards) -->
    <SolidColorBrush x:Key="MainBackground" Color="#0A0B16"/>
    <SolidColorBrush x:Key="CardBackground" Color="#15182E"/>
    <SolidColorBrush x:Key="CardBackgroundLight" Color="#1C203C"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#0E1020"/>
    <SolidColorBrush x:Key="NavBarBackground" Color="#131629"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#241E34"/>
    <SolidColorBrush x:Key="ActiveItemBackground" Color="#351828"/>
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#A0A5C0"/>
    <SolidColorBrush x:Key="DisabledText" Color="#6C7393"/>
    <SolidColorBrush x:Key="MutedText" Color="#8B92B2"/>
    
    <!-- Border Colors -->
    <SolidColorBrush x:Key="PrimaryBorder" Color="#EB3B5A"/>
    <SolidColorBrush x:Key="NormalBorder" Color="#222644"/>
    <SolidColorBrush x:Key="LightBorder" Color="#1B1E36"/>
    <SolidColorBrush x:Key="GlassBorder" Color="#25FFFFFF"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3366" Offset="0"/>
        <GradientStop Color="#EB3B5A" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="FabGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A55EEA" Offset="0"/>
        <GradientStop Color="#EB3B5A" Offset="1"/>
    </LinearGradientBrush>

    <!-- ========================================== -->
    <!-- LEGACY ALIASES (Prevents existing UI from breaking) -->
    <!-- ========================================== -->
    <SolidColorBrush x:Key="ColorPrimary" Color="#EB3B5A"/>
    <SolidColorBrush x:Key="ColorPrimaryDark" Color="#D63031"/>
    <SolidColorBrush x:Key="ColorSecondary" Color="#FF3366"/>
    <SolidColorBrush x:Key="ColorAccent" Color="#EB3B5A"/>
    <SolidColorBrush x:Key="ColorSuccess" Color="#20BF6B"/>
    <SolidColorBrush x:Key="ColorWarning" Color="#FFB800"/>
    <SolidColorBrush x:Key="ColorError" Color="#EB3B5A"/>
    <SolidColorBrush x:Key="ColorInfo" Color="#3867D6"/>
    <SolidColorBrush x:Key="ColorBackground" Color="#0A0B16"/>
    <SolidColorBrush x:Key="ColorSurface" Color="#15182E"/>
    <SolidColorBrush x:Key="ColorSurfaceLight" Color="#0E1020"/>
    <SolidColorBrush x:Key="ColorSurfaceGlass" Color="#3015182E"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A0A5C0"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#6C7393"/>

    <!-- ========================================== -->
    <!-- TYPOGRAPHY -->
    <!-- ========================================== -->
    <FontFamily x:Key="AppFontFamily">Vazirmatn, Segoe UI, IRANSans</FontFamily>
    
    <!-- H1 (32px, Bold) -->
    <Style x:Key="TextH1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    
    <!-- H2 (24px, SemiBold) -->
    <Style x:Key="TextH2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    
    <!-- H3 (18px, SemiBold) -->
    <Style x:Key="TextH3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    
    <!-- Body (14px, Regular) -->
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>

    <!-- Small (12px, Regular) -->
    <Style x:Key="TextSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
    </Style>

    <!-- Caption (10px, Regular) -->
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
    </Style>

    <!-- TitleTextStyle (from user specs) -->
    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- ========================================== -->
    <!-- SHADOWS -->
    <!-- ========================================== -->
    <DropShadowEffect x:Key="ShadowSm" BlurRadius="4" ShadowDepth="1" Opacity="0.1" Color="Black"/>
    <DropShadowEffect x:Key="ShadowMd" BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="Black"/>
    <DropShadowEffect x:Key="ShadowLg" BlurRadius="16" ShadowDepth="4" Opacity="0.2" Color="Black"/>
    
    <!-- Legacy shadows just in case -->
    <DropShadowEffect x:Key="ShadowXl" BlurRadius="32" ShadowDepth="8" Opacity="0.3" Color="Black"/>
    <DropShadowEffect x:Key="GlowPrimary" BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="#E50914"/>

    <!-- ========================================== -->
    <!-- CORNER RADII -->
    <!-- ========================================== -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusXl">16</CornerRadius>
    <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

    <!-- ========================================== -->
    <!-- STYLES (from User Specs) -->
    <!-- ========================================== -->
    
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="8"/>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Custom ScrollBar Style -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#33E50914"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Bg" Background="Transparent"/>
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="{TemplateBinding Foreground}" Margin="0,2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
